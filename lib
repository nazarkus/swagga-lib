-- Слайдер
function SettingsOverlay:AddSlider(section, cfg)
	local row = self:_row(section, cfg.Name, cfg.Description)
	local min, max = cfg.Min or 0, cfg.Max or 100
	local value = math.clamp(cfg.Default or min, min, max)
	local decimals = cfg.Decimals or 0

	local valueLabel = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, cfg.Description and -8 or 0),
		Size = UDim2.fromOffset(52, 16),
		Font = Enum.Font.GothamMedium,
		Text = "0",
		TextSize = 11.5,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 63,
		Parent = row,
	})
	Theme.bind(valueLabel, "TextColor3", "Accent")

	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -72, 0.5, cfg.Description and -8 or 0),
		Size = UDim2.new(0.36, 0, 0, 4),
		BorderSizePixel = 0,
		ZIndex = 63,
		Parent = row,
	}, { Util.corner(2) })
	Theme.bind(track, "BackgroundColor3", "ElementActive")

	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, ZIndex = 64, Parent = track,
	}, { Util.corner(2) })
	Theme.bind(fill, "BackgroundColor3", "Accent")

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 65, Parent = track,
	}, { Util.corner(6) })

	local function fmt(v)
		local t = decimals > 0 and string.format("%." .. decimals .. "f", v)
			or tostring(math.floor(v + 0.5))
		return (cfg.Prefix or "") .. t .. (cfg.Suffix or "")
	end

	local function render()
		local a = (value - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valueLabel.Text = fmt(value)
	end

	local function setValue(v, fire)
		if cfg.Increment and cfg.Increment > 0 then
			v = math.floor((v - min) / cfg.Increment + 0.5) * cfg.Increment + min
		end
		v = Util.round(math.clamp(v, min, max), decimals)
		if v ~= value then
			value = v
			render()
			if fire and cfg.Callback then
				task.spawn(cfg.Callback, value)
			end
		end
	end
	render()

	local dragging = false
	local function fromMouse()
		local pos = UIS:GetMouseLocation()
		local tp, tw = track.AbsolutePosition.X, track.AbsoluteSize.X
		if tw <= 0 then return end
		setValue(min + (max - min) * math.clamp((pos.X - tp) / tw, 0, 1), true)
	end

	local hit = create("TextButton", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Text = "", AutoButtonColor = false, ZIndex = 62, Parent = row,
	})
	hit.MouseButton1Down:Connect(function()
		local mx = UIS:GetMouseLocation().X
		local tp, tw = track.AbsolutePosition.X, track.AbsoluteSize.X
		if mx < tp - 14 or mx > tp + tw + 14 then return end
		dragging = true
		Motion.tween(knob, { Size = UDim2.fromOffset(16, 16) }, {
			Duration = Motion.Duration.Normal, Easing = Motion.Easing.Overshoot })
		fromMouse()
	end)
	self.Janitor:Add(UIS.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			fromMouse()
		end
	end))
	self.Janitor:Add(UIS.InputEnded:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			Motion.tween(knob, { Size = UDim2.fromOffset(12, 12) }, {
				Duration = Motion.Duration.Normal })
		end
	end))

	local handle = { Row = row }
	function handle:Get() return value end
	function handle:Set(v)
		setValue(v, false)
		return self
	end
	return handle
end

-- Выбор одного варианта из нескольких (сегментированные кнопки)
function SettingsOverlay:AddChoice(section, cfg)
	local row = self:_row(section, cfg.Name, cfg.Description)
	local options = cfg.Options or {}
	local value = cfg.Default or options[1]

	local holder = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, cfg.Description and -8 or 0),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		ZIndex = 63,
		Parent = row,
	}, {
		Util.listLayout({
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 4),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})

	local buttons = {}
	local function render()
		for opt, btn in pairs(buttons) do
			local on = opt == value
			Motion.tween(btn, {
				BackgroundTransparency = on and 0 or 1,
			}, { Duration = Motion.Duration.Fast })
			Motion.tween(btn, {
				TextColor3 = on and Theme.get("Background") or Theme.get("TextSecondary"),
				TextTransparency = on and 0 or 0.35,
			}, { Duration = Motion.Duration.Fast })
		end
	end

	for i, opt in ipairs(options) do
		local btn = create("TextButton", {
			Name = tostring(opt),
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Font = Enum.Font.GothamMedium,
			Text = tostring(opt),
			TextSize = 11,
			LayoutOrder = i,
			ZIndex = 64,
			Parent = holder,
		}, {
			Util.corner(6),
			Util.padding(0, 0, 9, 9),
		})
		Theme.bind(btn, "BackgroundColor3", "Accent")
		buttons[opt] = btn
		btn.Activated:Connect(function()
			if value == opt then return end
			value = opt
			render()
			if cfg.Callback then
				task.spawn(cfg.Callback, opt)
			end
		end)
	end
	render()

	local handle = { Row = row }
	function handle:Get() return value end
	function handle:Set(v)
		value = v
		render()
		return self
	end
	return handle
end

