		Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, -TOPBAR_HEIGHT),
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = self.Root,
	})
	self.Content = content

	-- Контент двигается вместе с сайдбаром
	self.ContentDriver = Motion.drive(content, "Position", self.SidebarSpring, function(width)
		return UDim2.new(0, width, 0, TOPBAR_HEIGHT)
	end)
	self.ContentSizeDriver = Motion.drive(content, "Size", self.SidebarSpring, function(width)
		return UDim2.new(1, -width, 1, -TOPBAR_HEIGHT)
	end)
end

