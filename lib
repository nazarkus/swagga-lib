	но отключают ПКМ-меню и сохранение.
]]

local Element = __swagga_require("Element")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")

local create = Util.create

local Static = {}

--==============================================================
-- Section
--==============================================================
local Section = setmetatable({}, { __index = Element })
Section.__index = Section

function Section.new(tab, config)
	if type(config) == "string" then
		config = { Name = config }
	end
	config = config or {}
	config.ForgetState = true
	config.SupportsKeybind = false
	config.Height = 26

	local self = Element.new(tab, config, "section")
	setmetatable(self, Section)

	-- Секция без карточки: только текст и линия
	self.Frame.BackgroundTransparency = 1
	self._baseTransparency = 1
	if self.Stroke then
		self.Stroke:Destroy()
		self.Stroke = nil
	end
	self.HitArea:Destroy()
	self.HitArea = nil

	self.Title.Font = Enum.Font.GothamBold
	self.Title.TextSize = 11
	self.Title.Text = Util.upper(self.Name)
	self.Title.Position = UDim2.new(0, 4, 1, -6)
	self.Title.AnchorPoint = Vector2.new(0, 1)
	self.Title.Size = UDim2.new(0.6, 0, 0, 14)
	Theme.bind(self.Title, "TextColor3", "TextMuted")

	-- Линия справа от заголовка
	local line = create("Frame", {
		Name = "Line",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -4, 1, -11),
		Size = UDim2.new(0.5, 0, 0, 1),
		BorderSizePixel = 0,
		BackgroundTransparency = 0.5,
		ZIndex = 3,
		Parent = self.Frame,
	})
	Theme.bind(line, "BackgroundColor3", "Divider")

	--[[
		Линия растворяется с ОБОИХ концов.
		Раньше правый край обрывался на 0.85 — у стенки окна был
		виден прямой торец. Теперь оба конца уходят в 1.
	]]
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.35),
			NumberSequenceKeypoint.new(0.75, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = line,
	})

