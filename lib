--[[
	Сворачивание сайдбара.
	Ширина двигается пружиной, содержимое кнопок фейдится.
	immediate = true — без анимации (стартовое состояние).
]]
function Window:ToggleSidebar(immediate)
	self.SidebarCollapsed = not self.SidebarCollapsed
	local target = self.SidebarCollapsed and SIDEBAR_COLLAPSED or SIDEBAR_WIDTH

	if immediate then
		self.SidebarSpring:Snap(target)
		self.Sidebar.Size = UDim2.new(0, target, 1, -TOPBAR_HEIGHT)
	else
		self.SidebarSpring:SetTarget(target)
	end

	-- Контент подстраивается под сайдбар той же пружиной
	local labelTransparency = self.SidebarCollapsed and 1 or 0
	local duration = self.SidebarCollapsed and Motion.Duration.Fast or Motion.Duration.Normal

	Motion.tween(self.CollapseLabel, { TextTransparency = labelTransparency }, {
		Duration = duration,
		Delay = self.SidebarCollapsed and 0 or 0.1,
	})

	-- Разворот иконки сворачивания
	Motion.tween(self.CollapseIcon, { Rotation = self.SidebarCollapsed and 180 or 0 }, {
		Duration = Motion.Duration.Slow,
		Easing = Motion.Easing.Standard,
	})

	-- Подписи табов
	for _, tab in ipairs(self.Tabs) do
		tab:SetCollapsed(self.SidebarCollapsed, duration)
	end
end

