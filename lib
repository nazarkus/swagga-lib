		ZIndex = 63,
		Parent = row,
	}, { Util.corner(11) })
	Theme.bind(track, "BackgroundColor3", "ElementActive")

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BorderSizePixel = 0,
		ZIndex = 64,
		Parent = track,
	}, { Util.corner(8) })
	Theme.bind(knob, "BackgroundColor3", "TextSecondary")

	local hit = create("TextButton", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Text = "", AutoButtonColor = false, ZIndex = 65, Parent = row,
	})

	local function render(animate)
		local dur = animate and Motion.Duration.Normal or 0
		Motion.tween(track, {
			BackgroundColor3 = value and Theme.get("Accent") or Theme.get("ElementActive"),
		}, { Duration = dur })
		Motion.tween(knob, {
