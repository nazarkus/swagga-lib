-- URL спрайтшит-таблицы Lucide для Roblox
local LUCIDE_URLS = {
	"https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/icons.lua",
	"https://raw.githubusercontent.com/latte-soft/lucide-roblox/main/src/init.lua",
}

local function tryLoadLucide()
	if Icons.LucideLoaded or not Icons.LucideEnabled then
		return Icons.LucideData ~= nil
	end
	Icons.LucideLoaded = true -- пробуем только один раз

	for _, url in ipairs(LUCIDE_URLS) do
		local ok, result = pcall(function()
			local source = game:HttpGet(url)
			if type(source) ~= "string" or #source < 100 then
				return nil
			end
			local chunk = loadstring(source)
			if not chunk then
				return nil
			end
			return chunk()
		end)
		if ok and type(result) == "table" then
			Icons.LucideData = result
			return true
		end
	end
	return false
end

--[[
	Достаём иконку из таблицы Lucide.
	Форматы отличаются между библиотеками, поддерживаем оба:
	  Rayfield: Icons['48px'][name] = { id, {rectX,rectY}, {offX,offY} }
	  latte-soft: GetAsset(name, size) → { Id, ImageRectSize, ImageRectOffset }
]]
local function lucideLookup(name: string)
	local data = Icons.LucideData
	if not data then
		return nil
	end

	-- Формат latte-soft: функция GetAsset
	if type(data.GetAsset) == "function" then
		local ok, asset = pcall(data.GetAsset, name, 48)
		if ok and type(asset) == "table" and asset.Id then
			return {
				Image = "rbxassetid://" .. tostring(asset.Id),
				RectOffset = asset.ImageRectOffset,
				RectSize = asset.ImageRectSize,
			}
		end
		return nil
	end

	-- Формат Rayfield: вложенная таблица по размерам
	local sized = data["48px"] or data["256px"] or data
	local entry = sized and sized[name]
	if type(entry) == "table" then
		local id = entry[1]
		local rectSize = entry[2]
		local rectOffset = entry[3]
		if id then
			return {
				Image = "rbxassetid://" .. tostring(id),
				RectSize = rectSize and Vector2.new(rectSize[1], rectSize[2]) or nil,
				RectOffset = rectOffset and Vector2.new(rectOffset[1], rectOffset[2]) or nil,
			}
		end
	elseif type(entry) == "number" then
		return { Image = "rbxassetid://" .. tostring(entry) }
	end
	return nil
end

--==============================================================
-- Публичный резолвер
--==============================================================
--[[
	Возвращает таблицу:
	  { Image = "rbxassetid://...", RectOffset = Vector2?, RectSize = Vector2? }
	или nil, если иконки нет.
]]
function Icons.resolve(icon): {[string]: any}?
	if icon == nil or icon == "" or icon == 0 then
		return nil
	end

	-- Число → assetId
	if type(icon) == "number" then
		return { Image = "rbxassetid://" .. tostring(math.floor(icon)) }
	end

	if type(icon) ~= "string" then
		return nil
	end

	-- Уже готовый URI
	if icon:match("^rbxassetid://") or icon:match("^rbxasset://") or icon:match("^rbxthumb://") then
		return { Image = icon }
	end

	-- Строка-число
	local asNumber = tonumber(icon)
	if asNumber then
		return { Image = "rbxassetid://" .. tostring(math.floor(asNumber)) }
	end

	local name = icon:lower():gsub("^%s+", ""):gsub("%s+$", "")

	-- Lucide
	if Icons.LucideEnabled then
		tryLoadLucide()
		local found = lucideLookup(name)
		if found then
			return found
		end
	end

	-- Встроенный набор
	local builtinId = Icons.Builtin[name] or Icons.Builtin[name:gsub("-", "_")]
	if builtinId then
		return { Image = "rbxassetid://" .. tostring(builtinId) }
	end

	return nil
end

--[[
	Применяет иконку к ImageLabel/ImageButton.
	Возвращает true, если иконка найдена.
]]
function Icons.apply(imageInstance: Instance, icon): boolean
	local resolved = Icons.resolve(icon)
	if not resolved then
		pcall(function()
			imageInstance.Image = ""
		end)
		return false
	end
	pcall(function()
		imageInstance.Image = resolved.Image
		if resolved.RectOffset then
			imageInstance.ImageRectOffset = resolved.RectOffset
		else
			imageInstance.ImageRectOffset = Vector2.new(0, 0)
		end
		if resolved.RectSize then
			imageInstance.ImageRectSize = resolved.RectSize
		else
			imageInstance.ImageRectSize = Vector2.new(0, 0)
		end
	end)
	return true
end

function Icons.exists(icon): boolean
	return Icons.resolve(icon) ~= nil
end

-- Отключить сетевую загрузку (secure mode)
function Icons.setLucideEnabled(enabled: boolean)
	Icons.LucideEnabled = enabled and true or false
end

return Icons
end

__swagga_modules["Motion"] = function()

--[[
	Motion — анимационный слой.

	Зачем не голый TweenService:
	  1. Глобальный множитель скорости (слайдер в настройках).
	  2. Reduced Motion — мгновенное применение вместо анимации.
	  3. Пружинная физика для интерактивных элементов (слайдер, дропдаун):
	     пружина не имеет фиксированной длительности и корректно
	     «догоняет» цель, если она сменилась на полпути. Твин в такой
	     ситуации дёргается.
	  4. Автоотмена предыдущего твина того же свойства — иначе два твина
	     дерутся за одно свойство и картинка мигает.
]]

local Compat = __swagga_require("Compat")
local Signal = __swagga_require("Signal")

local TweenService = Compat.Services.Tween
local RunService = Compat.Services.Run

local Motion = {}

--==============================================================
-- Глобальные настройки
--==============================================================
Motion.SpeedMultiplier = 1.0 -- 0.5 = вдвое медленнее, 2.0 = вдвое быстрее
Motion.ReducedMotion = false
Motion.Changed = Signal.new("Motion.Changed")

function Motion.SetSpeed(multiplier: number)
	Motion.SpeedMultiplier = math.clamp(multiplier, 0.25, 3)
	Motion.Changed:Fire("Speed", Motion.SpeedMultiplier)
end

function Motion.SetReducedMotion(enabled: boolean)
	Motion.ReducedMotion = enabled and true or false
	Motion.Changed:Fire("ReducedMotion", Motion.ReducedMotion)
end

--==============================================================
-- Пресеты длительности и кривых
--==============================================================
-- Базовые времена подобраны под «дорогое, плавное» ощущение.
Motion.Duration = {
	Instant = 0.0,
	Micro = 0.12, -- ховер иконки
	Fast = 0.18, -- ховер элемента, нажатие
	Normal = 0.28, -- смена состояния тоггла
	Slow = 0.42, -- раскрытие дропдауна
	Slower = 0.55, -- сворачивание сайдбара, открытие окна
	Lazy = 0.75, -- фоновые градиенты
}

Motion.Easing = {
	-- Стандартный «material»-выход: быстро стартует, мягко тормозит.
	Standard = { Enum.EasingStyle.Quint, Enum.EasingDirection.Out },
	-- Для появления элементов.
	Decelerate = { Enum.EasingStyle.Quart, Enum.EasingDirection.Out },
	-- Для исчезновения.
	Accelerate = { Enum.EasingStyle.Quart, Enum.EasingDirection.In },
	-- Симметричный — для перемещений внутри лейаута.
	Smooth = { Enum.EasingStyle.Quint, Enum.EasingDirection.InOut },
	-- Лёгкий перелёт: кнопки, чекбоксы.
	Overshoot = { Enum.EasingStyle.Back, Enum.EasingDirection.Out },
	-- Упругий — для «пружинящих» акцентов.
	Elastic = { Enum.EasingStyle.Elastic, Enum.EasingDirection.Out },
	Linear = { Enum.EasingStyle.Linear, Enum.EasingDirection.InOut },
	Sine = { Enum.EasingStyle.Sine, Enum.EasingDirection.Out },
}

--==============================================================
-- Учёт активных твинов, чтобы не было конфликтов
--==============================================================
local activeTweens = setmetatable({}, { __mode = "k" }) -- [instance] = { [prop] = tween }

local function cancelConflicting(instance, goals)
	local perInstance = activeTweens[instance]
	if not perInstance then
		return
	end
	for prop in pairs(goals) do
		local existing = perInstance[prop]
		if existing then
			pcall(function()
				existing:Cancel()
			end)
			perInstance[prop] = nil
		end
	end
end

local function registerTween(instance, goals, tween)
	local perInstance = activeTweens[instance]
	if not perInstance then
		perInstance = {}
		activeTweens[instance] = perInstance
	end
	for prop in pairs(goals) do
		perInstance[prop] = tween
	end
	tween.Completed:Connect(function()
		local pi = activeTweens[instance]
		if not pi then
			return
		end
		for prop in pairs(goals) do
			if pi[prop] == tween then
				pi[prop] = nil
			end
		end
	end)
end

--==============================================================
-- tween: основная функция
--==============================================================
--[[
	Motion.tween(instance, goals, {
		Duration = Motion.Duration.Normal,   -- или число
		Easing = Motion.Easing.Standard,     -- {style, direction}
		Delay = 0,
		Reverses = false,
		RepeatCount = 0,
	})
]]
function Motion.tween(instance: Instance, goals: {[string]: any}, opts: {[string]: any}?)
	if not instance then
		return nil
	end
	opts = opts or {}

	local duration = opts.Duration or Motion.Duration.Normal
	local easing = opts.Easing or Motion.Easing.Standard
	local delayTime = opts.Delay or 0

	-- Reduced Motion / нулевая длительность: применяем мгновенно
	if Motion.ReducedMotion or duration <= 0 then
		cancelConflicting(instance, goals)
		for prop, value in pairs(goals) do
			pcall(function()
				instance[prop] = value
			end)
		end
		if opts.OnComplete then
			task.spawn(opts.OnComplete)
		end
		return nil
	end

	local scaled = duration / Motion.SpeedMultiplier
	local scaledDelay = delayTime / Motion.SpeedMultiplier

	cancelConflicting(instance, goals)

	local info = TweenInfo.new(
		scaled,
		easing[1] or Enum.EasingStyle.Quint,
		easing[2] or Enum.EasingDirection.Out,
		opts.RepeatCount or 0,
		opts.Reverses or false,
		scaledDelay
	)

	local ok, tween = pcall(function()
		return TweenService:Create(instance, info, goals)
	end)
	if not ok or not tween then
		-- Свойство не твинится (например Visible) — ставим напрямую
		for prop, value in pairs(goals) do
			pcall(function()
				instance[prop] = value
			end)
		end
		return nil
	end

	registerTween(instance, goals, tween)

	if opts.OnComplete then
		tween.Completed:Connect(function()
			opts.OnComplete()
		end)
	end

	tween:Play()
	return tween
end

-- Короткие обёртки под частые случаи
function Motion.fast(instance, goals, opts)
	opts = opts or {}
	opts.Duration = opts.Duration or Motion.Duration.Fast
	return Motion.tween(instance, goals, opts)
end

function Motion.slow(instance, goals, opts)
	opts = opts or {}
	opts.Duration = opts.Duration or Motion.Duration.Slow
	return Motion.tween(instance, goals, opts)
end

--==============================================================
-- Пружина (spring)
--==============================================================
--[[
	Пружина нужна там, где цель может меняться каждый кадр:
	  • слайдер под курсором
	  • высота дропдауна при фильтрации поиском
	  • позиция окна при перетаскивании

	Модель — критически демпфированная пружина (damping ~1),
	без колебаний, но с естественным «подтягиванием».
]]
local Spring = {}
Spring.__index = Spring

function Motion.spring(initial: number, opts: {[string]: any}?)
	opts = opts or {}
	return setmetatable({
		Position = initial or 0,
		Target = initial or 0,
		Velocity = 0,
		Frequency = opts.Frequency or 4.5, -- Гц: выше = быстрее
		Damping = opts.Damping or 1.0, -- 1 = без колебаний
		_epsilon = opts.Epsilon or 0.0005,
	}, Spring)
end

function Spring:SetTarget(value: number)
	self.Target = value
end

function Spring:Snap(value: number)
	self.Position = value
	self.Target = value
	self.Velocity = 0
end

function Spring:IsSettled(): boolean
	return math.abs(self.Position - self.Target) < self._epsilon and math.abs(self.Velocity) < self._epsilon
end

--[[
	Аналитическое решение для критически демпфированной пружины.
	Численный Эйлер при низком FPS разваливается, поэтому берём
	точную формулу — стабильно при любом dt.
]]
function Spring:Step(dt: number): number
	if Motion.ReducedMotion then
		self:Snap(self.Target)
		return self.Position
	end

	dt = math.min(dt, 1 / 20) -- клампим лаг-спайки
	local omega = 2 * math.pi * self.Frequency * Motion.SpeedMultiplier
	local zeta = self.Damping

	local x = self.Position - self.Target
	local v = self.Velocity

	if zeta >= 1 then
		-- Критическое демпфирование.
		-- x(t) = (c1 + c2·t)·e^(-ω·t),  x'(t) = e^(-ω·t)·(c2 − ω·(c1 + c2·t))
		-- где c1 = x0, c2 = v0 + ω·x0  (проверка при t=0: x'(0) = c2 − ω·c1 = v0 ✓)
		local expTerm = math.exp(-omega * dt)
		local c1 = x
		local c2 = v + omega * x
		local displacement = c1 + c2 * dt
		self.Position = self.Target + displacement * expTerm
		self.Velocity = (c2 - omega * displacement) * expTerm
	else
		-- недодемпфированная (с лёгким отскоком)
		local omegaD = omega * math.sqrt(1 - zeta * zeta)
		local expTerm = math.exp(-zeta * omega * dt)
		local cosT = math.cos(omegaD * dt)
		local sinT = math.sin(omegaD * dt)
		local c1 = x
		local c2 = (v + zeta * omega * x) / omegaD
		self.Position = self.Target + expTerm * (c1 * cosT + c2 * sinT)
		self.Velocity = expTerm
			* ((-zeta * omega) * (c1 * cosT + c2 * sinT) + omegaD * (c2 * cosT - c1 * sinT))
	end

	if self:IsSettled() then
		self:Snap(self.Target)
	end

	return self.Position
end

--==============================================================
-- Пружинный драйвер: привязка пружины к свойству
--==============================================================
local drivers = {}
local driverConnection = nil

local function ensureDriver()
	if driverConnection then
		return
	end
	local signal = RunService and (RunService.RenderStepped or RunService.Heartbeat)
	if not signal then
		return
	end
	driverConnection = signal:Connect(function(dt)
		local anyActive = false
		for driver in pairs(drivers) do
			if driver._alive then
				anyActive = true
				driver:_step(dt)
			else
				drivers[driver] = nil
			end
		end
		if not anyActive then
			-- Драйвер простаивает — отключаемся, чтобы не жечь кадры
			if driverConnection then
				driverConnection:Disconnect()
				driverConnection = nil
			end
		end
	end)
end

--[[
	Motion.drive(instance, "Position", spring, function(value)
	    return UDim2.new(value, 0, 0, 0)
	end)
]]
function Motion.drive(instance: Instance, property: string, spring, mapper)
	local driver = {
		_alive = true,
		_instance = instance,
		_property = property,
		_spring = spring,
		_mapper = mapper,
	}

	function driver:_step(dt)
		if not self._instance or not self._instance.Parent then
			-- элемент уничтожен — снимаем драйвер
			self._alive = false
			return
		end
		local value = self._spring:Step(dt)
		local mapped = self._mapper and self._mapper(value) or value
		pcall(function()
			self._instance[self._property] = mapped
		end)
	end

	function driver:Stop()
		self._alive = false
		drivers[self] = nil
	end

	drivers[driver] = true
	ensureDriver()
	return driver
end

--==============================================================
-- Стаггер: поочерёдное появление списка элементов
--==============================================================
--[[
	Motion.stagger(items, 0.04, function(item, index, delay)
	    Motion.tween(item, { ... }, { Delay = delay })
	end)
]]
function Motion.stagger(items, stepDelay: number, fn)
	stepDelay = stepDelay or 0.035
	for index, item in ipairs(items) do
		local delayTime = (index - 1) * stepDelay
		fn(item, index, Motion.ReducedMotion and 0 or delayTime)
	end
end


--==============================================================
-- Reveal: «шторка» градиентом (фирменная анимация оригинала)
--==============================================================
--[[
	В исходном Swagga Lib контент проявляется не простым фейдом,
	а сдвигом UIGradient: полупрозрачная шторка едет снизу вверх
	и «открывает» элемент. Это выглядит мягче обычного fade и
	не создаёт резких границ.

	Техника: UIGradient с Rotation = 90 и Transparency 1 → 0.
	Offset.Y едет от -1 (всё скрыто) к 0 (всё видно).

	Motion.reveal(frame, true)   -- проявить
	Motion.reveal(frame, false)  -- скрыть
]]
local REVEAL_NAME = "_RevealGradient"

-- Создаёт (или находит) градиент-шторку на объекте
function Motion.ensureReveal(instance: Instance, direction: string?)
	local existing = instance:FindFirstChild(REVEAL_NAME)
	if existing then
		return existing
	end

	local gradient = Instance.new("UIGradient")
	gradient.Name = REVEAL_NAME
	-- 90° = вертикальная шторка (снизу вверх), 0° = горизонтальная
	gradient.Rotation = (direction == "horizontal") and 0 or 90
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.35, 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	gradient.Offset = Vector2.new(0, -1)
	gradient.Parent = instance
	return gradient
end

--[[
	Проявить / скрыть объект шторкой.
	opts.Duration — по умолчанию Slower (0.55с), как в оригинале (0.6с)
	opts.Direction — "vertical" (по умолчанию) или "horizontal"
	opts.Delay — задержка старта
]]
function Motion.reveal(instance: Instance, show: boolean, opts: {[string]: any}?)
	if not instance then
		return nil
	end
	opts = opts or {}
	local gradient = Motion.ensureReveal(instance, opts.Direction)

	local target = show and Vector2.new(0, 0) or Vector2.new(0, -1)

	if Motion.ReducedMotion then
		gradient.Offset = target
		if opts.OnComplete then
			task.spawn(opts.OnComplete)
		end
		return nil
	end

	-- Стартовая позиция только при появлении: если уже видно,
	-- повторный вызов не должен «мигать»
	if show and gradient.Offset.Y >= -0.02 and not opts.Force then
		if opts.OnComplete then
			task.spawn(opts.OnComplete)
		end
		return nil
	end
	if show then
		gradient.Offset = Vector2.new(0, -1)
	end

	return Motion.tween(gradient, { Offset = target }, {
		Duration = opts.Duration or Motion.Duration.Slower,
		Easing = opts.Easing or Motion.Easing.Standard,
		Delay = opts.Delay,
		OnComplete = opts.OnComplete,
	})
end

-- Снять шторку совсем (объект остаётся видимым)
function Motion.clearReveal(instance: Instance)
	local gradient = instance and instance:FindFirstChild(REVEAL_NAME)
	if gradient then
		gradient:Destroy()
	end
end

--[[
	Каскадное проявление списка объектов шторкой.
	Именно так в оригинале открывались разделы Info и Credits:
	каждая карточка «выезжает» с задержкой относительно предыдущей.
]]
function Motion.revealStagger(items, stepDelay: number?, opts: {[string]: any}?)
	opts = opts or {}
	stepDelay = stepDelay or 0.06
	Motion.stagger(items, stepDelay, function(item, index, delayTime)
		Motion.reveal(item, opts.Show ~= false, {
			Duration = opts.Duration,
			Direction = opts.Direction,
			Delay = delayTime,
			Force = opts.Force,
		})
	end)
end

--==============================================================
-- Хелперы для типовых эффектов
--==============================================================
function Motion.fadeIn(instance, opts)
	opts = opts or {}
	local goals = {}
	if instance:IsA("GuiObject") then
		goals.BackgroundTransparency = opts.Background or 0
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		goals.TextTransparency = opts.Text or 0
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		goals.ImageTransparency = opts.Image or 0
	end
	return Motion.tween(instance, goals, opts)
end

function Motion.fadeOut(instance, opts)
	opts = opts or {}
	local goals = {}
	if instance:IsA("GuiObject") then
		goals.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		goals.TextTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		goals.ImageTransparency = 1
	end
	return Motion.tween(instance, goals, opts)
end

-- Пульсация: используется при записи бинда («нажмите клавишу»)
function Motion.pulse(instance, property: string, from, to, period: number?)
	local pulseState = { _alive = true }
	local elapsed = 0
	period = period or 1.1

	local signal = RunService and (RunService.RenderStepped or RunService.Heartbeat)
	if not signal then
		return pulseState
	end

	local conn
	conn = signal:Connect(function(dt)
		if not pulseState._alive or not instance or not instance.Parent then
			conn:Disconnect()
			return
		end
		elapsed += dt
		-- Синус, приведённый к 0..1
		local t = (math.sin(elapsed * (2 * math.pi / period) - math.pi / 2) + 1) / 2
		local value
		if typeof(from) == "Color3" then
			value = from:Lerp(to, t)
		else
			value = from + (to - from) * t
		end
		pcall(function()
			instance[property] = value
		end)
	end)

	function pulseState:Stop(restore)
		self._alive = false
		if conn then
			conn:Disconnect()
		end
		if restore ~= nil then
			pcall(function()
				instance[property] = restore
			end)
		end
	end

	return pulseState
end

-- «Нажатие»: короткое сжатие через UIScale
function Motion.press(instance, scaleTarget: number?)
	local scale = instance:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = instance
	end
	Motion.tween(scale, { Scale = scaleTarget or 0.96 }, {
		Duration = Motion.Duration.Micro,
		Easing = Motion.Easing.Accelerate,
	})
end

function Motion.release(instance)
	local scale = instance:FindFirstChildOfClass("UIScale")
	if not scale then
		return
	end
	Motion.tween(scale, { Scale = 1 }, {
		Duration = Motion.Duration.Normal,
		Easing = Motion.Easing.Overshoot,
	})
end

return Motion
end

__swagga_modules["Notification"] = function()

--[[
	Notifications — тосты в углу экрана.

	Особенности:
	  • Своя ScreenGui: тосты видны, даже если окно свёрнуто.
	  • Полоска обратного отсчёта — понятно, сколько осталось.
	  • Наведение мыши ставит таймер на паузу.
	  • Стек: новые появляются снизу, старые уезжают вверх.
	  • Кнопки действий (опционально).
]]

local Compat = __swagga_require("Compat")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Icons = __swagga_require("Icons")

local create = Util.create

local Notifications = {}
Notifications.__index = Notifications

local WIDTH = 290
local GAP = 8
local MARGIN = 16

function Notifications.new(library)
	local self = setmetatable({}, Notifications)
	self.Library = library
	self.Active = {}
	self.Janitor = Util.janitor()

	local gui = create("ScreenGui", {
		Name = "\0" .. tostring(math.random(1e6, 9e6)),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = 1000,
	})
	Compat.Protect(gui)
	local parent = Compat.GetGuiParent()
	if parent then
		gui.Parent = parent
	end
	self.ScreenGui = gui
	self.Janitor:Add(gui)

	-- Контейнер: правый нижний угол, элементы растут вверх
	local holder = create("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -MARGIN, 1, -MARGIN),
		Size = UDim2.fromOffset(WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Util.listLayout({
			Padding = UDim.new(0, GAP),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
		}),
	})
	self.Holder = holder

	return self
end

--==============================================================
-- Показ
--==============================================================
function Notifications:Notify(config)
	if type(config) == "string" then
		config = { Title = config }
	end
	config = config or {}

	local title = config.Title or "Уведомление"
	local content = config.Content or config.Text or ""
	local duration = config.Duration or 4
	local icon = config.Icon
	local kind = (config.Type or "default"):lower()
	local actions = config.Actions

	-- Цвет по типу
	local accentToken = ({
		success = "Success",
		error = "Danger",
		danger = "Danger",
		warning = "Warning",
		info = "Info",
	})[kind] or "Accent"

	if not icon then
		icon = ({
			success = "check",
			error = "x",
			danger = "x",
			warning = "info",
			info = "info",
		})[kind]
	end

	-- Высота под контент
	local hasContent = content ~= ""
	local baseHeight = hasContent and 62 or 44
	if actions then
		baseHeight = baseHeight + 30
	end

	local card = create("Frame", {
		Name = "Toast",
		Size = UDim2.fromOffset(WIDTH, baseHeight),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = os.clock() * 1000,
		Parent = self.Holder,
	}, {
		Util.corner(10),
	})
	Theme.bind(card, "BackgroundColor3", "Element")

	Util.shadow(card, { Blur = 24, Transparency = 0.4, OffsetY = 6 })

	local stroke = Util.stroke(Theme.get("Stroke"), 1, 0.4)
	if stroke then
		stroke.Parent = card
		Theme.bind(stroke, "Color", "Stroke")
	end

	-- Акцентная полоса слева
	local accentBar = create("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, 3, 1, 0),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = card,
	}, {
		Util.cornerEach(10, 0, 0, 10),
	})
	Theme.bind(accentBar, "BackgroundColor3", accentToken)

	-- Иконка
	local iconLabel
	if icon then
		iconLabel = create("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0),
			Position = UDim2.new(0, 14, 0, 13),
			Size = UDim2.fromOffset(17, 17),
			ScaleType = Enum.ScaleType.Fit,
			ImageTransparency = 1,
			ZIndex = 4,
			Parent = card,
		})
		if not Icons.apply(iconLabel, icon) then
			iconLabel:Destroy()
			iconLabel = nil
		else
			Theme.bind(iconLabel, "ImageColor3", accentToken)
		end
	end

	local textLeft = iconLabel and 40 or 16

	local titleLabel = create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, textLeft, 0, 12),
		Size = UDim2.new(1, -textLeft - 34, 0, 17),
		Font = Enum.Font.GothamBold,
		Text = title,
		TextSize = 13,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 4,
		Parent = card,
	})
	Theme.bind(titleLabel, "TextColor3", "TextPrimary")

	local contentLabel
	if hasContent then
		contentLabel = create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, textLeft, 0, 31),
			Size = UDim2.new(1, -textLeft - 16, 0, 24),
			Font = Enum.Font.Gotham,
			Text = content,
			TextSize = 11,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			ZIndex = 4,
			Parent = card,
		})
		Theme.bind(contentLabel, "TextColor3", "TextSecondary")
	end

	-- Кнопка закрытия
	local closeBtn = create("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = "×",
		TextSize = 15,
		TextTransparency = 1,
		ZIndex = 5,
		Parent = card,
	}, {
		Util.corner(5),
	})
	Theme.bind(closeBtn, "TextColor3", "TextMuted")

	-- Полоса обратного отсчёта
	local progress = create("Frame", {
		Name = "Progress",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = card,
	})
	Theme.bind(progress, "BackgroundColor3", accentToken)

	-- Кнопки действий
	if actions then
		local row = create("Frame", {
			Name = "Actions",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -8),
			Size = UDim2.new(1, -textLeft - 12, 0, 24),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = card,
		}, {
			Util.listLayout({
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				Padding = UDim.new(0, 6),
			}),
		})

		for index, action in ipairs(actions) do
			local btn = create("TextButton", {
				Name = action.Text,
				Size = UDim2.fromOffset(72, 24),
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Font = Enum.Font.GothamMedium,
				Text = action.Text,
				TextSize = 11,
				TextTransparency = 1,
				LayoutOrder = index,
				ZIndex = 5,
				Parent = row,
			}, {
				Util.corner(5),
			})
			Theme.bind(btn, "BackgroundColor3", index == 1 and accentToken or "ElementActive")
			Theme.bind(btn, "TextColor3", index == 1 and "Background" or "TextSecondary")

			btn.MouseEnter:Connect(function()
				Motion.fast(btn, { BackgroundTransparency = 0.15 })
			end)
			btn.MouseLeave:Connect(function()
				Motion.fast(btn, { BackgroundTransparency = 0.35 })
			end)
			btn.Activated:Connect(function()
				if action.Callback then
					task.spawn(action.Callback)
				end
				self:_dismiss(card)
			end)

			Motion.tween(btn, { BackgroundTransparency = 0.35, TextTransparency = 0 }, {
				Duration = Motion.Duration.Normal,
				Delay = 0.14,
			})
		end
	end

	--=== Появление: выезд справа ===
	card.Position = UDim2.fromOffset(WIDTH + 20, 0)
	local entry = {
		Card = card,
		Progress = progress,
		Paused = false,
		Elapsed = 0,
		Duration = duration,
	}
	table.insert(self.Active, entry)

	Motion.tween(card, { BackgroundTransparency = 0 }, { Duration = Motion.Duration.Normal })

	-- Выезд по X через UIPadding не сработает в UIListLayout,
	-- поэтому анимируем сам Position (лейаут учитывает только Size)
	local slideIn = create("UIScale", { Scale = 0.9, Parent = card })
	Motion.tween(slideIn, { Scale = 1 }, {
		Duration = Motion.Duration.Slower,
		Easing = Motion.Easing.Overshoot,
	})

	Motion.tween(titleLabel, { TextTransparency = 0 }, {
		Duration = Motion.Duration.Normal,
		Delay = 0.06,
	})
	if contentLabel then
		Motion.tween(contentLabel, { TextTransparency = 0.3 }, {
			Duration = Motion.Duration.Normal,
			Delay = 0.09,
		})
	end
	if iconLabel then
		Motion.tween(iconLabel, { ImageTransparency = 0 }, {
			Duration = Motion.Duration.Normal,
			Delay = 0.06,
		})
	end
	Motion.tween(closeBtn, { TextTransparency = 0.5 }, {
		Duration = Motion.Duration.Normal,
		Delay = 0.1,
	})
	Motion.tween(progress, { BackgroundTransparency = 0.3 }, {
		Duration = Motion.Duration.Fast,
	})

	--=== Взаимодействие ===
	closeBtn.MouseEnter:Connect(function()
		Motion.fast(closeBtn, { TextTransparency = 0, BackgroundTransparency = 0.85 })
	end)
	closeBtn.MouseLeave:Connect(function()
		Motion.fast(closeBtn, { TextTransparency = 0.5, BackgroundTransparency = 1 })
	end)
	closeBtn.Activated:Connect(function()
		self:_dismiss(card)
	end)

	-- Пауза при наведении
	card.MouseEnter:Connect(function()
		entry.Paused = true
		Motion.fast(card, { BackgroundColor3 = Theme.get("ElementHover") })
	end)
	card.MouseLeave:Connect(function()
		entry.Paused = false
		Motion.fast(card, { BackgroundColor3 = Theme.get("Element") })
	end)

	--=== Таймер ===
	--[[
		Отсчёт через Heartbeat, а не через while + task.wait.
		Причины:
		  • пауза при наведении обрабатывается естественно —
		    просто не накапливаем dt;
		  • нет висящего потока, если тост удалили досрочно;
		  • полоска обновляется синхронно с кадром, без рывков.
	]]
	if duration > 0 then
		local RunService = Compat.Services.Run
		local signal = RunService and (RunService.Heartbeat or RunService.RenderStepped)
		if signal then
			local conn
			conn = signal:Connect(function(dt)
				if card.Parent == nil or card:GetAttribute("Dismissing") then
					conn:Disconnect()
					return
				end
				if entry.Paused then
					return
				end
				entry.Elapsed += dt
				local remaining = 1 - (entry.Elapsed / duration)
				progress.Size = UDim2.new(math.max(0, remaining), 0, 0, 2)
				if entry.Elapsed >= duration then
					conn:Disconnect()
					self:_dismiss(card)
				end
			end)
			entry.Connection = conn
			self.Janitor:Add(conn)
		end
	else
		progress.Visible = false
	end

	-- Handle для внешнего управления
	return {
		Close = function()
			self:_dismiss(card)
		end,
		SetContent = function(_, text)
			if contentLabel then
				contentLabel.Text = text
			end
		end,
		SetTitle = function(_, text)
			titleLabel.Text = text
		end,
	}
end

function Notifications:_dismiss(card)
	if not card or card.Parent == nil or card:GetAttribute("Dismissing") then
		return
	end
	card:SetAttribute("Dismissing", true)

	for i = #self.Active, 1, -1 do
		if self.Active[i].Card == card then
			-- Снимаем таймер, чтобы он не тикал по мёртвой карточке
			if self.Active[i].Connection then
				pcall(function()
					self.Active[i].Connection:Disconnect()
				end)
			end
			table.remove(self.Active, i)
		end
	end

	local scale = card:FindFirstChildOfClass("UIScale")
	if scale then
		Motion.tween(scale, { Scale = 0.85 }, {
			Duration = Motion.Duration.Normal,
			Easing = Motion.Easing.Accelerate,
		})
	end

	Motion.tween(card, { BackgroundTransparency = 1 }, { Duration = Motion.Duration.Normal })
	for _, child in ipairs(card:GetDescendants()) do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			Motion.tween(child, { TextTransparency = 1 }, { Duration = Motion.Duration.Fast })
		elseif child:IsA("ImageLabel") then
			Motion.tween(child, { ImageTransparency = 1 }, { Duration = Motion.Duration.Fast })
		elseif child:IsA("Frame") then
			Motion.tween(child, { BackgroundTransparency = 1 }, { Duration = Motion.Duration.Fast })
		end
	end

	-- Схлопываем высоту, чтобы соседи плавно съехали
	Motion.tween(card, { Size = UDim2.fromOffset(WIDTH, 0) }, {
		Duration = Motion.Duration.Slow,
		Easing = Motion.Easing.Standard,
		Delay = 0.08,
		OnComplete = function()
			if card then
				card:Destroy()
			end
		end,
	})
end

function Notifications:ClearAll()
	for i = #self.Active, 1, -1 do
		self:_dismiss(self.Active[i].Card)
	end
end

function Notifications:Destroy()
	self:ClearAll()
	self.Janitor:Clean()
end

return Notifications
end

__swagga_modules["Save"] = function()

--[[
	Save — автосохранение значений и менеджер конфигов.

	Как работает:
	  • Каждый элемент с флагом регистрируется здесь.
	  • При изменении элемент вызывает Mark() — сохранение
	    откладывается на debounce-интервал. Иначе перетаскивание
	    слайдера писало бы файл сотни раз в секунду.
	  • Конфиги — отдельные именованные слоты в подпапке.

	Если файловых функций нет (обычная игра), всё работает
	в памяти: интерфейс не ломается, просто не переживает перезаход.
]]

local Compat = __swagga_require("Compat")

local Signal = __swagga_require("Signal")

local Save = {}
Save.__index = Save

local DEBOUNCE = 0.6

function Save.new(library, config)
	local self = setmetatable({}, Save)
	self.Library = library
	self.Folder = config.ConfigFolder or "SwaggaLib"
	self.Enabled = config.ConfigSaving ~= false
	self.AutoLoad = config.AutoLoad ~= false
	self.Elements = {} -- [flag] = element
	self.Memory = {} -- fallback, если нет файловой системы
	self.Dirty = false
	self.CurrentConfig = config.DefaultConfig or "default"

	self.Saved = Signal.new("Save.Saved")
	self.Loaded = Signal.new("Save.Loaded")

	self.CanUseFiles = Compat.CanSaveFiles
	if self.CanUseFiles then
		self:_ensureFolders()
	end

	return self
end

--==============================================================
-- Пути
--==============================================================
function Save:_ensureFolders()
	if not Compat.makefolder then
		return
	end
	local paths = { self.Folder, self.Folder .. "/configs" }
	for _, path in ipairs(paths) do
		local ok, exists = pcall(Compat.isfolder, path)
		if ok and not exists then
			pcall(Compat.makefolder, path)
		end
	end
end

function Save:_configPath(name)
	return ("%s/configs/%s.json"):format(self.Folder, name or self.CurrentConfig)
end

function Save:_settingsPath()
	return ("%s/settings.json"):format(self.Folder)
end

--==============================================================
-- Регистрация
--==============================================================
function Save:Register(element)
	if not element.Flag or element.ForgetState then
		return
	end
	self.Elements[element.Flag] = element
end

function Save:Unregister(element)
	if element.Flag then
		self.Elements[element.Flag] = nil
	end
end

--[[
	Пометить как изменённое. Реальная запись — через debounce.

	Про _loadToken: если пользователь меняет значение, а затем
	сразу грузит другой конфиг, отложенная запись успела бы
	перетереть только что загруженный слот старыми значениями.
	Поэтому запоминаем «поколение» состояния и отменяем запись,
	если между постановкой и срабатыванием была загрузка.
]]
function Save:Mark(element)
	if not self.Enabled or self._loading or self._destroyed then
		return
	end
	self.Dirty = true

	if self._pending then
		return
	end
	self._pending = true

	local token = self._loadToken or 0
	local target = self.CurrentConfig

	task.delay(DEBOUNCE, function()
		self._pending = false
		-- Библиотеку могли выгрузить, пока ждали debounce
		if self._destroyed then
			return
		end
		if (self._loadToken or 0) ~= token then
			return -- за это время была загрузка, запись неактуальна
		end
		if self.Dirty then
			self:SaveConfig(target, true)
		end
	end)
end

--==============================================================
-- Сериализация
--==============================================================
function Save:Collect()
	local data = { _version = 2, _saved = os.time(), flags = {} }
	for flag, element in pairs(self.Elements) do
		if not element.Destroyed then
			local ok, serialized = pcall(function()
				return element:Serialize()
			end)
			if ok and serialized then
				data.flags[flag] = serialized
			end
		end
	end
	return data
end

function Save:Apply(data)
	if type(data) ~= "table" or type(data.flags) ~= "table" then
		return false
	end
	local applied = 0
	for flag, entry in pairs(data.flags) do
		local element = self.Elements[flag]
		if element and not element.Destroyed then
			local ok = pcall(function()
				element:Deserialize(entry)
			end)
			if ok then
				applied += 1
			end
		end
	end
	self.Loaded:Fire(applied)
	return true, applied
end

--==============================================================
-- Файлы
--==============================================================
function Save:SaveConfig(name, silent)
	if not self.Enabled or self._destroyed then
		return false
	end
	name = name or self.CurrentConfig
	local data = self:Collect()
	self.Dirty = false

	local HttpService = Compat.Services.Http
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not ok then
		warn("[Swagga] Не удалось сериализовать конфиг")
		return false
	end

	if self.CanUseFiles then
		local writeOk = pcall(Compat.writefile, self:_configPath(name), encoded)
		if not writeOk then
			warn("[Swagga] Ошибка записи конфига: " .. name)
			return false
		end
	else
		self.Memory[name] = encoded
	end

	self.Saved:Fire(name)

	if not silent and self.Library.Notify then
		self.Library:Notify({
			Title = "Конфиг сохранён",
			Content = name,
			Icon = "save",
			Type = "success",
			Duration = 2,
		})
	end
	return true
end

function Save:LoadConfig(name, silent)
	name = name or self.CurrentConfig
	local raw

	if self.CanUseFiles then
		local path = self:_configPath(name)
		local exists = false
		pcall(function()
			exists = Compat.isfile(path)
		end)
		if not exists then
			if not silent and self.Library.Notify then
				self.Library:Notify({
					Title = "Конфиг не найден",
					Content = name,
					Icon = "x",
					Type = "warning",
					Duration = 2,
				})
			end
			return false
		end
		local ok, content = pcall(Compat.readfile, path)
		if not ok then
			return false
		end
		raw = content
	else
		raw = self.Memory[name]
		if not raw then
			return false
		end
	end

	local HttpService = Compat.Services.Http
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok then
		warn("[Swagga] Повреждённый конфиг: " .. name)
		return false
	end

	-- Инвалидируем отложенные записи и глушим Mark на время применения
	self._loadToken = (self._loadToken or 0) + 1
	self._loading = true

	local applied
	ok, applied = self:Apply(data)

	self._loading = false
	self.CurrentConfig = name
	self.Dirty = false

	if not silent and self.Library.Notify then
		self.Library:Notify({
			Title = "Конфиг загружен",
			Content = ("%s (%d значений)"):format(name, applied or 0),
			Icon = "download",
			Type = "success",
			Duration = 2,
		})
	end
	return true
end

function Save:DeleteConfig(name)
	if self.CanUseFiles and Compat.delfile then
		pcall(Compat.delfile, self:_configPath(name))
	else
		self.Memory[name] = nil
	end
	return true
end

function Save:ListConfigs()
	local names = {}

	if self.CanUseFiles and Compat.listfiles then
		local ok, files = pcall(Compat.listfiles, self.Folder .. "/configs")
		if ok and type(files) == "table" then
			for _, path in ipairs(files) do
				local name = tostring(path):match("([^/\\]+)%.json$")
				if name then
					table.insert(names, name)
				end
			end
		end
	else
		for name in pairs(self.Memory) do
			table.insert(names, name)
		end
	end

	table.sort(names)
	return names
end

--==============================================================
-- Настройки самой библиотеки (тема, скорость анимаций)
--==============================================================
function Save:SaveSettings(settings)
	local HttpService = Compat.Services.Http
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(settings)
	end)
	if not ok then
		return false
	end

	if self.CanUseFiles then
		pcall(Compat.writefile, self:_settingsPath(), encoded)
	else
		self.Memory["__settings"] = encoded
	end
	return true
end

function Save:LoadSettings()
	local raw
	if self.CanUseFiles then
		local path = self:_settingsPath()
		local exists = false
		pcall(function()
			exists = Compat.isfile(path)
		end)
		if not exists then
			return nil
		end
		local ok, content = pcall(Compat.readfile, path)
		if not ok then
			return nil
		end
		raw = content
	else
		raw = self.Memory["__settings"]
		if not raw then
			return nil
		end
	end

	local HttpService = Compat.Services.Http
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok then
		return data
	end
	return nil
end

function Save:Destroy()
	if self._destroyed then
		return
	end
	-- Досохраняем несохранённое ДО того, как пометим мёртвым
	if self.Dirty and self.Enabled then
		pcall(function()
			self:SaveConfig(self.CurrentConfig, true)
		end)
	end
	--[[
		Флаг обязателен: отложенный автосейв (task.delay) мог быть
		запланирован до выгрузки. Без него он просыпался уже после
		Destroy и падал на self.CurrentConfig == nil.
	]]
	self._destroyed = true
	self.Dirty = false
	self.Elements = {}
	self.Saved:Destroy()
	self.Loaded:Destroy()
end

return Save
end

__swagga_modules["SettingsOverlay"] = function()

--[[
	SettingsOverlay — панель настроек как в оригинальном Swagga Lib.

	Так это устроено в исходнике (Background.MoreTabs):
	  • Frame размером 1×1 поверх всего окна, BackgroundTransparency 0.1
	  • Внутри — горизонтальная навигация (Theme · Keybinds · Privacy)
	  • Под навигацией скользящий слайдер-подчёркивание
	  • Открывается из панели More (кнопка «…» в топбаре)
	  • Появление: фон гаснет → подпункты проявляются по очереди

	Это НЕ вкладка сайдбара — вкладка была неправильным решением.
]]

local Compat = __swagga_require("Compat")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Icons = __swagga_require("Icons")

local create = Util.create
local UIS = Compat.Services.Input

local SettingsOverlay = {}
SettingsOverlay.__index = SettingsOverlay

local NAV_HEIGHT = 40
local HEADER_HEIGHT = 52
local ROW_H = 40
local PAD = 16

--[[
	Универсальная выезжающая панель поверх окна.
	В оригинале таких три: Settings, InfoAbout, Credits — все живут
	в Background.MoreTabs и открываются из панели «…».
]]
function SettingsOverlay.new(library, window, title)
	local self = setmetatable({}, SettingsOverlay)
	self.Library = library
	self.Window = window
	self.Title_ = title or "Настройки"
	self.IsOpen = false
	self.ActiveSection = nil
	self.Sections = {}
	self.Janitor = Util.janitor()

	self:_build()
	return self
end

--==============================================================
-- Каркас
--==============================================================
function SettingsOverlay:_build()
	local root = self.Window.Root

	-- Оверлей на всё окно (как MoreTabs в оригинале)
	local overlay = create("Frame", {
		Name = "SettingsOverlay",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ClipsDescendants = true,
		ZIndex = 60,
		Parent = root,
	}, {
		Util.corner(15),
	})
	Theme.bind(overlay, "BackgroundColor3", "Surface")
	self.Overlay = overlay

	--=== Шапка ===
	local header = create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
		BackgroundTransparency = 1,
		ZIndex = 61,
		Parent = overlay,
	})
	self.Header = header

	local title = create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, PAD + 4, 0.5, 0),
		Size = UDim2.new(0.5, 0, 0, 20),
		Font = Enum.Font.GothamBold,
		Text = self.Title_,
		TextSize = 15,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
		Parent = header,
	})
	Theme.bind(title, "TextColor3", "TextPrimary")
	self.Title = title

	-- Кнопка «назад»
	local back = create("ImageButton", {
		Name = "Back",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -PAD, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Image = "",
		ZIndex = 62,
		Parent = header,
	}, {
		Util.corner(8),
	})
	Theme.bind(back, "BackgroundColor3", "ElementHover")

	local backIcon = create("ImageLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(15, 15),
		ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = 1,
		ZIndex = 63,
		Parent = back,
	})
	Icons.apply(backIcon, "x")
	Theme.bind(backIcon, "ImageColor3", "TextSecondary")
	self.BackIcon = backIcon

	back.MouseEnter:Connect(function()
		Motion.fast(back, { BackgroundTransparency = 0.85 })
		Motion.fast(backIcon, { ImageTransparency = 0, ImageColor3 = Theme.get("Danger") })
	end)
	back.MouseLeave:Connect(function()
		Motion.fast(back, { BackgroundTransparency = 1 })
		Motion.fast(backIcon, { ImageTransparency = 0.3, ImageColor3 = Theme.get("TextSecondary") })
	end)
	back.Activated:Connect(function()
		self:Close()
	end)

	--=== Горизонтальная навигация ===
	local nav = create("Frame", {
		Name = "Nav",
		Position = UDim2.new(0, PAD, 0, HEADER_HEIGHT),
		Size = UDim2.new(1, -PAD * 2, 0, NAV_HEIGHT),
		BackgroundTransparency = 1,
		ZIndex = 61,
		Parent = overlay,
	}, {
		Util.listLayout({
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
	self.Nav = nav

	-- Скользящее подчёркивание под активным разделом
	local slider = create("Frame", {
		Name = "NavSlider",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, PAD, 0, HEADER_HEIGHT + NAV_HEIGHT - 1),
		Size = UDim2.fromOffset(0, 2),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 63,
		Parent = overlay,
	}, {
		Util.corner(999),
	})
	Theme.bind(slider, "BackgroundColor3", "Accent")
	self.NavSlider = slider
	self.NavSliderGlow = Util.glow(slider, Theme.get("Accent"), { Blur = 8, Transparency = 0.5 })

	-- Пружины для плавного переезда подчёркивания
	self.SliderX = Motion.spring(PAD, { Frequency = 5, Damping = 1 })
	self.SliderW = Motion.spring(0, { Frequency = 5, Damping = 1 })
	self.SliderXDriver = Motion.drive(slider, "Position", self.SliderX, function(x)
		return UDim2.new(0, x, 0, HEADER_HEIGHT + NAV_HEIGHT - 1)
	end)
	self.SliderWDriver = Motion.drive(slider, "Size", self.SliderW, function(w)
		return UDim2.fromOffset(w, 2)
	end)

	-- Разделительная линия
	local line = create("Frame", {
		Name = "NavLine",
		Position = UDim2.new(0, PAD, 0, HEADER_HEIGHT + NAV_HEIGHT - 1),
		Size = UDim2.new(1, -PAD * 2, 0, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = overlay,
	}, {
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.15, 0),
				NumberSequenceKeypoint.new(0.85, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	Theme.bind(line, "BackgroundColor3", "Divider")
	self.NavLine = line

	--=== Контейнер разделов ===
	local body = create("Frame", {
		Name = "Body",
		Position = UDim2.new(0, 0, 0, HEADER_HEIGHT + NAV_HEIGHT),
		Size = UDim2.new(1, 0, 1, -(HEADER_HEIGHT + NAV_HEIGHT)),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 61,
		Parent = overlay,
	})
	self.Body = body

	-- Клик мимо панели ничего не делает: оверлей перекрывает всё окно
	self.NavButtons = {}
end

--==============================================================
-- Разделы
--==============================================================
function SettingsOverlay:AddSection(name, icon)
	local order = #self.Sections + 1

	--=== Кнопка навигации ===
	local btn = create("TextButton", {
		Name = name,
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		ZIndex = 62,
		Parent = self.Nav,
	}, {
		Util.corner(7),
		Util.padding(0, 0, 10, 10),
	})
	Theme.bind(btn, "BackgroundColor3", "ElementHover")

	local iconLabel
	local textLeft = 0
	if icon then
		iconLabel = create("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			ScaleType = Enum.ScaleType.Fit,
			ImageTransparency = 1,
			ZIndex = 63,
			Parent = btn,
		})
		if Icons.apply(iconLabel, icon) then
			Theme.bind(iconLabel, "ImageColor3", "TextSecondary")
			textLeft = 20
		else
			iconLabel:Destroy()
			iconLabel = nil
		end
	end

	local label = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, textLeft, 0, 0),
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Enum.Font.GothamMedium,
		Text = name,
		TextSize = 12.5,
		TextTransparency = 1,
		ZIndex = 63,
		Parent = btn,
	})
	Theme.bind(label, "TextColor3", "TextSecondary")

	--=== Страница раздела ===
	local page = create("ScrollingFrame", {
		Name = name .. "Page",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageTransparency = 0.6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Visible = false,
		ZIndex = 61,
		Parent = self.Body,
	}, {
		Util.listLayout({ Padding = UDim.new(0, 8) }),
		Util.padding(14, 20, PAD, PAD),
	})
	Theme.bind(page, "ScrollBarImageColor3", "TextMuted")

	local section = {
		Name = name,
		Button = btn,
		Label = label,
		Icon = iconLabel,
		Page = page,
		Rows = {},
	}
	table.insert(self.Sections, section)

	btn.MouseEnter:Connect(function()
		if self.ActiveSection ~= section then
			Motion.fast(btn, { BackgroundTransparency = 0.9 })
			Motion.fast(label, { TextTransparency = 0.1 })
			if iconLabel then
				Motion.fast(iconLabel, { ImageTransparency = 0.1 })
			end
		end
	end)
	btn.MouseLeave:Connect(function()
		if self.ActiveSection ~= section then
			Motion.fast(btn, { BackgroundTransparency = 1 })
			Motion.fast(label, { TextTransparency = 0.45 })
			if iconLabel then
				Motion.fast(iconLabel, { ImageTransparency = 0.45 })
			end
		end
	end)
	btn.Activated:Connect(function()
		self:SelectSection(section)
	end)

	if not self.ActiveSection then
		self:SelectSection(section, true)
	end

	return section
end

function SettingsOverlay:SelectSection(section, immediate)
	if self.ActiveSection == section then
		return
	end

	local previous = self.ActiveSection
	self.ActiveSection = section

	if previous then
		Motion.tween(previous.Button, { BackgroundTransparency = 1 }, {
			Duration = Motion.Duration.Normal,
		})
		Motion.tween(previous.Label, {
			TextTransparency = 0.45,
			TextColor3 = Theme.get("TextSecondary"),
		}, { Duration = Motion.Duration.Normal })
		if previous.Icon then
			Motion.tween(previous.Icon, {
				ImageTransparency = 0.45,
				ImageColor3 = Theme.get("TextSecondary"),
			}, { Duration = Motion.Duration.Normal })
		end
		previous.Page.Visible = false
	end

	section.Page.Visible = true
	Motion.tween(section.Button, { BackgroundTransparency = 0.88 }, {
		Duration = Motion.Duration.Normal,
	})
	Motion.tween(section.Label, {
		TextTransparency = 0,
		TextColor3 = Theme.get("TextPrimary"),
	}, { Duration = Motion.Duration.Normal })
	if section.Icon then
		Motion.tween(section.Icon, {
			ImageTransparency = 0,
			ImageColor3 = Theme.get("Accent"),
		}, { Duration = Motion.Duration.Normal })
	end

	-- Подчёркивание переезжает
	self:_moveSlider(section, immediate)

	-- Каскадное появление строк раздела
	if not immediate then
		self:_animateRows(section)
	end
end


--[[
	Позиция подчёркивания.

	Считаем от накопленной ширины предыдущих кнопок, а не через
	AbsolutePosition: после создания элементов движок ещё не
	пересчитал layout, и AbsolutePosition возвращает 0 —
	подчёркивание залипало бы в левом углу.
	AbsoluteSize используем как уточнение, когда layout уже готов.
]]
function SettingsOverlay:_measureButton(section)
	local index = 1
	for i, s in ipairs(self.Sections) do
		if s == section then
			index = i
			break
		end
	end

	local gap = 6            -- Padding у UIListLayout навигации
	local padH = 20          -- UIPadding кнопки (10 слева + 10 справа)
	local x = PAD
	local width = 0

	for i, s in ipairs(self.Sections) do
		-- Оценка ширины: реальная, если layout посчитан, иначе по тексту
		local w = s.Button.AbsoluteSize.X
		if w <= 0 then
			local charW = 7      -- средняя ширина символа при TextSize 12.5
			local iconW = s.Icon and 20 or 0
			w = #s.Name * charW + iconW + padH
		end
		if i == index then
			width = w
			break
		end
		x = x + w + gap
	end

	return x, width
end

function SettingsOverlay:_moveSlider(section, immediate)
	if not section then
		return
	end
	local x, w = self:_measureButton(section)
	if immediate then
		self.SliderX:Snap(x)
		self.SliderW:Snap(w)
	else
		self.SliderX:SetTarget(x)
		self.SliderW:SetTarget(w)
	end
end

function SettingsOverlay:_animateRows(section)
	Motion.stagger(section.Rows, 0.03, function(row, index, delayTime)
		if not row or not row.Parent then
			return
		end
		row.BackgroundTransparency = 1
		Motion.tween(row, { BackgroundTransparency = 0 }, {
			Duration = Motion.Duration.Normal,
			Delay = delayTime,
		})
		for _, child in ipairs(row:GetDescendants()) do
			if child:IsA("TextLabel") then
				local base = child:GetAttribute("BaseT") or child.TextTransparency
				child:SetAttribute("BaseT", base)
				child.TextTransparency = 1
				Motion.tween(child, { TextTransparency = base }, {
					Duration = Motion.Duration.Normal,
					Delay = delayTime + 0.02,
				})
			end
		end
	end)
end


