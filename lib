		text = string.format("%." .. self.Decimals .. "f", value)
	else
		text = tostring(math.floor(value + 0.5))
	end
	return self.Prefix .. text .. self.Suffix
end

function Stat:_render()
	self.ValueLabel.Text = self:_format(tonumber(self.Value) or 0)
end

function Stat:Set(value)
	local previous = tonumber(self.Value) or 0
	local current = tonumber(value) or 0
	self.Value = current

	-- Плавный «прокрут» числа
	local steps = 12
	local step = 0
	local diff = current - previous

	if math.abs(diff) < 0.001 or Motion.ReducedMotion then
		self:_render()
	else
		task.spawn(function()
			for i = 1, steps do
				if self.Destroyed then
					return
				end
				step = i / steps
				-- ease-out
				local eased = 1 - (1 - step) ^ 3
				self.ValueLabel.Text = self:_format(previous + diff * eased)
				task.wait(0.016)
			end
			if not self.Destroyed then
				self:_render()
			end
		end)
	end

	-- Индикатор дельты
	if math.abs(diff) > 0.001 then
		local positive = diff > 0
		self.DeltaLabel.Text = (positive and "▲ +" or "▼ ") .. self:_format(math.abs(diff)):gsub(self.Prefix, "")
		self.DeltaLabel.TextColor3 = positive and Theme.get("Success") or Theme.get("Danger")
		self.DeltaLabel.TextTransparency = 0.2

		Motion.tween(self.DeltaLabel, { TextTransparency = 1 }, {
			Duration = Motion.Duration.Lazy,
			Delay = 1.2,
		})
	end

	self.Changed:Fire(current)
	return self
end

function Stat:Get()
	return self.Value
end

Static.Section = Section
Static.Label = Label
Static.Paragraph = Paragraph
Static.Divider = Divider
Static.Stat = Stat

return Static
end

__swagga_modules["elements/Toggle"] = function()

--[[
	Toggle — переключатель «вкл/выкл».

	Визуал: капсула-свитч с бегунком. При включении:
	  • фон капсулы твинится в акцент
	  • бегунок переезжает пружиной (не твином — чтобы быстрые
	    повторные клики не дёргали картинку)
	  • появляется мягкое свечение акцентом
	  • бегунок слегка растягивается в движении («сквош»)
]]

local Element = __swagga_require("Element")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")

local create = Util.create

local Toggle = setmetatable({}, { __index = Element })
Toggle.__index = Toggle

local TRACK_WIDTH = 40
local TRACK_HEIGHT = 22
local KNOB_SIZE = 16

function Toggle.new(tab, config)
	config = config or {}
	local self = Element.new(tab, config, "toggle")
	setmetatable(self, Toggle)

	self.Default = config.Default or config.CurrentValue or false
	self.Value = self.Default

	self:_buildControl()

	-- Стартовый бинд из конфига
	if config.Keybind then
		self:SetKeybind(config.Keybind, config.KeybindMode)
	end

	-- Применяем начальное состояние без анимации
	self:_render(true)
	tab:_register(self)
	return self
end

function Toggle:_buildControl()
	local track = create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X, 0.5, 0),
		Size = UDim2.fromOffset(TRACK_WIDTH, TRACK_HEIGHT),
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = self.Frame,
	}, {
		Util.corner(999),
	})
	--[[
		Цвет капсулы зависит от состояния (вкл/выкл), поэтому
		статический Theme.bind тут не подходит: при смене темы он
		красил бы включённый тумблер в «выключенный» цвет.
		Вместо этого подписываемся на смену темы и перерисовываем.
	]]
	track.BackgroundColor3 = Theme.get("ElementActive")
	self.Track = track

	-- Обводка капсулы в выключенном состоянии
	local trackStroke = Util.stroke(Theme.get("Stroke"), 1, 0.3)
	if trackStroke then
		trackStroke.Parent = track
		Theme.bind(trackStroke, "Color", "Stroke")
		self.TrackStroke = trackStroke
	end

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(KNOB_SIZE, KNOB_SIZE),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = track,
	}, {
		Util.corner(999),
	})
	knob.BackgroundColor3 = Theme.get("TextSecondary")
	self.Knob = knob

	-- Тень бегунка — придаёт объём
	self.KnobShadow = Util.shadow(knob, {
		Blur = 6,
		Transparency = 0.55,
		OffsetY = 1,
	})

	-- Свечение включённого состояния
	self.TrackGlow = Util.glow(track, Theme.get("Accent"), {
		Blur = 14,
		Transparency = 1, -- невидимо, пока выключено
	})

	-- Пружина позиции бегунка
	local offOffset = 3
	local onOffset = TRACK_WIDTH - KNOB_SIZE - 3
	self.KnobSpring = Motion.spring(offOffset, { Frequency = 6, Damping = 1 })
	self.KnobDriver = Motion.drive(knob, "Position", self.KnobSpring, function(x)
		return UDim2.new(0, x, 0.5, 0)
	end)
	self._offOffset = offOffset
	self._onOffset = onOffset

	-- Клик
	self.Janitor:Add(self.HitArea.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		self:Set(not self.Value)
	end))

	-- Перерисовка при смене темы — с учётом текущего состояния
	self.Janitor:Add(Theme.Changed:Connect(function()
		if not self.Destroyed then
			self:_render(true)
		end
	end))
end

--[[
	Отрисовка состояния.
	immediate = true — без анимации (инициализация / загрузка конфига).
]]
function Toggle:_render(immediate)
	local on = self.Value
	local duration = immediate and 0 or Motion.Duration.Normal

	-- Бегунок
	local targetX = on and self._onOffset or self._offOffset
	if immediate then
		self.KnobSpring:Snap(targetX)
		self.Knob.Position = UDim2.new(0, targetX, 0.5, 0)
	else
		self.KnobSpring:SetTarget(targetX)
		-- Сквош: бегунок вытягивается по ходу движения
		Motion.tween(self.Knob, { Size = UDim2.fromOffset(KNOB_SIZE + 5, KNOB_SIZE) }, {
			Duration = Motion.Duration.Micro,
			OnComplete = function()
				Motion.tween(self.Knob, { Size = UDim2.fromOffset(KNOB_SIZE, KNOB_SIZE) }, {
					Duration = Motion.Duration.Normal,
					Easing = Motion.Easing.Overshoot,
				})
			end,
		})
	end

	-- Цвета
	Motion.tween(self.Track, {
		BackgroundColor3 = on and Theme.get("Accent") or Theme.get("ElementActive"),
	}, { Duration = duration })

	Motion.tween(self.Knob, {
		BackgroundColor3 = on and Color3.new(1, 1, 1) or Theme.get("TextSecondary"),
	}, { Duration = duration })

	if self.TrackStroke then
		Motion.tween(self.TrackStroke, { Transparency = on and 1 or 0.3 }, {
			Duration = duration,
		})
	end

	-- Свечение
	if self.TrackGlow then
		local target, prop = self.TrackGlow:GetTweenTarget()
		self.TrackGlow:SetColor(Theme.get("Accent"))
		Motion.tween(target, { [prop] = on and 0.45 or 1 }, { Duration = duration })
	end

	-- Заголовок ярче во включённом состоянии
	Motion.tween(self.Title, {
		TextTransparency = self.Enabled and (on and 0 or 0.15) or 0.5,
	}, { Duration = duration })
end

function Toggle:Set(value, skipCallback)
	value = value and true or false
	if value == self.Value and self._initialized then
		return self
	end
	self._initialized = true
	self.Value = value
	self:_render(false)

	if not skipCallback and self.Callback then
		task.spawn(self.Callback, value)
	end
	self.Changed:Fire(value)
	self:_save()
	return self
end

function Toggle:Get()
	return self.Value
end

function Toggle:OnEnabledChanged(enabled)
	if self.Track then
		Motion.tween(self.Track, { BackgroundTransparency = enabled and 0 or 0.5 }, {
			Duration = Motion.Duration.Normal,
		})
	end
end

function Toggle:Destroy()
	if self.KnobDriver then
		self.KnobDriver:Stop()
	end
	Element.Destroy(self)
end

return Toggle
end

__swagga_modules["init"] = function()

--[[
	Swagga Lib — Legendary Edition
	Точка входа библиотеки.

	local Swagga = loadstring(game:HttpGet("<url>"))()
	local Window = Swagga:CreateWindow({ Name = "Меню" })
	local Tab    = Window:CreateTab({ Name = "Аим", Icon = "crosshair" })
	Tab:CreateToggle({ Name = "Включить", Callback = print })
]]

local Compat = __swagga_require("Compat")
