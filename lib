local __swagga_modules = {}
local __swagga_cache = {}

local function __swagga_require(name)
	local cached = __swagga_cache[name]
	if cached ~= nil then
		return cached.value
	end
	local factory = __swagga_modules[name]
	if not factory then
		error("[Swagga] Модуль не найден: " .. tostring(name), 2)
	end
	-- Помечаем как загружаемый: ловим циклические зависимости
	__swagga_cache[name] = { value = nil, loading = true }
	local result = factory()
	__swagga_cache[name] = { value = result }
	return result
end

__swagga_modules["Binds"] = function()

local Compat = __swagga_require("Compat")
local Util = __swagga_require("Util")
local Signal = __swagga_require("Signal")

local UIS = Compat.Services.Input
local RunService = Compat.Services.Run

local Binds = {}
Binds.__index = Binds

function Binds.new(library)
	local self = setmetatable({}, Binds)
	self.Library = library
	self.Registry = {} -- [keyName] = { element, ... }
	self.HeldKeys = {} -- [keyName] = timestamp
	self.AlwaysActive = {} -- элементы в режиме Always
	self.Janitor = Util.janitor()
	self.Enabled = true

	self.Triggered = Signal.new("Binds.Triggered")

	self:_listen()
	return self
end

local function keyName(key)
	if not key then
		return nil
	end
	if typeof(key) == "EnumItem" then
		return key.Name
	end
	return tostring(key)
end

--==============================================================
-- Регистрация
--==============================================================
function Binds:Register(element, previousKey)
	if previousKey then
		self:_removeFrom(previousKey, element)
	end

	local key = element.Keybind or element.Value
	if not key then
		return
	end

	local name = keyName(key)
	if not name then
		return
	end

	self.Registry[name] = self.Registry[name] or {}
	if not Util.tableContains(self.Registry[name], element) then
		table.insert(self.Registry[name], element)
	end

	-- Always-режим требует покадрового опроса
	local mode = element.KeybindMode or element.Mode
	if mode == "Always" then
		self.AlwaysActive[element] = true
		self:_ensureAlwaysLoop()
	else
		self.AlwaysActive[element] = nil
	end
end

Binds.Update = Binds.Register

function Binds:_removeFrom(key, element)
	local name = keyName(key)
	if not name or not self.Registry[name] then
		return
	end
	local list = self.Registry[name]
	for i = #list, 1, -1 do
		if list[i] == element then
			table.remove(list, i)
		end
	end
	if #list == 0 then
		self.Registry[name] = nil
	end
end

function Binds:Remove(element)
	for name, list in pairs(self.Registry) do
		for i = #list, 1, -1 do
			if list[i] == element then
				table.remove(list, i)
			end
		end
		if #list == 0 then
			self.Registry[name] = nil
		end
	end
	self.AlwaysActive[element] = nil
end

--==============================================================
-- Слушатель
--==============================================================
function Binds:_listen()
	self.Janitor:Add(UIS.InputBegan:Connect(function(input, processed)
		if not self.Enabled then
			return
		end
		-- Игнорируем ввод в текстовые поля
		if processed then
			return
		end
		if UIS:GetFocusedTextBox() then
			return
		end

		local name = self:_inputName(input)
		if not name then
			return
		end

		self.HeldKeys[name] = os.clock()
		local list = self.Registry[name]
		if not list then
			return
		end

		for _, element in ipairs(list) do
			if element.Enabled ~= false and not element.Destroyed then
				local mode = element.KeybindMode or element.Mode or "Toggle"
				if mode == "Toggle" then
					self:_fire(element, true)
				elseif mode == "Hold" then
					-- Порог: короткий тап не считается
					local threshold = element.HoldThreshold or 0.15
					task.delay(threshold, function()
						if self.HeldKeys[name] and not element.Destroyed then
							self:_fire(element, true)
							element._holdActive = true
						end
					end)
				end
			end
		end
	end))

	self.Janitor:Add(UIS.InputEnded:Connect(function(input)
		local name = self:_inputName(input)
		if not name then
			return
		end
		self.HeldKeys[name] = nil

		local list = self.Registry[name]
		if not list then
			return
		end

		for _, element in ipairs(list) do
			if not element.Destroyed then
				local mode = element.KeybindMode or element.Mode or "Toggle"
				if mode == "Hold" and element._holdActive then
					element._holdActive = false
					self:_fire(element, false)
				end
			end
		end
	end))
end

function Binds:_inputName(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.Unknown then
			return nil
		end
		return input.KeyCode.Name
	elseif input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.MouseButton2
		or input.UserInputType == Enum.UserInputType.MouseButton3 then
		return input.UserInputType.Name
	end
	return nil
end

function Binds:_fire(element, state)
	if element.OnKeybindTriggered then
		local ok, err = pcall(function()
			element:OnKeybindTriggered(state)
		end)
		if not ok then
			warn(("[Swagga] Ошибка бинда %s: %s"):format(tostring(element.Name), tostring(err)))
		end
	end
	self.Triggered:Fire(element, state)
end

--==============================================================
-- Always-режим
--==============================================================
function Binds:_ensureAlwaysLoop()
	if self._alwaysConn then
		return
	end
	local signal = RunService and (RunService.Heartbeat or RunService.RenderStepped)
	if not signal then
		return
	end

	self._alwaysConn = signal:Connect(function()
		local any = false
		for element in pairs(self.AlwaysActive) do
			if element.Destroyed then
				self.AlwaysActive[element] = nil
			else
				any = true
				local key = element.Keybind or element.Value
				local name = keyName(key)
				if name and self.HeldKeys[name] and element.Enabled ~= false then
					self:_fire(element, true)
				end
			end
		end
		if not any and self._alwaysConn then
			self._alwaysConn:Disconnect()
			self._alwaysConn = nil
		end
	end)
	self.Janitor:Add(self._alwaysConn)
end

--==============================================================
-- Утилиты
--==============================================================
function Binds:GetAll()
	local out = {}
	for name, list in pairs(self.Registry) do
		for _, element in ipairs(list) do
			table.insert(out, {
				Key = name,
				Element = element,
				Name = element.Name,
				Mode = element.KeybindMode or element.Mode or "Toggle",
			})
		end
	end
	table.sort(out, function(a, b)
		return a.Name < b.Name
	end)
	return out
end

function Binds:IsHeld(key)
	local name = keyName(key)
	return name ~= nil and self.HeldKeys[name] ~= nil
end

function Binds:SetEnabled(enabled)
	self.Enabled = enabled
end

function Binds:ClearAll()
	for _, list in pairs(self.Registry) do
		for _, element in ipairs(list) do
			if element.SetKeybind then
				element:SetKeybind(nil)
			end
		end
	end
	self.Registry = {}
	self.AlwaysActive = {}
end

function Binds:Destroy()
	self.Janitor:Clean()
	self.Registry = {}
	self.AlwaysActive = {}
	self.Triggered:Destroy()
end

return Binds
end

__swagga_modules["Compat"] = function()

--[[
	Compat — определение окружения и возможностей движка.

	Библиотека должна одинаково работать:
	  • в экзекуторе (gethui, writefile, protect_gui)
	  • в обычной игре / Studio (StarterGui, LocalScript)
	  • на клиентах, где UIShadow ещё нет (fallback на 9-slice картинки)
]]

local Compat = {}

local function safeGet(fnName: string)
	local ok, fn = pcall(function()
		return (getfenv and getfenv(0) or _G)[fnName]
	end)
	if ok and type(fn) == "function" then
		return fn
	end
	local ok2, fn2 = pcall(function()
		return _G[fnName]
	end)
	if ok2 and type(fn2) == "function" then
		return fn2
	end
	return nil
end

--==============================================================
-- Сервисы (через pcall — часть может быть недоступна)
--==============================================================
local function service(name: string)
	local ok, s = pcall(function()
		return game:GetService(name)
	end)
	if ok then
		return s
	end
	return nil
end

Compat.Services = {
	Tween = service("TweenService"),
	Run = service("RunService"),
	Input = service("UserInputService"),
	Players = service("Players"),
	CoreGui = service("CoreGui"),
	Http = service("HttpService"),
	Gui = service("GuiService"),
	Content = service("ContentProvider"),
	Text = service("TextService"),
	Lighting = service("Lighting"),
}

Compat.LocalPlayer = Compat.Services.Players and Compat.Services.Players.LocalPlayer or nil

--==============================================================
-- Функции экзекутора
--==============================================================
Compat.gethui = safeGet("gethui") or safeGet("get_hidden_gui")
Compat.writefile = safeGet("writefile")
Compat.readfile = safeGet("readfile")
Compat.isfile = safeGet("isfile")
Compat.delfile = safeGet("delfile")
Compat.makefolder = safeGet("makefolder")
Compat.isfolder = safeGet("isfolder")
Compat.listfiles = safeGet("listfiles")
Compat.setclipboard = safeGet("setclipboard") or safeGet("toclipboard")
Compat.getcustomasset = safeGet("getcustomasset")
Compat.identifyexecutor = safeGet("identifyexecutor") or safeGet("getexecutorname")
Compat.protectgui = safeGet("protectgui") or safeGet("protect_gui")

do
	local ok, syn = pcall(function()
		return (getfenv and getfenv(0) or _G).syn
	end)
	if ok and type(syn) == "table" and type(syn.protect_gui) == "function" then
		Compat.protectgui = Compat.protectgui or syn.protect_gui
	end
end

Compat.IsExecutor = Compat.gethui ~= nil or Compat.writefile ~= nil
Compat.CanSaveFiles = type(Compat.writefile) == "function"
	and type(Compat.readfile) == "function"
	and type(Compat.isfile) == "function"

Compat.ExecutorName = "Unknown"
if Compat.identifyexecutor then
	local ok, name = pcall(Compat.identifyexecutor)
	if ok and type(name) == "string" then
		Compat.ExecutorName = name
	end
end

--==============================================================
-- Возможности движка
--==============================================================
local function canCreate(className: string): boolean
	local ok, inst = pcall(Instance.new, className)
	if ok and inst then
		pcall(function()
			inst:Destroy()
		end)
		return true
	end
	return false
end

-- UIShadow: полный релиз июнь 2026. На старых клиентах — нет.
Compat.HasUIShadow = canCreate("UIShadow")

-- Индивидуальные радиусы углов у UICorner (тот же релиз).
Compat.HasPerCornerRadius = false
do
	local ok, corner = pcall(Instance.new, "UICorner")
	if ok and corner then
		local ok2 = pcall(function()
			corner.TopLeftRadius = UDim.new(0, 4)
		end)
		Compat.HasPerCornerRadius = ok2
		pcall(function()
			corner:Destroy()
		end)
	end
end

Compat.HasUIDragDetector = canCreate("UIDragDetector")
Compat.HasUIFlexItem = canCreate("UIFlexItem")
Compat.HasCanvasGroup = canCreate("CanvasGroup")
Compat.HasUIStroke = canCreate("UIStroke")

--==============================================================
-- Куда парентить ScreenGui
--==============================================================
function Compat.GetGuiParent()
	-- 1. gethui() — самый скрытый вариант в экзекуторе
	if Compat.gethui then
		local ok, hui = pcall(Compat.gethui)
		if ok and hui then
			return hui
		end
	end
	-- 2. CoreGui напрямую
	if Compat.Services.CoreGui then
		local ok = pcall(function()
			return #Compat.Services.CoreGui:GetChildren()
		end)
		if ok then
			return Compat.Services.CoreGui
		end
	end
	-- 3. PlayerGui — обычная игра / Studio
	if Compat.LocalPlayer then
		local pg = Compat.LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if pg then
			return pg
		end
	end
	return nil
end

function Compat.Protect(gui: Instance)
	if Compat.protectgui then
		pcall(Compat.protectgui, gui)
	end
end

--==============================================================
-- Размер вьюпорта (для клампа окна)
--==============================================================
function Compat.GetViewportSize(): Vector2
	local cam = workspace and workspace.CurrentCamera
	if cam then
		return cam.ViewportSize
	end
	return Vector2.new(1920, 1080)
end

function Compat.GetGuiInset(): Vector2
	if Compat.Services.Gui then
		local ok, inset = pcall(function()
			return Compat.Services.Gui:GetGuiInset()
		end)
		if ok and inset then
			return inset
		end
	end
	return Vector2.new(0, 0)
end

--==============================================================
-- Отчёт (для дебага и Info-таба)
--==============================================================
function Compat.Report(): string
	return table.concat({
		("Executor: %s"):format(Compat.ExecutorName),
		("FileSystem: %s"):format(tostring(Compat.CanSaveFiles)),
		("UIShadow: %s"):format(tostring(Compat.HasUIShadow)),
		("PerCorner: %s"):format(tostring(Compat.HasPerCornerRadius)),
		("DragDetector: %s"):format(tostring(Compat.HasUIDragDetector)),
		("FlexItem: %s"):format(tostring(Compat.HasUIFlexItem)),
	}, " | ")
end

return Compat
end

__swagga_modules["ContextMenu"] = function()

--[[
	ContextMenu — меню по правой кнопке мыши.

	Один экземпляр на всю библиотеку: меню всплывает у курсора,
	наполняется пунктами от конкретного элемента и закрывается
	по клику мимо / Esc / выбору пункта.

	Здесь же режим записи бинда: затемнение экрана + карточка
	«Нажмите клавишу» с пульсацией. Это самый заметный способ
	показать, что интерфейс ждёт ввода.
]]

local Compat = __swagga_require("Compat")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Icons = __swagga_require("Icons")

local create = Util.create
local UIS = Compat.Services.Input

local ContextMenu = {}
ContextMenu.__index = ContextMenu

local ITEM_HEIGHT = 30
local MENU_WIDTH = 178
local MENU_PAD = 5

function ContextMenu.new(library)
	local self = setmetatable({}, ContextMenu)
	self.Library = library
	self.IsOpen = false
	self.Recording = false
	self.Target = nil
	self.Items = {}
	self.Janitor = Util.janitor()

	self:_build()
	return self
end

function ContextMenu:_build()
	local gui = self.Library.ScreenGui

	-- Прозрачный слой-ловушка кликов мимо меню
	local blocker = create("TextButton", {
		Name = "ContextBlocker",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 900,
		Parent = gui,
	})
	self.Blocker = blocker

	local menu = create("Frame", {
		Name = "ContextMenu",
		AnchorPoint = Vector2.new(0, 0),
		Size = UDim2.fromOffset(MENU_WIDTH, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 910,
		Parent = gui,
	}, {
		Util.corner(9),
		Util.listLayout({ Padding = UDim.new(0, 1) }),
		Util.padding(MENU_PAD),
	})
	Theme.bind(menu, "BackgroundColor3", "Element")
	self.Menu = menu

	self.MenuShadow = Util.shadow(menu, { Blur = 26, Transparency = 0.35, OffsetY = 8 })

	local stroke = Util.stroke(Theme.get("Stroke"), 1, 0.35)
	if stroke then
		stroke.Parent = menu
		Theme.bind(stroke, "Color", "Stroke")
	end

	local menuScale = create("UIScale", { Scale = 0.9, Parent = menu })
	self.MenuScale = menuScale

	blocker.Activated:Connect(function()
		self:Close()
	end)
	blocker.MouseButton2Click:Connect(function()
		self:Close()
	end)

	-- Esc закрывает меню
	self.Janitor:Add(UIS.InputBegan:Connect(function(input, processed)
		if processed or self.Recording then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape and self.IsOpen then
			self:Close()
		end
	end))
end

--==============================================================
-- Открытие
--==============================================================
--[[
	Открыть меню у курсора.
	ВАЖНО: состояние хранится в IsOpen, а не в Open — иначе булево
	поле затёрло бы этот метод и вызов :Open() падал бы с
	"attempt to call a boolean value".
]]
function ContextMenu:Open(element)
	if self.IsOpen then
		self:Close(true)
	end

	local items = element:GetContextItems()
	if #items == 0 then
		return
	end

	self.Target = element
	self.IsOpen = true
	self:_populate(items)

	-- Позиционируем у курсора, не вылезая за экран
	local mouse = UIS:GetMouseLocation()
	local viewport = Compat.GetViewportSize()
	local menuHeight = #items * ITEM_HEIGHT + (#items - 1) + MENU_PAD * 2

	local x = mouse.X
	local y = mouse.Y
	if x + MENU_WIDTH > viewport.X - 8 then
		x = x - MENU_WIDTH
	end
	if y + menuHeight > viewport.Y - 8 then
		y = y - menuHeight
	end
	x = math.max(8, x)
	y = math.max(8, y)

	self.Menu.Position = UDim2.fromOffset(x, y)
	self.Menu.Size = UDim2.fromOffset(MENU_WIDTH, 0)
	self.Menu.BackgroundTransparency = 1
	self.Menu.Visible = true
	self.Blocker.Visible = true
	self.MenuScale.Scale = 0.92

	Motion.tween(self.Menu, {
		Size = UDim2.fromOffset(MENU_WIDTH, menuHeight),
		BackgroundTransparency = 0,
	}, {
		Duration = Motion.Duration.Slow,
		Easing = Motion.Easing.Decelerate,
	})
	Motion.tween(self.MenuScale, { Scale = 1 }, {
		Duration = Motion.Duration.Slow,
		Easing = Motion.Easing.Overshoot,
	})

	-- Пункты появляются каскадом
	Motion.stagger(self.Items, 0.025, function(item, index, delayTime)
		item.Label.TextTransparency = 1
		if item.Icon then
			item.Icon.ImageTransparency = 1
		end
		Motion.tween(item.Label, { TextTransparency = 0.1 }, {
			Duration = Motion.Duration.Normal,
			Delay = delayTime,
		})
		if item.Icon then
			Motion.tween(item.Icon, { ImageTransparency = 0.35 }, {
				Duration = Motion.Duration.Normal,
				Delay = delayTime,
			})
		end
	end)
end

function ContextMenu:_populate(items)
	for _, item in ipairs(self.Items) do
		item.Frame:Destroy()
	end
	self.Items = {}

	for index, data in ipairs(items) do
		local btn = create("TextButton", {
			Name = "Item" .. index,
			Size = UDim2.new(1, 0, 0, ITEM_HEIGHT),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = index,
			ZIndex = 911,
			Parent = self.Menu,
		}, {
			Util.corner(6),
		})
		Theme.bind(btn, "BackgroundColor3", data.Danger and "Danger" or "ElementHover")

		local icon
		if data.Icon then
			icon = create("ImageLabel", {
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 8, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
				ScaleType = Enum.ScaleType.Fit,
				ImageTransparency = 0.35,
				ZIndex = 912,
				Parent = btn,
			})
			if not Icons.apply(icon, data.Icon) then
				icon:Destroy()
				icon = nil
			else
				Theme.bind(icon, "ImageColor3", data.Danger and "Danger" or "TextSecondary")
			end
		end

		local label = create("TextLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, icon and 30 or 10, 0.5, 0),
			Size = UDim2.new(1, icon and -38 or -18, 1, 0),
			Font = Enum.Font.Gotham,
			Text = data.Text,
			TextSize = 12,
			TextTransparency = 0.1,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 912,
			Parent = btn,
		})
		Theme.bind(label, "TextColor3", data.Danger and "Danger" or "TextPrimary")

		btn.MouseEnter:Connect(function()
			Motion.fast(btn, { BackgroundTransparency = data.Danger and 0.85 or 0.88 })
		end)
		btn.MouseLeave:Connect(function()
			Motion.fast(btn, { BackgroundTransparency = 1 })
		end)
		btn.Activated:Connect(function()
			local target = self.Target
			local action = data.Action
			self:Close()
			if target and action then
				target:HandleContextAction(action)
			end
			if data.Callback then
				task.spawn(data.Callback, target)
			end
		end)

		table.insert(self.Items, { Frame = btn, Label = label, Icon = icon })
	end
end

function ContextMenu:Close(immediate)
	if not self.IsOpen then
		return
	end
	self.IsOpen = false
	self.Blocker.Visible = false

	if immediate then
		self.Menu.Visible = false
		self.Target = nil
		return
	end

	Motion.tween(self.Menu, {
		Size = UDim2.fromOffset(MENU_WIDTH, 0),
		BackgroundTransparency = 1,
	}, {
		Duration = Motion.Duration.Fast,
		Easing = Motion.Easing.Accelerate,
		OnComplete = function()
			if not self.IsOpen then
				self.Menu.Visible = false
			end
		end,
	})
	Motion.tween(self.MenuScale, { Scale = 0.94 }, { Duration = Motion.Duration.Fast })

	for _, item in ipairs(self.Items) do
		Motion.tween(item.Label, { TextTransparency = 1 }, { Duration = Motion.Duration.Micro })
		if item.Icon then
			Motion.tween(item.Icon, { ImageTransparency = 1 }, { Duration = Motion.Duration.Micro })
		end
	end

	self.Target = nil
end

--==============================================================
-- Запись бинда
--==============================================================
function ContextMenu:StartRecording(element)
	if self.Recording then
		return
	end
	self.Recording = true

	local gui = self.Library.ScreenGui

	-- Затемнение
	local overlay = create("TextButton", {
		Name = "BindOverlay",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		AutoButtonColor = false,
		ZIndex = 950,
		Parent = gui,
	})

	local card = create("Frame", {
		Name = "BindCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(280, 116),
		BackgroundTransparency = 1,
		ZIndex = 951,
		Parent = gui,
	}, {
		Util.corner(14),
	})
	Theme.bind(card, "BackgroundColor3", "Element")

	Util.shadow(card, { Blur = 40, Transparency = 0.3, OffsetY = 12 })

	local cardStroke = Util.stroke(Theme.get("Accent"), 1.5, 0.4)
	if cardStroke then
		cardStroke.Parent = card
	end

	local cardScale = create("UIScale", { Scale = 0.88, Parent = card })

	local icon = create("ImageLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 18),
		Size = UDim2.fromOffset(26, 26),
		ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = 1,
		ZIndex = 952,
		Parent = card,
	})
	Icons.apply(icon, "keyboard")
	Theme.bind(icon, "ImageColor3", "Accent")

	local title = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 52),
		Size = UDim2.new(1, -24, 0, 18),
		Font = Enum.Font.GothamBold,
		Text = "Нажмите клавишу",
		TextSize = 14,
		TextTransparency = 1,
		ZIndex = 952,
		Parent = card,
	})
	Theme.bind(title, "TextColor3", "TextPrimary")

	local hint = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.new(1, -24, 0, 28),
		Font = Enum.Font.Gotham,
		Text = ("для «%s»\nEsc — отмена · Backspace — убрать"):format(element.Name),
		TextSize = 10,
		TextTransparency = 1,
		ZIndex = 952,
		Parent = card,
	})
	Theme.bind(hint, "TextColor3", "TextMuted")

	-- Появление
	Motion.tween(overlay, { BackgroundTransparency = 0.55 }, { Duration = Motion.Duration.Normal })
	Motion.tween(card, { BackgroundTransparency = 0 }, { Duration = Motion.Duration.Normal })
	Motion.tween(cardScale, { Scale = 1 }, {
		Duration = Motion.Duration.Slower,
		Easing = Motion.Easing.Overshoot,
	})
	Motion.tween(icon, { ImageTransparency = 0 }, { Duration = Motion.Duration.Normal, Delay = 0.05 })
	Motion.tween(title, { TextTransparency = 0 }, { Duration = Motion.Duration.Normal, Delay = 0.08 })
	Motion.tween(hint, { TextTransparency = 0.35 }, { Duration = Motion.Duration.Normal, Delay = 0.11 })

	-- Пульсация обводки
	local pulse
	if cardStroke then
		pulse = Motion.pulse(cardStroke, "Transparency", 0.15, 0.8, 1.1)
	end

	local function finish(key, cleared)
		if pulse then
			pulse:Stop()
		end
		self.Recording = false

		Motion.tween(overlay, { BackgroundTransparency = 1 }, {
			Duration = Motion.Duration.Fast,
			OnComplete = function()
				overlay:Destroy()
			end,
		})
		Motion.tween(card, { BackgroundTransparency = 1 }, { Duration = Motion.Duration.Fast })
		Motion.tween(cardScale, { Scale = 0.9 }, {
			Duration = Motion.Duration.Fast,
			OnComplete = function()
				card:Destroy()
			end,
		})
		for _, obj in ipairs({ title, hint }) do
			Motion.tween(obj, { TextTransparency = 1 }, { Duration = Motion.Duration.Micro })
		end
		Motion.tween(icon, { ImageTransparency = 1 }, { Duration = Motion.Duration.Micro })

		if cleared then
			element:SetKeybind(nil)
			if self.Library.Notify then
				self.Library:Notify({
					Title = element.Name,
					Content = "Бинд убран",
					Icon = "x",
					Duration = 2,
				})
			end
		elseif key then
			element:SetKeybind(key)
			if self.Library.Notify then
				local name = key.Name or tostring(key)
				self.Library:Notify({
					Title = element.Name,
					Content = "Назначено: " .. name,
					Icon = "keyboard",
					Duration = 2,
				})
			end
		end
	end

	local connection
	connection = UIS.InputBegan:Connect(function(input, processed)
		local key
		if input.UserInputType == Enum.UserInputType.Keyboard then
			key = input.KeyCode
		elseif input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.MouseButton3 then
			key = input.UserInputType
		else
			return
		end

		connection:Disconnect()

		if key == Enum.KeyCode.Escape then
			finish(nil, false)
		elseif key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
			finish(nil, true)
		else
			finish(key, false)
		end
	end)
end

function ContextMenu:Destroy()
	self.Janitor:Clean()
	if self.Menu then
		self.Menu:Destroy()
	end
	if self.Blocker then
		self.Blocker:Destroy()
	end
end

return ContextMenu
end

__swagga_modules["Element"] = function()

--[[
	Element — базовый класс всех элементов.

	Даёт каждому элементу:
	  • карточку с фоном, скруглением, ховером
	  • заголовок, описание, иконку
	  • ПКМ-меню (бинды, копирование, сброс)
	  • единый handle-API: :Set() / :Get() / :OnChanged() / :Destroy()
	  • регистрацию во флагах для автосохранения

	Наследники переопределяют _buildControl() — правую часть карточки.
]]

local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Icons = __swagga_require("Icons")
local Signal = __swagga_require("Signal")

local create = Util.create

local Element = {}
Element.__index = Element

Element.DEFAULT_HEIGHT = 38
Element.PADDING_X = 12

--==============================================================
-- Конструктор
--==============================================================
function Element.new(tab, config, kind)
	config = config or {}
	local self = setmetatable({}, Element)

	self.Tab = tab
	self.Window = tab.Window
	self.Library = tab.Library
	self.Kind = kind or "element"
	self.Name = config.Name or config.Text or "Элемент"
	self.Description = config.Description
	self.Icon = config.Icon
	self.Flag = config.Flag or (Util.slug(self.Name) .. "_" .. self.Kind)
	self.ForgetState = config.ForgetState or false
	self.Callback = config.Callback
	self.Destroyed = false
	self.Enabled = config.Enabled ~= false
	self.Janitor = Util.janitor()

	self.Changed = Signal.new("Element.Changed")

	-- Контекстное меню: какие пункты доступны
	self.SupportsKeybind = config.SupportsKeybind
	if self.SupportsKeybind == nil then
		self.SupportsKeybind = (kind == "toggle" or kind == "button")
	end

	self:_buildFrame(config)
	return self
end

--==============================================================
-- Карточка
--==============================================================
function Element:_buildFrame(config)
	local height = config.Height or Element.DEFAULT_HEIGHT
	if self.Description then
		height = height + 14
	end
	self.BaseHeight = height
	self.HeaderY = Element.DEFAULT_HEIGHT / 2

	local frame = create("Frame", {
		Name = self.Name,
		Size = UDim2.new(1, 0, 0, height),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = self.Tab.Page,
	}, {
		Util.corner(9),
	})
	Theme.bind(frame, "BackgroundColor3", "Element")
	self.Frame = frame
	self._baseTransparency = 0

	-- Обводка появляется на ховере — даёт «отклик» без смены фона
	local stroke = Util.stroke(Theme.get("Stroke"), 1, 1)
	if stroke then
		stroke.Parent = frame
		Theme.bind(stroke, "Color", "Stroke")
		self.Stroke = stroke
	end

	--[[
		ВАЖНО: всё содержимое шапки привязано к ВЕРХУ карточки
		(Scale = 0), а не к центру (0.5).

		Иначе при раскрытии дропдауна или палитры карточка растёт,
		её центр уезжает вниз — и заголовок вместе с иконкой
		«съезжает» вслед за анимацией. Шапка должна стоять на месте.

		headerY — вертикальный центр ШАПКИ, не карточки.
	]]
	local headerY = Element.DEFAULT_HEIGHT / 2

	--=== Иконка (опционально) ===
	local textLeft = Element.PADDING_X
	if self.Icon then
		local icon = create("ImageLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, Element.PADDING_X, 0, headerY),
			Size = UDim2.fromOffset(16, 16),
			ScaleType = Enum.ScaleType.Fit,
			ImageTransparency = 0.3,
			ZIndex = 4,
			Parent = frame,
		})
		if Icons.apply(icon, self.Icon) then
			Theme.bind(icon, "ImageColor3", "TextSecondary")
			self.IconLabel = icon
			textLeft = Element.PADDING_X + 24
		else
			icon:Destroy()
		end
	end

	--=== Заголовок ===
	local titleY = self.Description and (headerY - 8) or headerY
	local title = create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, textLeft, 0, titleY),
		Size = UDim2.new(0.55, -textLeft, 0, 16),
		Font = Enum.Font.GothamMedium,
		Text = self.Name,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 4,
		Parent = frame,
	})
	Theme.bind(title, "TextColor3", "TextPrimary")
	self.Title = title

	--=== Описание ===
	if self.Description then
		local desc = create("TextLabel", {
			Name = "Description",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, textLeft, 0, headerY + 9),
			Size = UDim2.new(0.6, -textLeft, 0, 13),
			Font = Enum.Font.Gotham,
			Text = self.Description,
			TextSize = 11,
			TextTransparency = 0.5,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 4,
			Parent = frame,
		})
		Theme.bind(desc, "TextColor3", "TextSecondary")
		self.DescLabel = desc
	end

	--=== Индикатор бинда ===
	-- Появляется, когда на элемент назначена клавиша
	local bindTag = create("TextLabel", {
		Name = "BindTag",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X, 0, headerY),
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextSize = 10,
		TextTransparency = 0.4,
		Visible = false,
		ZIndex = 5,
		Parent = frame,
	})
	Theme.bind(bindTag, "TextColor3", "TextMuted")
	self.BindTag = bindTag

	--=== Зона взаимодействия ===
	-- Отдельная кнопка поверх карточки: ловит ЛКМ и ПКМ.
	local hit = create("TextButton", {
		Name = "HitArea",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
		Parent = frame,
	})
	self.HitArea = hit

	self:_setupHover()
	self:_setupContextMenu()
end

--==============================================================
-- Ховер
--==============================================================
function Element:_setupHover()
	local frame = self.Frame
	local hit = self.HitArea

	self.Janitor:Add(hit.MouseEnter:Connect(function()
		if not self.Enabled then
			return
		end
		self.Hovered = true
		Motion.fast(frame, { BackgroundColor3 = Theme.get("ElementHover") })
		if self.Stroke then
			Motion.fast(self.Stroke, { Transparency = 0.55 })
		end
		if self.IconLabel then
			Motion.fast(self.IconLabel, { ImageTransparency = 0 })
		end
		if self.OnHover then
			self:OnHover(true)
		end
	end))

	self.Janitor:Add(hit.MouseLeave:Connect(function()
		self.Hovered = false
		Motion.fast(frame, { BackgroundColor3 = Theme.get("Element") })
		if self.Stroke then
			Motion.fast(self.Stroke, { Transparency = 1 })
		end
		if self.IconLabel then
			Motion.fast(self.IconLabel, { ImageTransparency = 0.3 })
		end
		if self.OnHover then
			self:OnHover(false)
		end
	end))
end

--==============================================================
-- Контекстное меню (ПКМ)
--==============================================================
function Element:_setupContextMenu()
	self.Janitor:Add(self.HitArea.MouseButton2Click:Connect(function()
		if not self.Enabled then
			return
		end
		if self.Library and self.Library.ContextMenu then
			self.Library.ContextMenu:Open(self)
		end
	end))
end

--[[
	Пункты меню. Наследники дополняют список,
	вызывая Element.GetContextItems(self) и добавляя своё.
]]
function Element:GetContextItems()
	local items = {}

	if self.SupportsKeybind then
		if self.Keybind then
			items[#items + 1] = {
				Text = "Изменить бинд",
				Icon = "keyboard",
				Action = "rebind",
			}
			items[#items + 1] = {
				Text = "Режим: " .. (self.KeybindMode or "Toggle"),
				Icon = "refresh-cw",
				Action = "bindmode",
			}
			items[#items + 1] = {
				Text = "Убрать бинд",
				Icon = "x",
				Action = "unbind",
				Danger = true,
			}
		else
			items[#items + 1] = {
				Text = "Назначить бинд",
				Icon = "keyboard",
				Action = "rebind",
			}
		end
	end

	if self.Kind ~= "button" and self.Kind ~= "label" then
		items[#items + 1] = {
			Text = "Копировать значение",
			Icon = "copy",
			Action = "copy",
		}
		if self.Default ~= nil then
			items[#items + 1] = {
				Text = "Сбросить",
				Icon = "rotate-cw",
				Action = "reset",
			}
		end
	end

	return items
end

function Element:HandleContextAction(action)
	if action == "rebind" then
		if self.Library and self.Library.ContextMenu then
			self.Library.ContextMenu:StartRecording(self)
		end
	elseif action == "unbind" then
		self:SetKeybind(nil)
	elseif action == "bindmode" then
		local modes = { "Toggle", "Hold", "Always" }
		local current = Util.indexOf(modes, self.KeybindMode or "Toggle") or 1
		self:SetKeybindMode(modes[(current % #modes) + 1])
	elseif action == "copy" then
		local value = self:Get()
		local text
		if typeof(value) == "Color3" then
			text = "#" .. Util.toHex(value)
		elseif type(value) == "table" then
			text = table.concat(value, ", ")
		else
			text = tostring(value)
		end
		local Compat = __swagga_require("Compat")
		if Compat.setclipboard then
			pcall(Compat.setclipboard, text)
		end
		if self.Library and self.Library.Notify then
			self.Library:Notify({
				Title = "Скопировано",
				Content = text,
				Icon = "copy",
				Duration = 2,
			})
		end
	elseif action == "reset" then
		if self.Default ~= nil then
			self:Set(self.Default)
		end
	end
end

--==============================================================
-- Бинды
--==============================================================
function Element:SetKeybind(keyCode, mode)
	local previous = self.Keybind
	self.Keybind = keyCode
	self.KeybindMode = mode or self.KeybindMode or "Toggle"

	if self.Library and self.Library.Binds then
		self.Library.Binds:Update(self, previous)
	end

	self:_updateBindTag()
	self:_save()
end

function Element:SetKeybindMode(mode)
	self.KeybindMode = mode
	if self.Library and self.Library.Binds then
		self.Library.Binds:Update(self, self.Keybind)
	end
	self:_updateBindTag()
	self:_save()

	if self.Library and self.Library.Notify then
		self.Library:Notify({
			Title = self.Name,
			Content = "Режим бинда: " .. mode,
			Icon = "keyboard",
			Duration = 2,
		})
	end
end

function Element:_updateBindTag()
	local tag = self.BindTag
	if not tag then
		return
	end

	if not self.Keybind then
		Motion.tween(tag, { TextTransparency = 1 }, {
			Duration = Motion.Duration.Fast,
			OnComplete = function()
				if not self.Keybind then
					tag.Visible = false
				end
			end,
		})
		return
	end

	local name = self.Keybind.Name or tostring(self.Keybind)
	-- Компактные подписи для мыши
	local pretty = ({
		MouseButton1 = "ЛКМ",
		MouseButton2 = "ПКМ",
		MouseButton3 = "СКМ",
	})[name] or name

	local modeMark = ""
	if self.KeybindMode == "Hold" then
		modeMark = " ⏻"
	elseif self.KeybindMode == "Always" then
		modeMark = " ∞"
	end

	tag.Text = "[" .. pretty .. modeMark .. "]"
	tag.Visible = true
	tag.TextTransparency = 1
	Motion.tween(tag, { TextTransparency = 0.35 }, { Duration = Motion.Duration.Normal })

	-- Короткая вспышка акцентом, чтобы заметить назначение
	tag.TextColor3 = Theme.get("Accent")
	Motion.tween(tag, { TextColor3 = Theme.get("TextMuted") }, {
		Duration = Motion.Duration.Slower,
		Delay = 0.25,
	})
end

--[[
	Вызывается системой биндов при срабатывании клавиши.
	Наследники переопределяют, если реакция отличается.
]]
function Element:OnKeybindTriggered(state)
	if self.Kind == "toggle" then
		if self.KeybindMode == "Hold" then
			self:Set(state)
		elseif state then
			self:Set(not self:Get())
		end
	elseif self.Kind == "button" and state then
		if self.Trigger then
			self:Trigger()
		end
	end
end

--==============================================================
-- Раскрывающиеся панели (дропдаун, палитра)
--==============================================================
--[[
	Общий механизм: перед раскрытием любой панели закрываем все
	остальные раскрытые во ВСЁМ окне.

	Раньше каждый элемент фильтровал по своему Kind и только внутри
	своей вкладки, поэтому дропдаун не закрывал палитру, и обе
	панели висели раскрытыми одновременно.
]]
function Element:CloseOtherPanels()
	local window = self.Window
	if not window then
		return
	end
	for _, tab in ipairs(window.Tabs or {}) do
		for _, element in ipairs(tab.Elements or {}) do
			if element ~= self
				and not element.Destroyed
				and element.Open == true
				and type(element.Toggle) == "function" then
				element:Toggle(false)
			end
		end
	end
end

--==============================================================
-- Значение / сохранение
--==============================================================
function Element:Get()
	return self.Value
end

function Element:Set(value, skipCallback)
	self.Value = value
	if not skipCallback and self.Callback then
		task.spawn(self.Callback, value)
	end
	self.Changed:Fire(value)
	self:_save()
	return self
end

function Element:OnChanged(fn)
	return self.Changed:Connect(fn)
end

function Element:_save()
	if self.ForgetState then
		return
	end
	if self.Library and self.Library.Save then
		self.Library.Save:Mark(self)
	end
end

--[[
	Сериализация для конфигов.
	Enum и Color3 не переживают JSON, поэтому конвертируем.
]]
--[[
	Сериализация для конфигов.

	Булево false и JSON — известная ловушка: если значение
	потеряется при кодировании, при загрузке оно станет nil и
	будет молча пропущено, а переключатель «залипнет» включённым.
	Поэтому booleans записываем явным полем и отдельным типом.
]]
function Element:Serialize()
	local data = { value = self.Value }

	if type(self.Value) == "boolean" then
		-- Дублируем в строку: переживёт любой JSON-кодировщик
		data.value = self.Value
		data.bool = self.Value and 1 or 0
		data.type = "boolean"
	elseif typeof(self.Value) == "Color3" then
		data.value = Util.toHex(self.Value)
		data.type = "Color3"
	elseif typeof(self.Value) == "EnumItem" then
		data.value = self.Value.Name
		data.type = "EnumItem"
	elseif type(self.Value) == "table" then
		data.value = Util.deepCopy(self.Value)
		data.type = "table"
	end

	if self.Alpha ~= nil then
		data.alpha = self.Alpha
	end
	if self.Keybind then
		data.keybind = self.Keybind.Name
		data.keybindMode = self.KeybindMode
	end
	return data
end

function Element:Deserialize(data)
	if type(data) ~= "table" then
		return
	end

	local value = data.value

	-- Булево восстанавливаем из числового дубля, если основное поле потерялось
	if data.type == "boolean" or data.bool ~= nil then
		if type(value) ~= "boolean" then
			value = (data.bool == 1) or (data.bool == true)
		end
		self:Set(value, true)
		if data.keybind then
			local key = Enum.KeyCode[data.keybind] or Enum.UserInputType[data.keybind]
			if key then
				self:SetKeybind(key, data.keybindMode)
			end
		end
		return
	end

	if data.type == "Color3" and type(value) == "string" then
		value = Util.hex(value)
	elseif data.type == "EnumItem" and type(value) == "string" then
		value = Enum.KeyCode[value] or Enum.UserInputType[value]
	end

	if value ~= nil then
		if data.alpha ~= nil and self.SetWithAlpha then
			self:SetWithAlpha(value, data.alpha, true)
		else
			self:Set(value, true)
		end
	end

	if data.keybind then
		local key = Enum.KeyCode[data.keybind] or Enum.UserInputType[data.keybind]
		if key then
			self:SetKeybind(key, data.keybindMode)
		end
	end
end

--==============================================================
-- Состояние
--==============================================================
function Element:SetEnabled(enabled)
	self.Enabled = enabled
	local transparency = enabled and 0 or 0.5
	Motion.tween(self.Title, { TextTransparency = transparency }, {
		Duration = Motion.Duration.Normal,
	})
	if self.DescLabel then
		Motion.tween(self.DescLabel, { TextTransparency = enabled and 0.5 or 0.75 }, {
			Duration = Motion.Duration.Normal,
		})
	end
	if self.OnEnabledChanged then
		self:OnEnabledChanged(enabled)
	end
	return self
end

function Element:SetVisible(visible)
	self.Frame.Visible = visible
	return self
end

function Element:SetName(text)
	self.Name = text
	self.Title.Text = text
	return self
end

function Element:SetDescription(text)
	self.Description = text
	if self.DescLabel then
		self.DescLabel.Text = text
	end
	return self
end

--[[
	Изменение высоты карточки — база push-анимации.
	Дропдаун и палитра вызывают это при раскрытии: UIListLayout
	сам сдвигает элементы ниже, поэтому «толкание» выглядит цельно.
]]
function Element:SetHeight(height, animate)
	if animate == false then
		self.Frame.Size = UDim2.new(1, 0, 0, height)
		return
	end
	Motion.tween(self.Frame, { Size = UDim2.new(1, 0, 0, height) }, {
		Duration = Motion.Duration.Slow,
		Easing = Motion.Easing.Standard,
	})
end

--==============================================================
-- Порядок
--==============================================================
function Element:MoveTo(index)
	self.Frame.LayoutOrder = index
	self.LayoutOrder = index
	return self
end

function Element:MoveToTop()
	return self:MoveTo(-999)
end

function Element:MoveToBottom()
	return self:MoveTo(999)
end

function Element:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true

	if self.Keybind and self.Library and self.Library.Binds then
		self.Library.Binds:Remove(self)
	end
	if self.Library and self.Library._unregisterElement then
		self.Library:_unregisterElement(self)
	end

	self.Janitor:Clean()
	if self.Frame then
		self.Frame:Destroy()
	end
	self.Changed:Destroy()
end

return Element
end

