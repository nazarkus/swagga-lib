--==============================================================
-- Тени и свечение
--==============================================================
-- ID из оригинального swagga lib — 9-slice glow для fallback.
Util.GLOW_ASSET = "rbxassetid://104224036770059"
Util.GLOW_SLICE = Rect.new(70, 70, 442, 442)

--[[
	shadow() — мягкая тень под элементом.
	На новых клиентах: нативный UIShadow (быстрее 9-slice и корректно
	повторяет скругление углов). На старых: ImageLabel с 9-slice.

	Возвращает объект с методами :SetColor(), :SetTransparency(), :Destroy(),
	чтобы вызывающий код не думал, какая реализация под капотом.
]]
function Util.shadow(parent: Instance, opts: {[string]: any}?)
	opts = opts or {}
	local blur = opts.Blur or 24
	local color = opts.Color or Color3.fromRGB(0, 0, 0)
	local transparency = opts.Transparency or 0.45
	local offsetY = opts.OffsetY or 6
	local offsetX = opts.OffsetX or 0
	local spread = opts.Spread or 0

	local handle = {}

	if Compat.HasUIShadow then
		local sh = Instance.new("UIShadow")
		pcall(function()
			sh.BlurRadius = UDim.new(0, blur)
			sh.Color = color
			sh.Transparency = transparency
			sh.Offset = UDim2.fromOffset(offsetX, offsetY)
			sh.Spread = UDim2.fromOffset(spread, spread)
			sh.ZIndex = opts.ZIndex or -1
		end)
		sh.Parent = parent
		handle.Instance = sh
		handle.Native = true

		function handle:SetColor(c)
			pcall(function()
				sh.Color = c
			end)
		end
		function handle:SetTransparency(t)
			pcall(function()
				sh.Transparency = t
			end)
		end
		function handle:GetTweenTarget()
			return sh, "Transparency"
		end
		function handle:Destroy()
			if sh then
				sh:Destroy()
			end
		end
		return handle
	end

	-- Fallback: 9-slice картинка позади элемента
	local img = create("ImageLabel", {
		Name = "ShadowFallback",
		BackgroundTransparency = 1,
		Image = Util.GLOW_ASSET,
		ImageColor3 = color,
		ImageTransparency = transparency,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Util.GLOW_SLICE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, offsetX, 0.5, offsetY),
		Size = UDim2.new(1, blur * 2 + spread * 2, 1, blur * 2 + spread * 2),
		ZIndex = (opts.ZIndex or -1) - 2,
		Parent = parent,
	})
	handle.Instance = img
	handle.Native = false

	function handle:SetColor(c)
		img.ImageColor3 = c
	end
	function handle:SetTransparency(t)
		img.ImageTransparency = t
	end
	function handle:GetTweenTarget()
		return img, "ImageTransparency"
	end
	function handle:Destroy()
		if img then
			img:Destroy()
		end
	end
	return handle
end

--[[
	glow() — цветное свечение (тень акцентным цветом без смещения).
	Используется для активного таба, включённого тоггла, фокуса.
]]
