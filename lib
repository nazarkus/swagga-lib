		Motion.fast(item, { BackgroundTransparency = 1 })
		Motion.fast(img, { ImageTransparency = 0.35 })
		Motion.fast(label, { TextTransparency = 0.15 })
	end)
	item.Activated:Connect(callback)

	table.insert(self.MoreItems, item)
	return item
end

function Window:ToggleMorePanel(force)
	local open = force
	if open == nil then
		open = not self.MorePanelOpen
	end
	if open == self.MorePanelOpen then
		return
	end
	self.MorePanelOpen = open

	local itemCount = #self.MoreItems
	local targetHeight = itemCount * 30 + (itemCount - 1) * 2 + 12

	if open then
		self.MorePanel.Visible = true
		self.MorePanel.Size = UDim2.fromOffset(180, 0)
		self.MorePanel.BackgroundTransparency = 1

		Motion.tween(self.MorePanel, {
			Size = UDim2.fromOffset(180, targetHeight),
			BackgroundTransparency = 0,
		}, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Decelerate,
		})

		-- Пункты появляются стаггером
		Motion.stagger(self.MoreItems, 0.03, function(item, index, delayTime)
			item.BackgroundTransparency = 1
			for _, child in ipairs(item:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextTransparency = 1
					Motion.tween(child, { TextTransparency = 0.15 }, {
						Duration = Motion.Duration.Normal,
						Delay = delayTime,
					})
				elseif child:IsA("ImageLabel") then
					child.ImageTransparency = 1
					Motion.tween(child, { ImageTransparency = 0.35 }, {
						Duration = Motion.Duration.Normal,
						Delay = delayTime,
					})
				end
			end
		end)
	else
		Motion.tween(self.MorePanel, {
			Size = UDim2.fromOffset(180, 0),
			BackgroundTransparency = 1,
		}, {
			Duration = Motion.Duration.Normal,
			Easing = Motion.Easing.Accelerate,
			OnComplete = function()
				if not self.MorePanelOpen then
					self.MorePanel.Visible = false
				end
			end,
		})
	end
end

