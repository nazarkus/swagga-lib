function Window:_buildTopbar(config)
	local topbar = create("Frame", {
		Name = "Topbar",
		Size = UDim2.new(1, 0, 0, TOPBAR_HEIGHT),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = self.Root,
	}, {
		Util.cornerEach(CORNER, CORNER, 0, 0),
	})
	Theme.bind(topbar, "BackgroundColor3", "Surface")
	self.Topbar = topbar

	-- Иконка
	local logo = create("ImageLabel", {
		Name = "Logo",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(22, 22),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 6,
		Parent = topbar,
	})
	if config.Icon then
		Icons.apply(logo, config.Icon)
	else
		-- Логотип оригинального swagga lib
		logo.Image = "rbxassetid://91979051352733"
	end
	Theme.bind(logo, "ImageColor3", "TextPrimary")

	-- Название
	local title = create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 48, 0.5, self.Subtitle ~= "" and -8 or 0),
		Size = UDim2.new(0.5, 0, 0, 20),
		Font = Enum.Font.GothamBold,
		Text = self.Name,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = topbar,
	})
	Theme.bind(title, "TextColor3", "TextPrimary")
	self.TitleLabel = title

	if self.Subtitle ~= "" then
		local sub = create("TextLabel", {
			Name = "Subtitle",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 48, 0.5, 9),
			Size = UDim2.new(0.5, 0, 0, 14),
			Font = Enum.Font.Gotham,
			Text = self.Subtitle,
			TextSize = 11,
			TextTransparency = 0.35,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 6,
			Parent = topbar,
		})
		Theme.bind(sub, "TextColor3", "TextSecondary")
		self.SubtitleLabel = sub
	end

	-- Градиентная линия под топбаром (из оригинала)
	local line = create("Frame", {
		Name = "GlowLine",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = topbar,
	})
	--[[
		Затухание к краям обязательно: без него линия обрывается
		о стенки окна резким торцом. С ним она мягко растворяется.
	]]
	local lineGradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.get("Divider")),
			ColorSequenceKeypoint.new(0.35, Theme.get("GlowA")),
			ColorSequenceKeypoint.new(0.65, Theme.get("GlowB")),
			ColorSequenceKeypoint.new(1, Theme.get("Divider")),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.12, 0.25),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(0.88, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = line,
	})
	line.BackgroundColor3 = Color3.new(1, 1, 1)
	Theme.bindCustom(line, function(theme)
		lineGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.Divider),
			ColorSequenceKeypoint.new(0.35, theme.GlowA),
			ColorSequenceKeypoint.new(0.65, theme.GlowB),
			ColorSequenceKeypoint.new(1, theme.Divider),
		})
	end)

	-- Кнопки справа
	local buttons = create("Frame", {
		Name = "Buttons",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(110, 28),
		ZIndex = 6,
		Parent = topbar,
	}, {
		Util.listLayout({
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 4),
		}),
	})

	self.TopButtons = {}
	self:_addTopButton(buttons, "more", "more-horizontal", 1, function()
		self:ToggleMorePanel()
	end)
	self:_addTopButton(buttons, "minimize", "minus", 2, function()
		self:Minimize()
	end)
	self:_addTopButton(buttons, "close", "x", 3, function()
		self:Close()
	end)
end

function Window:_addTopButton(parent, name, icon, order, callback)
	local btn = create("ImageButton", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(28, 28),
		LayoutOrder = order,
		AutoButtonColor = false,
		Image = "",
		ZIndex = 6,
		Parent = parent,
	}, {
		Util.corner(8),
	})
	Theme.bind(btn, "BackgroundColor3", "ElementHover")

	local img = create("ImageLabel", {
		Name = "Icon",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = 0.3,
		ZIndex = 7,
		Parent = btn,
	}, {
		create("UIScale", {}),
	})
	Icons.apply(img, icon)
	Theme.bind(img, "ImageColor3", name == "close" and "TextPrimary" or "TextPrimary")

	local scale = img:FindFirstChildOfClass("UIScale")

	btn.MouseEnter:Connect(function()
		Motion.fast(btn, { BackgroundTransparency = 0.85 })
		Motion.fast(img, { ImageTransparency = 0 })
		Motion.tween(scale, { Scale = 1.12 }, {
			Duration = Motion.Duration.Normal,
			Easing = Motion.Easing.Overshoot,
		})
		if name == "close" then
			Motion.fast(img, { ImageColor3 = Theme.get("Danger") })
		end
	end)

	btn.MouseLeave:Connect(function()
		Motion.fast(btn, { BackgroundTransparency = 1 })
		Motion.fast(img, { ImageTransparency = 0.3 })
		Motion.tween(scale, { Scale = 1 }, { Duration = Motion.Duration.Normal })
		if name == "close" then
			Motion.fast(img, { ImageColor3 = Theme.get("TextPrimary") })
		end
	end)

	btn.MouseButton1Down:Connect(function()
		Motion.tween(scale, { Scale = 0.88 }, { Duration = Motion.Duration.Micro })
	end)

	btn.MouseButton1Up:Connect(function()
		Motion.tween(scale, { Scale = 1.12 }, {
			Duration = Motion.Duration.Normal,
			Easing = Motion.Easing.Overshoot,
		})
	end)

	btn.Activated:Connect(callback)
	self.TopButtons[name] = btn
	return btn
end

