--==============================================================
-- Открытие / закрытие
--==============================================================
function SettingsOverlay:Open()
	if self.IsOpen then
		return
	end

	-- Соседние панели («…» → Settings/Info/Credits) взаимно исключают друг друга
	if self.Library and self.Library.Overlays then
		for _, other in pairs(self.Library.Overlays) do
			if other ~= self and other.IsOpen then
				other:Close()
			end
		end
	end

	self.IsOpen = true

	self.Overlay.Visible = true
	self.Overlay.BackgroundTransparency = 1

	-- Фон проявляется (в оригинале — 0.1)
	Motion.tween(self.Overlay, { BackgroundTransparency = 0.02 }, {
		Duration = Motion.Duration.Slow,
		Easing = Motion.Easing.Decelerate,
	})

	-- Шторка-градиент по содержимому: как в оригинале (GradientOffset)
	if self.Body then
		Motion.reveal(self.Body, true, {
			Duration = Motion.Duration.Slower,
			Force = true,
		})
	end

	Motion.tween(self.Title, { TextTransparency = 0 }, {
		Duration = Motion.Duration.Normal,
		Delay = 0.06,
	})
	Motion.tween(self.BackIcon, { ImageTransparency = 0.3 }, {
		Duration = Motion.Duration.Normal,
		Delay = 0.06,
	})
	Motion.tween(self.NavLine, { BackgroundTransparency = 0.5 }, {
		Duration = Motion.Duration.Normal,
		Delay = 0.08,
	})

	-- Кнопки навигации — по очереди
	local buttons = {}
	for _, section in ipairs(self.Sections) do
		table.insert(buttons, section)
	end
	Motion.stagger(buttons, 0.045, function(section, index, delayTime)
		local isActive = self.ActiveSection == section
		Motion.tween(section.Label, {
			TextTransparency = isActive and 0 or 0.45,
		}, { Duration = Motion.Duration.Normal, Delay = 0.1 + delayTime })
		if section.Icon then
			Motion.tween(section.Icon, {
				ImageTransparency = isActive and 0 or 0.45,
			}, { Duration = Motion.Duration.Normal, Delay = 0.1 + delayTime })
		end
		if isActive then
			Motion.tween(section.Button, { BackgroundTransparency = 0.88 }, {
				Duration = Motion.Duration.Normal,
				Delay = 0.1 + delayTime,
			})
		end
	end)

	-- Подчёркивание встаёт на место и «раскрывается» по ширине
	if self.ActiveSection then
		local x, w = self:_measureButton(self.ActiveSection)
		self.SliderX:Snap(x)
		self.SliderW:Snap(0)
		self.SliderW:SetTarget(w)
		Motion.tween(self.NavSlider, { BackgroundTransparency = 0 }, {
			Duration = Motion.Duration.Normal,
			Delay = 0.15,
		})
	end

	if self.ActiveSection then
		self:_animateRows(self.ActiveSection)
	end
end

function SettingsOverlay:Close()
	if not self.IsOpen then
		return
	end
	self.IsOpen = false

	-- Гасим содержимое, потом фон
	for _, section in ipairs(self.Sections) do
		Motion.tween(section.Label, { TextTransparency = 1 }, {
			Duration = Motion.Duration.Fast,
		})
		if section.Icon then
			Motion.tween(section.Icon, { ImageTransparency = 1 }, {
				Duration = Motion.Duration.Fast,
			})
		end
		Motion.tween(section.Button, { BackgroundTransparency = 1 }, {
			Duration = Motion.Duration.Fast,
		})
	end

	Motion.tween(self.Title, { TextTransparency = 1 }, { Duration = Motion.Duration.Fast })
	Motion.tween(self.BackIcon, { ImageTransparency = 1 }, { Duration = Motion.Duration.Fast })
	Motion.tween(self.NavLine, { BackgroundTransparency = 1 }, { Duration = Motion.Duration.Fast })
	Motion.tween(self.NavSlider, { BackgroundTransparency = 1 }, { Duration = Motion.Duration.Fast })

	if self.ActiveSection then
		for _, row in ipairs(self.ActiveSection.Rows) do
			if row and row.Parent then
				Motion.tween(row, { BackgroundTransparency = 1 }, {
					Duration = Motion.Duration.Fast,
				})
				for _, child in ipairs(row:GetDescendants()) do
					if child:IsA("TextLabel") then
						Motion.tween(child, { TextTransparency = 1 }, {
							Duration = Motion.Duration.Micro,
						})
					end
				end
			end
		end
	end

	if self.Body then
		Motion.reveal(self.Body, false, { Duration = Motion.Duration.Normal })
	end

	Motion.tween(self.Overlay, { BackgroundTransparency = 1 }, {
		Duration = Motion.Duration.Normal,
		Delay = 0.1,
		Easing = Motion.Easing.Accelerate,
		OnComplete = function()
			if not self.IsOpen then
				self.Overlay.Visible = false
			end
		end,
	})
end

function SettingsOverlay:Toggle()
	if self.IsOpen then
		self:Close()
	else
		self:Open()
	end
end

function SettingsOverlay:Destroy()
	if self.SliderXDriver then
		self.SliderXDriver:Stop()
	end
	if self.SliderWDriver then
		self.SliderWDriver:Stop()
	end
	self.Janitor:Clean()
	if self.Overlay then
		self.Overlay:Destroy()
	end
end

return SettingsOverlay
end

__swagga_modules["Signal"] = function()

--[[
	Signal — лёгкая реализация событий.
	Нужна, чтобы элементы могли отдавать :OnChanged() без BindableEvent
	(BindableEvent в некоторых экзекуторах течёт и детектится).
]]

local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local sig = self._signal
	local handlers = sig._handlers
	for i = #handlers, 1, -1 do
		if handlers[i] == self then
			table.remove(handlers, i)
			break
		end
	end
	self._fn = nil
	self._signal = nil
end

Connection.disconnect = Connection.Disconnect
Connection.Destroy = Connection.Disconnect

function Signal.new(name: string?)
	return setmetatable({
		_name = name or "Signal",
		_handlers = {},
		_destroyed = false,
	}, Signal)
end

function Signal:Connect(fn)
	assert(type(fn) == "function", "Signal:Connect ожидает функцию")
	local conn = setmetatable({
		Connected = true,
		_fn = fn,
		_signal = self,
	}, Connection)
	table.insert(self._handlers, conn)
	return conn
end

Signal.connect = Signal.Connect

function Signal:Once(fn)
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Fire(...)
	if self._destroyed then
		return
	end
	-- Копия: обработчик может отсоединиться прямо во время вызова.
	local snapshot = table.clone(self._handlers)
	for _, conn in ipairs(snapshot) do
		if conn.Connected and conn._fn then
			local ok, err = pcall(conn._fn, ...)
			if not ok then
				warn(("[Swagga] Ошибка в обработчике %s: %s"):format(self._name, tostring(err)))
			end
		end
	end
end

function Signal:GetConnectionCount(): number
	return #self._handlers
end

function Signal:DisconnectAll()
	for i = #self._handlers, 1, -1 do
		local c = self._handlers[i]
		c.Connected = false
		c._fn = nil
		c._signal = nil
		self._handlers[i] = nil
	end
end

function Signal:Destroy()
	self:DisconnectAll()
	self._destroyed = true
end

return Signal
end

__swagga_modules["Tab"] = function()

--[[
	Tab — вкладка: кнопка в сайдбаре + страница с элементами.

	Страница — ScrollingFrame с UIListLayout и AutomaticCanvasSize.
	Важно: элементы, которые «выталкивают» соседей (дропдаун, палитра),
	меняют собственный Size — лейаут пересчитывает остальных сам.
	Именно поэтому push-анимация выглядит естественно и ничего не
	наезжает друг на друга.
]]

local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Icons = __swagga_require("Icons")
local Signal = __swagga_require("Signal")

local create = Util.create

local Tab = {}
Tab.__index = Tab

local BUTTON_HEIGHT = 34

function Tab.new(window, config)
	config = config or {}
	local self = setmetatable({}, Tab)

	self.Window = window
	self.Library = window.Library
	self.Name = config.Name or "Tab"
	self.Icon = config.Icon
	self.Elements = {}
	self.Active = false
	self.Destroyed = false
	self.Janitor = Util.janitor()
	self.Selected = Signal.new("Tab.Selected")

	self:_buildButton(config)
	self:_buildPage()

	return self
end

--==============================================================
-- Кнопка в сайдбаре
--==============================================================
function Tab:_buildButton(config)
	local button = create("TextButton", {
		Name = self.Name,
		Size = UDim2.new(1, 0, 0, BUTTON_HEIGHT),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = config.Order or (#self.Window.Tabs + 1),
		ZIndex = 5,
		Parent = self.Window.TabList,
	}, {
		Util.corner(8),
	})
	Theme.bind(button, "BackgroundColor3", "ElementHover")
	self.Button = button

	-- Иконка
	local icon = create("ImageLabel", {
		Name = "Icon",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(17, 17),
		ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = 0.4,
		ZIndex = 6,
		Parent = button,
	}, {
		create("UIScale", {}),
	})
	if self.Icon then
		Icons.apply(icon, self.Icon)
	else
		-- Без иконки — маленькая точка вместо пустоты
		icon.Visible = false
	end
	--[[
		Цвет иконки зависит от того, активна ли вкладка, поэтому
		статический Theme.bind не годится: при смене темы он сбрасывал
		бы акцент активной вкладки в «неактивный» серый.
	]]
	icon.ImageColor3 = Theme.get("TextSecondary")
	self.IconLabel = icon
	self.IconScale = icon:FindFirstChildOfClass("UIScale")

	-- Подпись
	local label = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, self.Icon and 38 or 14, 0.5, 0),
		Size = UDim2.new(1, self.Icon and -46 or -22, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = self.Name,
		TextSize = 13,
		TextTransparency = 0.4,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 6,
		Parent = button,
	})
	label.TextColor3 = Theme.get("TextSecondary")
	self.Label = label

	-- Перерисовка при смене темы с учётом активности
	self.Janitor:Add(Theme.Changed:Connect(function()
		if self.Destroyed then
			return
		end
		local active = self.Active
		self.IconLabel.ImageColor3 = active and Theme.get("Accent") or Theme.get("TextSecondary")
		self.Label.TextColor3 = active and Theme.get("TextPrimary") or Theme.get("TextSecondary")
	end))

	-- Тултип для свёрнутого состояния
	self.Tooltip = nil

	button.MouseEnter:Connect(function()
		if not self.Active then
			Motion.fast(button, { BackgroundTransparency = 0.9 })
			Motion.fast(label, { TextTransparency = 0.1 })
			Motion.fast(icon, { ImageTransparency = 0.1 })
		end
		Motion.tween(self.IconScale, { Scale = 1.1 }, {
			Duration = Motion.Duration.Normal,
			Easing = Motion.Easing.Overshoot,
		})
		if self.Window.SidebarCollapsed then
			self:_showTooltip()
		end
	end)

	button.MouseLeave:Connect(function()
		if not self.Active then
			Motion.fast(button, { BackgroundTransparency = 1 })
			Motion.fast(label, { TextTransparency = 0.4 })
			Motion.fast(icon, { ImageTransparency = 0.4 })
		end
		Motion.tween(self.IconScale, { Scale = 1 }, { Duration = Motion.Duration.Normal })
		self:_hideTooltip()
	end)

	button.MouseButton1Down:Connect(function()
		Motion.tween(self.IconScale, { Scale = 0.9 }, { Duration = Motion.Duration.Micro })
	end)

	button.Activated:Connect(function()
		Motion.tween(self.IconScale, { Scale = 1 }, {
			Duration = Motion.Duration.Normal,
			Easing = Motion.Easing.Overshoot,
		})
		self.Window:SelectTab(self)
	end)
end

--[[
	Тултип показывается только когда сайдбар свёрнут —
	иначе непонятно, что за иконка.
]]
function Tab:_showTooltip()
	if self.Tooltip then
		return
	end
	local tip = create("Frame", {
		Name = "Tooltip",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, 8, 0.5, 0),
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		ZIndex = 100,
		Parent = self.Button,
	}, {
		Util.corner(6),
		Util.padding(0, 0, 10, 10),
	})
	Theme.bind(tip, "BackgroundColor3", "Element")

	local text = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Enum.Font.Gotham,
		Text = self.Name,
		TextSize = 12,
		TextTransparency = 1,
		ZIndex = 101,
		Parent = tip,
	})
	Theme.bind(text, "TextColor3", "TextPrimary")

	Util.shadow(tip, { Blur = 12, Transparency = 0.5, OffsetY = 3 })

	self.Tooltip = tip
	Motion.tween(tip, { BackgroundTransparency = 0 }, { Duration = Motion.Duration.Fast })
	Motion.tween(text, { TextTransparency = 0 }, {
		Duration = Motion.Duration.Fast,
		Delay = 0.04,
	})
end

function Tab:_hideTooltip()
	if not self.Tooltip then
		return
	end
	local tip = self.Tooltip
	self.Tooltip = nil
	Motion.tween(tip, { BackgroundTransparency = 1 }, {
		Duration = Motion.Duration.Fast,
		OnComplete = function()
			if tip then
				tip:Destroy()
			end
		end,
	})
	for _, child in ipairs(tip:GetChildren()) do
		if child:IsA("TextLabel") then
			Motion.tween(child, { TextTransparency = 1 }, { Duration = Motion.Duration.Fast })
		end
	end
end

--[[
	Реакция на сворачивание сайдбара: подпись уезжает и гаснет,
	иконка центрируется.
]]
function Tab:SetCollapsed(collapsed, duration)
	duration = duration or Motion.Duration.Normal

	Motion.tween(self.Label, {
		TextTransparency = collapsed and 1 or (self.Active and 0 or 0.4),
	}, {
		Duration = duration,
		Delay = collapsed and 0 or 0.08,
	})

	if self.Icon then
		Motion.tween(self.IconLabel, {
			Position = collapsed and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 12, 0.5, 0),
		}, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Standard,
		})
	end

	if not collapsed then
		self:_hideTooltip()
	end
end

--==============================================================
-- Страница
--==============================================================
function Tab:_buildPage()
	local page = create("ScrollingFrame", {
		Name = self.Name .. "Page",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0, 0),
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageTransparency = 0.6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		Visible = false,
		ZIndex = 2,
		Parent = self.Window.Content,
	}, {
		Util.listLayout({ Padding = UDim.new(0, 8) }),
		Util.padding(14, 20, 14, 14),
	})
	Theme.bind(page, "ScrollBarImageColor3", "TextMuted")
	self.Page = page
end

--==============================================================
-- Активация
--==============================================================
function Tab:_setActive(active)
	self.Active = active

	if active then
		self.Page.Visible = true
		Motion.tween(self.Button, { BackgroundTransparency = 0.82 }, {
			Duration = Motion.Duration.Normal,
		})
		Motion.tween(self.Label, {
			TextTransparency = self.Window.SidebarCollapsed and 1 or 0,
			TextColor3 = Theme.get("TextPrimary"),
		}, { Duration = Motion.Duration.Normal })
		Motion.tween(self.IconLabel, {
			ImageTransparency = 0,
			ImageColor3 = Theme.get("Accent"),
		}, { Duration = Motion.Duration.Normal })

		-- Появление страницы: лёгкий подъём + проявление
		self:_animatePageIn()
		self.Selected:Fire()
	else
		Motion.tween(self.Button, { BackgroundTransparency = 1 }, {
			Duration = Motion.Duration.Normal,
		})
		Motion.tween(self.Label, {
			TextTransparency = self.Window.SidebarCollapsed and 1 or 0.4,
			TextColor3 = Theme.get("TextSecondary"),
		}, { Duration = Motion.Duration.Normal })
		Motion.tween(self.IconLabel, {
			ImageTransparency = 0.4,
			ImageColor3 = Theme.get("TextSecondary"),
		}, { Duration = Motion.Duration.Normal })

		self:_animatePageOut()
	end
end

function Tab:_animatePageIn()
	local page = self.Page
	page.Visible = true
	page.CanvasPosition = Vector2.new(0, 0)

	--[[
		Шторка-градиент по всей странице — фирменная анимация
		оригинала (GradientOffset). Идёт поверх каскада элементов
		и мягко «открывает» содержимое снизу вверх.
	]]
	Motion.reveal(page, true, {
		Duration = Motion.Duration.Slower,
		Force = true,
	})

	-- Элементы появляются каскадом снизу вверх
	local elements = {}
	for _, element in ipairs(self.Elements) do
		if element.Frame and element.Frame.Visible then
			table.insert(elements, element)
		end
	end

	Motion.stagger(elements, 0.022, function(element, index, delayTime)
		local frame = element.Frame
		if not frame then
			return
		end
		-- Сохраняем «родную» прозрачность элемента
		local targetBg = element._baseTransparency or 0
		frame.BackgroundTransparency = 1

		local offset = frame:FindFirstChild("_SlideOffset")
		if not offset then
			offset = Instance.new("UIPadding")
			offset.Name = "_SlideOffset"
			offset.Parent = frame
		end
		offset.PaddingTop = UDim.new(0, 10)

		Motion.tween(frame, { BackgroundTransparency = targetBg }, {
			Duration = Motion.Duration.Normal,
			Delay = delayTime,
		})
		Motion.tween(offset, { PaddingTop = UDim.new(0, 0) }, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Decelerate,
			Delay = delayTime,
		})

		-- Текст и иконки внутри
		for _, child in ipairs(frame:GetDescendants()) do
			if child:IsA("TextLabel") and not child:GetAttribute("NoFade") then
				local base = child:GetAttribute("BaseTransparency") or child.TextTransparency
				child:SetAttribute("BaseTransparency", base)
				child.TextTransparency = 1
				Motion.tween(child, { TextTransparency = base }, {
					Duration = Motion.Duration.Normal,
					Delay = delayTime + 0.03,
				})
			end
		end
	end)
end

function Tab:_animatePageOut()
	local page = self.Page
	Motion.tween(page, { BackgroundTransparency = 1 }, {
		Duration = Motion.Duration.Fast,
		OnComplete = function()
			if not self.Active then
				page.Visible = false
			end
		end,
	})
end

--==============================================================
-- Регистрация элементов
--==============================================================
function Tab:_register(element)
	table.insert(self.Elements, element)
	element.LayoutOrder = element.LayoutOrder or #self.Elements
	if element.Frame then
		element.Frame.LayoutOrder = element.LayoutOrder
	end
	if self.Library and self.Library._registerElement then
		self.Library:_registerElement(element)
	end
	return element
end

function Tab:GetElements()
	return self.Elements
end

function Tab:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	for _, element in ipairs(self.Elements) do
		if element.Destroy then
			element:Destroy()
		end
	end
	self:_hideTooltip()
	if self.Button then
		self.Button:Destroy()
	end
	if self.Page then
		self.Page:Destroy()
	end
	self.Janitor:Clean()
	self.Selected:Destroy()
end

return Tab
end

