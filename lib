--==============================================================
-- Настройки библиотеки
--==============================================================
function Swagga:_saveSettings()
	if not self.Save or self.Save._destroyed then
		return
	end
	self.Save:SaveSettings({
		theme = Theme.CurrentName,
		accent = Util.toHex(Theme.get("Accent")),
		animSpeed = Motion.SpeedMultiplier,
		reducedMotion = Motion.ReducedMotion,
		toggleKey = self.ToggleKey and self.ToggleKey.Name or nil,
		sidebarCollapsed = self.Window and self.Window.SidebarCollapsed or false,
	})
end

function Swagga:_loadSettings()
	if not self.Save or self.Save._destroyed then
		return
	end
	local settings = self.Save:LoadSettings()
	if not settings then
		return
	end

	if settings.theme and Theme.Presets[settings.theme] then
		Theme.apply(settings.theme, false)
	end
	if settings.accent then
		Theme.setAccent(Util.hex(settings.accent), false)
	end
	if settings.animSpeed then
		Motion.SetSpeed(settings.animSpeed)
	end
	if settings.reducedMotion ~= nil then
		Motion.SetReducedMotion(settings.reducedMotion)
	end
	if settings.toggleKey and Enum.KeyCode[settings.toggleKey] then
		self.ToggleKey = Enum.KeyCode[settings.toggleKey]
	end
end

--==============================================================
-- Реестр элементов
--==============================================================
function Swagga:_registerElement(element)
	if not self.Elements then
		return
	end
	table.insert(self.Elements, element)
	if element.Flag and not element.ForgetState then
		self.Flags[element.Flag] = element
		self.Save:Register(element)
	end
end

function Swagga:_unregisterElement(element)
	if not self.Elements then
		return
	end
	for i = #self.Elements, 1, -1 do
		if self.Elements[i] == element then
			table.remove(self.Elements, i)
		end
	end
	if element.Flag then
		self.Flags[element.Flag] = nil
		self.Save:Unregister(element)
	end
end

--==============================================================
-- Публичный API
--==============================================================
function Swagga:Notify(config)
	if self.Notifications then
		return self.Notifications:Notify(config)
	end
	return nil
end

function Swagga:Get(flag)
	if not self.Flags then
		return nil
	end
	local element = self.Flags[flag]
	if not element then
		return nil
	end
	-- Важно: без and/or — иначе значение false превратилось бы в nil
	return element:Get()
end

function Swagga:Set(flag, value)
	if not self.Flags then
		return false
	end
	local element = self.Flags[flag]
	if element then
		element:Set(value)
		return true
	end
	return false
end

function Swagga:SetTheme(name)
	return Theme.apply(name, true)
end

function Swagga:SetAccent(color)
	return Theme.setAccent(color, true)
end

function Swagga:SetAnimationSpeed(multiplier)
	Motion.SetSpeed(multiplier)
end

function Swagga:SaveConfig(name)
	if not self.Save then
		return false
	end
	return self.Save:SaveConfig(name)
end

function Swagga:LoadConfig(name)
	if not self.Save then
		return false
	end
	return self.Save:LoadConfig(name)
end

function Swagga:GetElements()
	return self.Elements or {}
end

--[[
	Поиск по всем элементам. Возвращает совпадения,
	отсортированные по релевантности.
]]
function Swagga:Search(query)
	query = Util.lower(tostring(query))
	if query == "" then
		return {}
	end

	local results = {}
	for _, element in ipairs(self.Elements or {}) do
		if not element.Destroyed then
			local name = Util.lower(tostring(element.Name))
			local desc = Util.lower(tostring(element.Description or ""))
			local score = nil

			if name == query then
				score = 0
			elseif Util.sub(name, 1, Util.len(query)) == query then
				score = 1
			elseif name:find(query, 1, true) then
				score = 2
			elseif desc:find(query, 1, true) then
				score = 3
			end

			if score then
				table.insert(results, { Element = element, Score = score })
			end
		end
	end

	table.sort(results, function(a, b)
		if a.Score ~= b.Score then
			return a.Score < b.Score
		end
		return a.Element.Name < b.Element.Name
	end)

	local out = {}
	for _, entry in ipairs(results) do
		table.insert(out, entry.Element)
	end
	return out
end

--[[
	Полностью выгрузить библиотеку.
	Сбрасываем состояние синглтона, чтобы повторный CreateWindow
	поднял всё заново с чистого листа.
]]
function Swagga:Destroy()
	if self.Destroyed or not self.Elements then
		return
	end
	self.Destroyed = true

	if self.Save then
		self.Save:Destroy()
	end
	if self.Binds then
		self.Binds:Destroy()
	end
	if self.ContextMenu then
		self.ContextMenu:Destroy()
	end
	if self.Notifications then
		self.Notifications:Destroy()
	end
	for _, overlay in pairs(self.Overlays or {}) do
		if overlay then
			overlay:Destroy()
		end
	end
	for _, window in ipairs(self.Windows or {}) do
		window:Destroy()
	end
	if self.Janitor then
		self.Janitor:Clean()
	end

	self.Elements = nil
	self.Flags = nil
	self.Windows = nil
	self.Save = nil
	self.Binds = nil
	self.ContextMenu = nil
	self.Notifications = nil
	self.Window = nil
	self.ScreenGui = nil
	self.Settings = nil
	self.Info = nil
	self.Credits = nil
	self.Overlays = nil
	self.Destroyed = false
end

Swagga.Unload = Swagga.Destroy

return Swagga
end

return __swagga_require("init")
