-- Достраиваем производные токены
for _, preset in pairs(Theme.Presets) do
	preset.AccentMuted = preset.Accent:Lerp(preset.Background, 0.55)
	preset.AccentSoft = preset.Accent:Lerp(preset.Background, 0.8)
	preset.Overlay = preset.Background:Lerp(Color3.new(0, 0, 0), 0.35)
end

--==============================================================
-- Текущая тема
--==============================================================
Theme.Current = Util.deepCopy(Theme.Presets.Midnight)
Theme.CurrentName = "Midnight"
Theme.Changed = Signal.new("Theme.Changed")

function Theme.get(token: string): Color3
	local value = Theme.Current[token]
	if typeof(value) == "Color3" then
		return value
	end
	-- Неизвестный токен не должен ронять UI
	warn(("[Swagga] Неизвестный токен темы: %s"):format(tostring(token)))
	return Color3.fromRGB(255, 0, 255)
end

--==============================================================
-- Привязки
--==============================================================
-- bindings[instance] = { {property, token, transform}, ... }
local bindings = setmetatable({}, { __mode = "k" })

--[[
	Theme.bind(frame, "BackgroundColor3", "Element")
	Theme.bind(label, "TextColor3", "TextSecondary")

	transform — опциональная функция для модификации цвета
	(например, затемнить на 20%: function(c) return Util.shift(c, -0.2) end)
]]
function Theme.bind(instance: Instance, property: string, token: string, transform)
	if not instance then
		return
	end
	local list = bindings[instance]
	if not list then
		list = {}
		bindings[instance] = list
	end
	table.insert(list, { property = property, token = token, transform = transform })

	-- Применяем сразу
	local color = Theme.get(token)
	if transform then
		color = transform(color)
	end
	pcall(function()
		instance[property] = color
	end)
	return instance
end

function Theme.unbind(instance: Instance)
	bindings[instance] = nil
end

--[[
	Специальные привязки — для объектов, у которых цвет не Color3
	(UIGradient.Color = ColorSequence). Регистрируются функцией.
]]
local customBindings = setmetatable({}, { __mode = "k" })

function Theme.bindCustom(instance: Instance, applyFn)
	customBindings[instance] = applyFn
	applyFn(Theme.Current)
	return instance
end

--==============================================================
-- Применение темы
--==============================================================
function Theme.apply(themeOrName, animate: boolean?)
	local theme
	if type(themeOrName) == "string" then
		theme = Theme.Presets[themeOrName]
		if not theme then
			warn(("[Swagga] Тема не найдена: %s"):format(themeOrName))
			return false
		end
		Theme.CurrentName = themeOrName
	else
		theme = themeOrName
		Theme.CurrentName = theme.Name or "Custom"
	end

	-- Копируем и достраиваем производные
	local applied = Util.deepCopy(theme)
	applied.AccentMuted = applied.AccentMuted or applied.Accent:Lerp(applied.Background, 0.55)
	applied.AccentSoft = applied.AccentSoft or applied.Accent:Lerp(applied.Background, 0.8)
	applied.Overlay = applied.Overlay or applied.Background:Lerp(Color3.new(0, 0, 0), 0.35)
	Theme.Current = applied

	local shouldAnimate = animate ~= false

	-- Обычные привязки
	for instance, list in pairs(bindings) do
		if instance and instance.Parent then
			for _, binding in ipairs(list) do
				local color = applied[binding.token]
				if typeof(color) == "Color3" then
					if binding.transform then
						color = binding.transform(color)
					end
					if shouldAnimate then
						Motion.tween(instance, { [binding.property] = color }, {
							Duration = Motion.Duration.Normal,
							Easing = Motion.Easing.Standard,
						})
					else
						pcall(function()
							instance[binding.property] = color
						end)
					end
				end
			end
		else
			bindings[instance] = nil
		end
	end

	-- Кастомные привязки (градиенты и т.п.)
	for instance, applyFn in pairs(customBindings) do
		if instance and instance.Parent then
			pcall(applyFn, applied, shouldAnimate)
		else
			customBindings[instance] = nil
		end
	end

	Theme.Changed:Fire(applied, Theme.CurrentName)
	return true
end

--[[
	Смена только акцента — самый частый сценарий
	(пользователь выбирает цвет в палитре).
]]
function Theme.setAccent(color: Color3, animate: boolean?)
	local t = Util.deepCopy(Theme.Current)
	t.Accent = color
	t.AccentHover = Util.shift(color, 0.12)
	t.AccentMuted = color:Lerp(t.Background, 0.55)
	t.AccentSoft = color:Lerp(t.Background, 0.8)
	t.GlowA = Util.shift(color, 0.15)
	t.GlowB = Util.shift(color, -0.2)
	t.Name = Theme.CurrentName
	return Theme.apply(t, animate)
end

function Theme.getPresetNames(): {string}
	local names = {}
	for name in pairs(Theme.Presets) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function Theme.serialize(): {[string]: string}
	local out = {}
	for k, v in pairs(Theme.Current) do
		if typeof(v) == "Color3" then
			out[k] = Util.toHex(v)
		end
	end
	out.Name = Theme.CurrentName
	return out
end

function Theme.deserialize(data)
	if type(data) ~= "table" then
		return false
	end
	local t = {}
	for k, v in pairs(data) do
		if k == "Name" then
			t.Name = v
		elseif type(v) == "string" then
			t[k] = hex(v)
		end
	end
	-- Заполняем недостающее из Midnight
	for k, v in pairs(Theme.Presets.Midnight) do
		if t[k] == nil then
			t[k] = v
		end
	end
	return Theme.apply(t, false)
end

return Theme
end

__swagga_modules["Util"] = function()

--[[
	Util — фабрика инстансов и общие хелперы.

	Главная идея: create() принимает таблицу свойств и таблицу детей,
	что делает вёрстку в коде читаемой почти как XML-разметка.
]]

local Compat = __swagga_require("Compat")

local Util = {}

--==============================================================
-- create: декларативное создание инстансов
--==============================================================
--[[
	Util.create("Frame", {
		Name = "Body",
		Size = UDim2.fromOffset(760, 640),
		Parent = someParent,
	}, {
		Util.create("UICorner", { CornerRadius = UDim.new(0, 15) }),
	})
]]
function Util.create(className: string, props: {[string]: any}?, children: {Instance}?): Instance
	local inst = Instance.new(className)
	local deferredParent = nil

	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				deferredParent = value
			else
				-- pcall: свойство может не существовать на старом клиенте
				local ok, err = pcall(function()
					inst[key] = value
				end)
				if not ok then
					warn(("[Swagga] Не удалось задать %s.%s: %s"):format(className, key, tostring(err)))
				end
			end
		end
	end

	if children then
		for _, child in ipairs(children) do
			if child then
				child.Parent = inst
			end
		end
	end

	-- Parent ставим последним: меньше пересчётов лейаута.
	if deferredParent then
		inst.Parent = deferredParent
	end

	return inst
end

local create = Util.create

--==============================================================
-- Базовые пресеты
--==============================================================
function Util.corner(radius: number | UDim): Instance
	return create("UICorner", {
		CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius or 15),
	})
end

--[[
	Углы по отдельности. На новых клиентах — нативно, на старых
	откатываемся к общему радиусу (берём максимальный из заданных).
]]
function Util.cornerEach(tl: number, tr: number, br: number, bl: number): Instance
	tl, tr, br, bl = tl or 0, tr or 0, br or 0, bl or 0
	if Compat.HasPerCornerRadius then
		local c = Instance.new("UICorner")
		pcall(function()
			c.TopLeftRadius = UDim.new(0, tl)
			c.TopRightRadius = UDim.new(0, tr)
			c.BottomRightRadius = UDim.new(0, br)
			c.BottomLeftRadius = UDim.new(0, bl)
		end)
		return c
	end
	return create("UICorner", { CornerRadius = UDim.new(0, math.max(tl, tr, br, bl)) })
end

function Util.padding(top: number, bottom: number?, left: number?, right: number?): Instance
	-- Util.padding(10) → все стороны по 10
	if bottom == nil then
		bottom, left, right = top, top, top
	end
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		PaddingRight = UDim.new(0, right),
