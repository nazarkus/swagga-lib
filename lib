	self.Title.Size = UDim2.new(1, -Element.PADDING_X * 2 - (self.IconLabel and 24 or 0), 1, 0)
	self.Title.TextWrapped = true

	-- Цветовая метка по типу
	local kind = config.Type or config.Style
	if kind then
		local token = ({
			info = "Info",
			success = "Success",
			warning = "Warning",
			danger = "Danger",
			error = "Danger",
		})[tostring(kind):lower()]

		if token then
			Theme.bind(self.Frame, "BackgroundColor3", token, function(c)
				return c:Lerp(Theme.get("Background"), 0.85)
			end)
			Theme.bind(self.Title, "TextColor3", token, function(c)
				return Util.shift(c, 0.2)
			end)

			-- Вертикальная полоска-акцент слева
