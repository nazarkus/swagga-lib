function Window:_buildMorePanel(config)
	local panel = create("Frame", {
		Name = "MorePanel",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, TOPBAR_HEIGHT - 4),
		Size = UDim2.fromOffset(180, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 50,
		Parent = self.Root,
	}, {
		Util.corner(10),
		Util.listLayout({ Padding = UDim.new(0, 2) }),
		Util.padding(6),
	})
	Theme.bind(panel, "BackgroundColor3", "Element")
	self.MorePanel = panel
	self.MorePanelOpen = false

	self.MoreShadow = Util.shadow(panel, { Blur = 22, Transparency = 0.4, OffsetY = 6 })

	local stroke = Util.stroke(Theme.get("Stroke"), 1, 0.4)
	if stroke then
		stroke.Parent = panel
		Theme.bind(stroke, "Color", "Stroke")
	end

	self.MoreItems = {}
	--[[
		Три раздела, как в оригинале (Settings · InfoAbout · Credits).
		Панель «…» схлопывается, затем с небольшой задержкой
		выезжает выбранная панель — так переход читается мягче.
	]]
	local function openOverlay(getter)
		self:ToggleMorePanel(false)
		task.delay(0.12, function()
			local overlay = getter()
			if overlay then
				overlay:Open()
			end
		end)
	end

	self:AddMoreItem("Настройки", "settings", function()
		openOverlay(function() return self.SettingsOverlay end)
	end)
	self:AddMoreItem("Информация", "info", function()
		openOverlay(function() return self.InfoOverlay end)
	end)
	self:AddMoreItem("Авторы", "heart", function()
		openOverlay(function() return self.CreditsOverlay end)
	end)
	self:AddMoreItem("Свернуть", "minus", function()
		self:Minimize()
		self:ToggleMorePanel(false)
	end)
	self:AddMoreItem("Закрыть", "x", function()
		self:Close()
	end)
end

