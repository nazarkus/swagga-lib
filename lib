--==============================================================
-- Создание окна
--==============================================================
--[[
	Создать окно.

	ВАЖНО про архитектуру: библиотека — синглтон. Раньше здесь
	создавалась отдельная таблица `library`, а наружу отдавалось
	`window`. Из-за этого пользовательские вызовы Swagga:Get(),
	Swagga:Notify(), Swagga:SaveConfig() уходили в пустой модуль
	и падали с "attempt to index nil".

	Теперь состояние живёт прямо в модуле Swagga, а второе и
	последующие окна переиспользуют уже созданные подсистемы
	(уведомления, бинды, сохранение).
]]
function Swagga:CreateWindow(config)
	config = config or {}

	-- Сам модуль и есть библиотека
	local library = Swagga
	local firstWindow = library.Elements == nil

	if firstWindow then
		library.Elements = {}
		library.Flags = {}
		library.Windows = {}
		library.Destroyed = false
		library.Janitor = Util.janitor()
	end

	-- Тема до постройки UI, чтобы не перекрашивать после
	if config.Theme then
		Theme.apply(config.Theme, false)
	end
	if config.Accent then
		Theme.setAccent(config.Accent, false)
	end

	-- Скорость анимаций
	if config.AnimationSpeed then
		Motion.SetSpeed(config.AnimationSpeed)
	end
	if config.ReducedMotion then
		Motion.SetReducedMotion(true)
	end

	-- Без иконок по сети, если попросили
	if config.NoNetworkIcons or config.SecureMode then
		Icons.setLucideEnabled(false)
	end

	-- Сохранение (одно на всю библиотеку)
	if not library.Save then
		library.Save = Save.new(library, config)
	end

	-- Окно
	local window = Window.new(library, config)
	library.Window = library.Window or window
	library.ScreenGui = library.ScreenGui or window.ScreenGui
	table.insert(library.Windows, window)

	-- Подсистемы создаём один раз: тосты и бинды общие для всех окон
	if not library.Notifications then
		library.Notifications = Notifications.new(library)
	end
	if not library.ContextMenu then
		library.ContextMenu = ContextMenu.new(library)
	end
	if not library.Binds then
		library.Binds = Binds.new(library)
	end

	-- Клавиша показа/скрытия меню
	library.ToggleKey = config.ToggleKey or library.ToggleKey or Enum.KeyCode.RightShift
	if firstWindow then
		library.Janitor:Add(UIS.InputBegan:Connect(function(input, processed)
			if processed then
				return
			end
			if UIS:GetFocusedTextBox() then
				return
			end
			if input.KeyCode == library.ToggleKey then
				-- Переключаем все окна разом
				for _, w in ipairs(library.Windows) do
					if not w.Destroyed then
						w:Toggle()
					end
				end
			end
		end))
	end

	--[[
		Встроенный таб настроек.

		Создаём его сразу (чтобы он существовал для MorePanel и API),
		но помечаем как системный: Window:CreateTab не отдаёт ему
		автофокус, а первая пользовательская вкладка забирает его себе.
		Так порядок не зависит от тайминга task.defer.
	]]
	--[[
		Настройки — выезжающий оверлей поверх окна, как в оригинале
		(Background.MoreTabs), а НЕ вкладка в сайдбаре.
		Открывается кнопкой «…» в топбаре → «Настройки».
	]]
	--[[
		Три выезжающие панели, как в оригинале (Background.MoreTabs):
		  Settings   — тема, интерфейс, клавиши, конфиги
		  InfoAbout  — сведения о среде и библиотеке
		  Credits    — авторы
		Все открываются из панели «…» и взаимно исключают друг друга.
	]]
	if config.Settings ~= false and firstWindow then
		library.Overlays = {}

		library.Settings = SettingsOverlay.new(library, window, "Настройки")
		library.Overlays.Settings = library.Settings
		library:_fillSettings(config)
		window.SettingsOverlay = library.Settings

		library.Info = SettingsOverlay.new(library, window, "Информация")
		library.Overlays.Info = library.Info
		library:_fillInfo(config)
		window.InfoOverlay = library.Info

		library.Credits = SettingsOverlay.new(library, window, "Авторы")
		library.Overlays.Credits = library.Credits
		library:_fillCredits(config)
		window.CreditsOverlay = library.Credits
	end

	--[[
		Автозагрузка конфига после постройки интерфейса.
		Проверяем library.Save внутри колбэка: пользователь мог
		вызвать Destroy() в том же кадре, и тогда task.defer
		просыпался уже на выгруженной библиотеке.
	]]
	if firstWindow and library.Save.AutoLoad and library.Save.Enabled then
		task.defer(function()
			local save = library.Save
			if not save or save._destroyed then
				return
			end
			save:LoadConfig(save.CurrentConfig, true)
			library:_loadSettings()
		end)
	end

	-- Приветственное уведомление
	if config.Welcome ~= false and firstWindow then
		task.delay(0.35, function()
			if not library.Destroyed then
				library:Notify({
					Title = config.Name or "Swagga Hub",
					Content = ("Готово · %s для меню"):format(
						tostring(library.ToggleKey.Name or library.ToggleKey)
					),
					Icon = "sparkles",
					Duration = 3.5,
				})
			end
		end)
	end

	return window
end

--==============================================================
-- Таб настроек
--==============================================================
--==============================================================
-- Наполнение оверлея настроек
--==============================================================
function Swagga:_fillSettings(config)
	local S = self.Settings
	local window = self.Window

	--=========================================================
	-- Раздел: Тема
	--=========================================================
	local themeSec = S:AddSection("Тема", "palette")

	S:AddHeading(themeSec, "Оформление")

	S:AddChoice(themeSec, {
		Name = "Пресет",
		Description = "Готовая цветовая схема",
		Options = Theme.getPresetNames(),
		Default = Theme.CurrentName,
		Callback = function(name)
			Theme.apply(name, true)
			self:_saveSettings()
		end,
	})

	S:AddHeading(themeSec, "Акцентный цвет")

	-- Быстрые акценты вместо тяжёлой палитры внутри настроек
	local accents = {
		{ "Изумруд", "00A77E" }, { "Индиго", "5B62D6" }, { "Роза", "D0455A" },
		{ "Циан", "3FB8CE" }, { "Пурпур", "A052E0" }, { "Охра", "C99A4B" },
	}
	for _, entry in ipairs(accents) do
		S:AddButton(themeSec, {
			Name = entry[1],
			Icon = "droplet",
			Callback = function()
				Theme.setAccent(Util.hex(entry[2]), true)
				self:_saveSettings()
				self:Notify({
					Title = "Акцент изменён",
					Content = entry[1],
					Icon = "palette",
					Duration = 2,
				})
			end,
		})
	end

	S:AddInput(themeSec, {
		Name = "Свой цвет (HEX)",
		Description = "Например 00A77E",
		Placeholder = "00A77E",
		Default = Util.toHex(Theme.get("Accent")),
		Callback = function(text)
			local clean = tostring(text):gsub("#", "")
			if #clean == 6 and clean:match("^%x+$") then
				Theme.setAccent(Util.hex(clean), true)
				self:_saveSettings()
			else
				self:Notify({
					Title = "Неверный HEX",
					Content = "Нужно 6 символов, например 00A77E",
					Type = "warning",
					Duration = 3,
				})
			end
		end,
	})

	--=========================================================
	-- Раздел: Интерфейс
	--=========================================================
	local uiSec = S:AddSection("Интерфейс", "sliders")

	S:AddHeading(uiSec, "Анимации")

	S:AddSlider(uiSec, {
		Name = "Скорость анимаций",
		Description = "Меньше — медленнее и плавнее",
		Min = 0.25, Max = 3, Default = Motion.SpeedMultiplier,
		Decimals = 2, Increment = 0.05, Suffix = "x",
		Callback = function(v)
			Motion.SetSpeed(v)
			self:_saveSettings()
		end,
	})

	S:AddToggle(uiSec, {
		Name = "Упрощённые анимации",
		Description = "Отключить движение на слабых устройствах",
		Default = Motion.ReducedMotion,
		Callback = function(v)
			Motion.SetReducedMotion(v)
			self:_saveSettings()
		end,
	})

	S:AddHeading(uiSec, "Окно")

	S:AddToggle(uiSec, {
		Name = "Свёрнутый сайдбар",
		Description = "Показывать только иконки вкладок",
		Default = window.SidebarCollapsed,
		Callback = function(v)
			if v ~= window.SidebarCollapsed then
				window:ToggleSidebar()
			end
			self:_saveSettings()
		end,
	})

	S:AddButton(uiSec, {
		Name = "Сбросить положение окна",
		Icon = "move",
		Callback = function()
			Motion.tween(window.Root, {
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(780, 620),
			}, { Duration = Motion.Duration.Slow, Easing = Motion.Easing.Standard })
		end,
	})

	--=========================================================
	-- Раздел: Клавиши
	--=========================================================
	local keySec = S:AddSection("Клавиши", "keyboard")

	S:AddHeading(keySec, "Управление меню")

	local toggleRow = S:AddButton(keySec, {
		Name = "Клавиша меню: " .. tostring(self.ToggleKey.Name or self.ToggleKey),
		Description = "Нажмите, чтобы переназначить",
		Icon = "keyboard",
		Callback = function() end,
	})

	-- Своя запись клавиши для строки оверлея
	do
		local btn = toggleRow.Row:FindFirstChildWhichIsA("TextButton")
		local label = toggleRow.Row:FindFirstChildWhichIsA("TextLabel")
		if btn and label then
			btn.Activated:Connect(function()
				label.Text = "Нажмите клавишу..."
				local conn
				conn = UIS.InputBegan:Connect(function(input, processed)
					if processed then
						return
					end
					if input.UserInputType ~= Enum.UserInputType.Keyboard then
						return
					end
					conn:Disconnect()
					if input.KeyCode ~= Enum.KeyCode.Escape then
						self.ToggleKey = input.KeyCode
						self:_saveSettings()
					end
