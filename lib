function Window:_buildResizer()
	local resizer = create("ImageButton", {
		Name = "Resizer",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -2, 1, -2),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Image = "rbxassetid://117448615800761",
		ImageTransparency = 0.75,
		ZIndex = 40,
		Parent = self.Root,
	})
	Theme.bind(resizer, "ImageColor3", "TextSecondary")
	self.Resizer = resizer

	local resizing = false
	local startMouse, startSize

	resizer.MouseEnter:Connect(function()
		Motion.fast(resizer, { ImageTransparency = 0.2 })
	end)
	resizer.MouseLeave:Connect(function()
		if not resizing then
			Motion.fast(resizer, { ImageTransparency = 0.75 })
		end
	end)

	resizer.MouseButton1Down:Connect(function()
		resizing = true
		startMouse = UIS:GetMouseLocation()
		startSize = self.Root.AbsoluteSize
		Motion.fast(resizer, { ImageTransparency = 0 })
	end)

	self.Janitor:Add(UIS.InputChanged:Connect(function(input)
		if not resizing or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local delta = UIS:GetMouseLocation() - startMouse
		local viewport = Compat.GetViewportSize()
		local newWidth = math.clamp(startSize.X + delta.X, self.MinSize.X, viewport.X)
		local newHeight = math.clamp(startSize.Y + delta.Y, self.MinSize.Y, viewport.Y)
		self.Root.Size = UDim2.fromOffset(newWidth, newHeight)
	end))

	self.Janitor:Add(UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and resizing then
			resizing = false
			Motion.fast(resizer, { ImageTransparency = 0.75 })
		end
	end))
end

--==============================================================
-- Перетаскивание
--==============================================================
-- Esc закрывает открытый оверлей настроек
function Window:_setupEscape()
	self.Janitor:Add(UIS.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode ~= Enum.KeyCode.Escape then
			return
		end
		-- Закрываем любую открытую панель, а не только настройки
		for _, overlay in ipairs({ self.SettingsOverlay, self.InfoOverlay, self.CreditsOverlay }) do
			if overlay and overlay.IsOpen then
				overlay:Close()
				return
			end
		end
	end))
end

function Window:_setupDragging()
	local dragging = false
	local dragStart, startPos

	self.Janitor:Add(self.Topbar.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		dragStart = UIS:GetMouseLocation()
		startPos = self.Root.Position

		-- Лёгкий «подъём» окна при захвате
		if self.Shadow then
			local target, prop = self.Shadow:GetTweenTarget()
			Motion.tween(target, { [prop] = 0.2 }, { Duration = Motion.Duration.Fast })
		end
	end))

	self.Janitor:Add(UIS.InputChanged:Connect(function(input)
		if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local delta = UIS:GetMouseLocation() - dragStart
		self.Root.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end))

	self.Janitor:Add(UIS.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if not dragging then
			return
		end
		dragging = false
		if self.Shadow then
			local target, prop = self.Shadow:GetTweenTarget()
			Motion.tween(target, { [prop] = 0.35 }, { Duration = Motion.Duration.Normal })
		end
		self:_clampToScreen()
	end))
end

-- Не даём утащить окно за пределы экрана
function Window:_clampToScreen()
	local viewport = Compat.GetViewportSize()
	local absPos = self.Root.AbsolutePosition
	local absSize = self.Root.AbsoluteSize
	local margin = 40

	local clampedX = math.clamp(absPos.X, -absSize.X + margin, viewport.X - margin)
	local clampedY = math.clamp(absPos.Y, 0, viewport.Y - margin)

	if clampedX ~= absPos.X or clampedY ~= absPos.Y then
		local anchor = self.Root.AnchorPoint
		Motion.tween(self.Root, {
			Position = UDim2.fromOffset(
				clampedX + absSize.X * anchor.X,
				clampedY + absSize.Y * anchor.Y
			),
		}, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Standard,
		})
	end
end

--==============================================================
-- Табы
--==============================================================
--[[
	Создать вкладку.

	Системные вкладки (например встроенные «Настройки») помечаются
	IsSystem: они не получают автофокус и всегда уезжают в конец
	списка, чтобы не оказаться выше пользовательских.
]]
function Window:CreateTab(config)
	if type(config) == "string" then
		config = { Name = config }
	end

	local isSystem = config.System or (self.Library and self.Library._buildingSystemTab) or false
	config.Order = config.Order or (isSystem and 9999 or #self.Tabs + 1)

	local tab = Tab.new(self, config)
	tab.IsSystem = isSystem
	table.insert(self.Tabs, tab)

	if not self.ActiveTab and not isSystem then
		-- Первая пользовательская вкладка становится активной
		self:SelectTab(tab)
	elseif not isSystem and self.ActiveTab and self.ActiveTab.IsSystem then
		-- Системная вкладка держала фокус до появления пользовательской
		self:SelectTab(tab)
	elseif not self.ActiveTab and isSystem and #self.Tabs == 1 then
		-- Системная вкладка единственная — показываем хоть что-то
		self:SelectTab(tab)
	end
	return tab
end

function Window:SelectTab(tab)
	--[[
		Принимаем объект, индекс или имя.
		Важно: если по имени/индексу ничего не нашли, обязательно
		сбрасываем в nil. Иначе дальше вызывался бы tab:_setActive()
		на голой строке и падал с "attempt to call missing method".
	]]
	if type(tab) == "number" then
		tab = self.Tabs[tab]
	elseif type(tab) == "string" then
		local found = nil
		for _, t in ipairs(self.Tabs) do
			if t.Name == tab then
				found = t
				break
			end
		end
		tab = found
	elseif type(tab) ~= "table" then
		tab = nil
	end

	if not tab or tab.Destroyed or tab == self.ActiveTab then
		return
	end

	local previous = self.ActiveTab
	self.ActiveTab = tab

	if previous then
		previous:_setActive(false)
	end
	tab:_setActive(true)

	-- Индикатор переезжает к новой кнопке
	self:_moveIndicator(tab)
	self.TabChanged:Fire(tab, previous)
end

function Window:_moveIndicator(tab)
	if not tab or not tab.Button then
		return
	end
	local button = tab.Button
	local sidebarPos = self.Sidebar.AbsolutePosition.Y
	local buttonPos = button.AbsolutePosition.Y
	local buttonHeight = button.AbsoluteSize.Y
	local targetY = buttonPos - sidebarPos + buttonHeight / 2

	if not self.Indicator.Visible then
		self.Indicator.Visible = true
		self.IndicatorSpring:Snap(targetY)
		self.Indicator.Size = UDim2.fromOffset(3, 0)
		Motion.tween(self.Indicator, { Size = UDim2.fromOffset(3, 20) }, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Overshoot,
		})
	else
		self.IndicatorSpring:SetTarget(targetY)
		-- Индикатор слегка растягивается в движении — эффект «резинки»
		Motion.tween(self.Indicator, { Size = UDim2.fromOffset(3, 28) }, {
			Duration = Motion.Duration.Fast,
			OnComplete = function()
				Motion.tween(self.Indicator, { Size = UDim2.fromOffset(3, 20) }, {
					Duration = Motion.Duration.Normal,
					Easing = Motion.Easing.Overshoot,
				})
			end,
		})
	end
end

--==============================================================
-- Видимость
--==============================================================
function Window:Minimize()
	self.Minimized = true
	local scale = self.Root:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = create("UIScale", { Parent = self.Root })
	end
	Motion.tween(scale, { Scale = 0.85 }, {
		Duration = Motion.Duration.Normal,
		Easing = Motion.Easing.Accelerate,
	})
	Motion.tween(self.Root, { BackgroundTransparency = 1 }, {
		Duration = Motion.Duration.Normal,
		OnComplete = function()
			if self.Minimized then
				self.ScreenGui.Enabled = false
			end
		end,
	})
	self.VisibilityChanged:Fire(false)
end

function Window:Restore()
	self.Minimized = false
	self.ScreenGui.Enabled = true
	local scale = self.Root:FindFirstChildOfClass("UIScale")
	if scale then
		Motion.tween(scale, { Scale = 1 }, {
			Duration = Motion.Duration.Slower,
			Easing = Motion.Easing.Overshoot,
		})
	end
	Motion.tween(self.Root, { BackgroundTransparency = 0 }, {
		Duration = Motion.Duration.Normal,
	})
	self.VisibilityChanged:Fire(true)
end

function Window:Toggle()
	if self.Minimized then
		self:Restore()
	else
		self:Minimize()
	end
end

function Window:Close()
	local scale = self.Root:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = create("UIScale", { Parent = self.Root })
	end
	Motion.tween(scale, { Scale = 0.9 }, {
		Duration = Motion.Duration.Normal,
		Easing = Motion.Easing.Accelerate,
	})
	Motion.tween(self.Root, { BackgroundTransparency = 1 }, {
		Duration = Motion.Duration.Normal,
		OnComplete = function()
			self:Destroy()
		end,
	})
	self.Closed:Fire()
end

function Window:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true

	for _, tab in ipairs(self.Tabs) do
		tab:Destroy()
	end
	for _, overlay in ipairs({ self.SettingsOverlay, self.InfoOverlay, self.CreditsOverlay }) do
		if overlay then
			overlay:Destroy()
		end
	end
	if self.IndicatorDriver then
		self.IndicatorDriver:Stop()
	end
	if self.SidebarDriver then
		self.SidebarDriver:Stop()
	end
	if self.ContentDriver then
		self.ContentDriver:Stop()
	end
	if self.ContentSizeDriver then
		self.ContentSizeDriver:Stop()
	end
	self.Janitor:Clean()
	self.TabChanged:Destroy()
	self.Closed:Destroy()
	self.VisibilityChanged:Destroy()
end

--==============================================================
-- Прокси к библиотеке
--==============================================================
--[[
	Чтобы работали оба стиля:
	    Swagga:Notify{...}
	    Window:Notify{...}
	Так короче, если ссылку на Swagga не сохранили в переменную.
]]
function Window:Notify(config)
	if self.Library and self.Library.Notify then
		return self.Library:Notify(config)
	end
	return nil
end

function Window:Get(flag)
	return self.Library and self.Library:Get(flag) or nil
end

function Window:Set(flag, value)
	if self.Library then
		return self.Library:Set(flag, value)
	end
	return false
end

function Window:SaveConfig(name)
	return self.Library and self.Library:SaveConfig(name) or false
end

function Window:LoadConfig(name)
	return self.Library and self.Library:LoadConfig(name) or false
end

function Window:SetTheme(name)
	return self.Library and self.Library:SetTheme(name)
end

function Window:SetAccent(color)
	return self.Library and self.Library:SetAccent(color)
end

function Window:Search(query)
	return self.Library and self.Library:Search(query) or {}
end

function Window:SetTitle(text)
	self.Name = text
	self.TitleLabel.Text = text
end

function Window:SetSubtitle(text)
	self.Subtitle = text
	if self.SubtitleLabel then
		self.SubtitleLabel.Text = text
	end
end

return Window
end

__swagga_modules["elements/Button"] = function()

--[[
	Button — обычная кнопка действия.

	Особенность: ripple-эффект от точки клика. Круг расширяется
	из-под курсора и растворяется — это самый читаемый отклик
	на нажатие, привычный по мобильным интерфейсам.
]]

local Element = __swagga_require("Element")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Icons = __swagga_require("Icons")
local Compat = __swagga_require("Compat")

local create = Util.create
local UIS = Compat.Services.Input

local Button = setmetatable({}, { __index = Element })
Button.__index = Button

function Button.new(tab, config)
	config = config or {}
	local self = Element.new(tab, config, "button")
	setmetatable(self, Button)

	self.Value = nil
	self.Style = config.Style or "default" -- default | primary | danger

	self:_buildControl(config)

	if config.Keybind then
		self:SetKeybind(config.Keybind, config.KeybindMode)
	end

	tab:_register(self)
	return self
end

function Button:_buildControl(config)
	-- Стрелка справа — намёк, что элемент кликабельный
	local arrow = create("ImageLabel", {
		Name = "Arrow",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = 0.6,
		ZIndex = 4,
		Parent = self.Frame,
	})
	Icons.apply(arrow, config.ActionIcon or "chevron-right")
	Theme.bind(arrow, "ImageColor3", "TextSecondary")
	self.Arrow = arrow

	-- Акцентная заливка для primary/danger
	if self.Style == "primary" or self.Style == "danger" then
		local token = self.Style == "danger" and "Danger" or "Accent"
		Theme.bind(self.Frame, "BackgroundColor3", token, function(c)
			return c:Lerp(Theme.get("Background"), 0.72)
		end)
		Theme.bind(self.Title, "TextColor3", token, function(c)
			return Util.shift(c, 0.25)
		end)
		Theme.bind(arrow, "ImageColor3", token)
	end

	self.Janitor:Add(self.HitArea.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		self:Trigger()
	end))

	-- Ripple от точки нажатия
	self.Janitor:Add(self.HitArea.MouseButton1Down:Connect(function()
		if not self.Enabled then
			return
		end
		self:_ripple()
		Motion.tween(self.Arrow, { Position = UDim2.new(1, -Element.PADDING_X + 3, 0.5, 0) }, {
			Duration = Motion.Duration.Micro,
		})
	end))

	self.Janitor:Add(self.HitArea.MouseButton1Up:Connect(function()
		Motion.tween(self.Arrow, { Position = UDim2.new(1, -Element.PADDING_X, 0.5, 0) }, {
			Duration = Motion.Duration.Normal,
			Easing = Motion.Easing.Overshoot,
		})
	end))
end

function Button:OnHover(hovering)
	if not self.Arrow then
		return
	end
	Motion.fast(self.Arrow, {
		ImageTransparency = hovering and 0.15 or 0.6,
	})
	-- Стрелка выезжает вправо на ховере
	Motion.tween(self.Arrow, {
		Position = UDim2.new(1, -Element.PADDING_X + (hovering and 2 or 0), 0.5, 0),
	}, { Duration = Motion.Duration.Normal, Easing = Motion.Easing.Standard })
end

--[[
	Ripple: круг из точки клика.
	Размер берём с запасом (диагональ карточки), чтобы волна
	гарантированно накрыла её целиком.
]]
function Button:_ripple()
	local frame = self.Frame
	local mouse = UIS:GetMouseLocation()
	local absPos = frame.AbsolutePosition
	local absSize = frame.AbsoluteSize

	local localX = mouse.X - absPos.X
	local localY = mouse.Y - absPos.Y

	-- Максимальное расстояние от точки клика до угла
	local maxDist = math.max(
		math.sqrt(localX ^ 2 + localY ^ 2),
		math.sqrt((absSize.X - localX) ^ 2 + localY ^ 2),
		math.sqrt(localX ^ 2 + (absSize.Y - localY) ^ 2),
		math.sqrt((absSize.X - localX) ^ 2 + (absSize.Y - localY) ^ 2)
	)
	local targetSize = maxDist * 2

	local ripple = create("Frame", {
		Name = "Ripple",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(localX, localY),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Theme.get("Accent"),
		BackgroundTransparency = 0.75,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = frame,
	}, {
		Util.corner(9999),
	})

	Motion.tween(ripple, {
		Size = UDim2.fromOffset(targetSize, targetSize),
		BackgroundTransparency = 1,
	}, {
		Duration = Motion.Duration.Slower,
		Easing = Motion.Easing.Decelerate,
		OnComplete = function()
			if ripple then
				ripple:Destroy()
			end
		end,
	})
end

function Button:Trigger()
	-- Короткое «нажатие» карточки
	Motion.press(self.Frame, 0.985)
	task.delay(0.08, function()
		if not self.Destroyed then
			Motion.release(self.Frame)
		end
	end)

	if self.Callback then
		task.spawn(self.Callback)
	end
	self.Changed:Fire()
	return self
end

Button.Fire = Button.Trigger

function Button:Set()
	-- У кнопки нет значения; метод есть ради единообразия API
	return self
end

function Button:Get()
	return nil
end

return Button
end

__swagga_modules["elements/ColorPicker"] = function()

--[[
	ColorPicker — профессиональная палитра.

	Состав (раскрывается push-анимацией, как дропдаун):
	  • HSV-квадрат: по X — насыщенность, по Y — яркость
	  • Полоса оттенка (hue) с радужным градиентом
	  • Полоса альфы (опционально) с шахматной подложкой
	  • Поля HEX и RGB с валидацией ввода
	  • Ряд пресетов + кнопка «сохранить текущий»
	  • Режим Rainbow: цвет плавно едет по кругу оттенков

	Почему квадрат, а не колесо: прямоугольная область точнее
	мапится на курсор и не требует тригонометрии на каждый кадр.
]]

local Element = __swagga_require("Element")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")

local Compat = __swagga_require("Compat")

local create = Util.create
local UIS = Compat.Services.Input
local RunService = Compat.Services.Run

local ColorPicker = setmetatable({}, { __index = Element })
ColorPicker.__index = ColorPicker

local SQUARE_HEIGHT = 92
local BAR_HEIGHT = 12
local ROW_GAP = 8
local PAD = 12
local SWATCH_SIZE = 18

-- Быстрые пресеты
--[[
	Пресеты подобраны как приглушённая палитра, а не «кислота»:
	чистые #FF0000-подобные цвета на тёмном фоне выглядят дёшево
	и режут глаз.
]]
local DEFAULT_PRESETS = {
	"D0455A", "D9814B", "C99A4B", "4CAF7D", "00A77E",
	"55A8D8", "4A7FC4", "5B62D6", "A052E0", "C4568A",
	"E8E8E8", "8A8F98",
}

function ColorPicker.new(tab, config)
	config = config or {}
	local self = Element.new(tab, config, "colorpicker")
	setmetatable(self, ColorPicker)

	self.Default = config.Default or config.CurrentColor or Color3.fromRGB(0, 167, 126)
	self.Value = self.Default
	self.UseAlpha = config.Alpha or config.Transparency or false
	self.Alpha = config.DefaultAlpha or 1
	self.AllowRainbow = config.Rainbow ~= false
	self.RainbowActive = false
	self.Open = false

	local h, s, v = self.Value:ToHSV()
	self.Hue, self.Sat, self.Val = h, s, v

	self.Presets = config.Presets or DEFAULT_PRESETS

	self:_buildControl()
	self:_updateAll(true)

	tab:_register(self)
	return self
end

--==============================================================
-- Шапка
--==============================================================
function ColorPicker:_buildControl()
	--[[
		Кнопка-превью и HEX привязаны к ВЕРХУ карточки.

		Раньше стояли по центру (Scale 0.5): при раскрытии панель
		вырастала до 224px и превью оказывалось ровно посреди
		палитры, поверх HSV-квадрата. Теперь остаётся в шапке.
	]]
	local headerY = self.HeaderY or (Element.DEFAULT_HEIGHT / 2)

	-- Превью текущего цвета
	local preview = create("TextButton", {
		Name = "Preview",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X, 0, headerY),
		Size = UDim2.fromOffset(38, 20),
		BackgroundColor3 = self.Value,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		-- Выше содержимого панели: превью всегда поверх палитры
		ZIndex = 20,
		Parent = self.Frame,
	}, {
		Util.corner(6),
	})
	self.Preview = preview

	local previewStroke = Util.stroke(Theme.get("Stroke"), 1, 0.2)
	if previewStroke then
		previewStroke.Parent = preview
		Theme.bind(previewStroke, "Color", "Stroke")
	end

	self.PreviewGlow = Util.glow(preview, self.Value, { Blur = 10, Transparency = 0.6 })

	-- HEX рядом с превью
	local hexLabel = create("TextLabel", {
		Name = "HexLabel",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X - 46, 0, headerY),
		Size = UDim2.fromOffset(66, 16),
		Font = Enum.Font.Code,
		Text = "#000000",
		TextSize = 11,
		TextTransparency = 0.45,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 20,
		Parent = self.Frame,
	})
	Theme.bind(hexLabel, "TextColor3", "TextSecondary")
	self.HexLabel = hexLabel

	self.HitArea.Size = UDim2.new(1, 0, 0, self.BaseHeight)

	self.Janitor:Add(self.HitArea.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		self:Toggle()
	end))

	self.Janitor:Add(preview.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		self:Toggle()
	end))

	self:_buildPanel()
end

--==============================================================
-- Раскрывающаяся панель
--==============================================================
function ColorPicker:_buildPanel()
	local holder = create("Frame", {
		Name = "Panel",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, self.BaseHeight),
		Size = UDim2.new(1, 0, 0, 0),
		ClipsDescendants = true,
		ZIndex = 4,
		Parent = self.Frame,
	})
	self.Panel = holder

	local divider = create("Frame", {
		Position = UDim2.new(0, PAD, 0, 0),
		Size = UDim2.new(1, -PAD * 2, 0, 1),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = holder,
	}, {
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0),
				NumberSequenceKeypoint.new(0.8, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	Theme.bind(divider, "BackgroundColor3", "Divider")
	self.PanelDivider = divider

	local y = ROW_GAP

	--[[
		HSV-квадрат. Три слоя строго в этом порядке:
		  1. база      — чистый оттенок Color3.fromHSV(hue, 1, 1)
		  2. белый     — слева направо, прозрачность 0 → 1 (насыщенность)
		  3. чёрный    — сверху вниз, прозрачность 1 → 0 (яркость)

		Раньше градиент насыщенности висел на самом квадрате, из-за чего
		он менял прозрачность БАЗЫ, а не накладывал белый сверху —
		цвета выглядели выцветшими и неправильными.
	]]
	local square = create("ImageButton", {
		Name = "Square",
		Position = UDim2.new(0, PAD, 0, y),
		Size = UDim2.new(1, -PAD * 2 - 26, 0, SQUARE_HEIGHT),
		BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Image = "",
		ImageTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 5,
		Parent = holder,
	}, {
		Util.corner(6),
