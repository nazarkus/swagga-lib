		Blur = opts.Blur or 18,
		Color = color,
		Transparency = opts.Transparency or 0.55,
		OffsetX = 0,
		OffsetY = 0,
		Spread = opts.Spread or 0,
		ZIndex = opts.ZIndex or -1,
	})
end

--==============================================================
-- Цвета
--==============================================================
function Util.hex(hexStr: string): Color3
	hexStr = tostring(hexStr):gsub("#", "")
	return Color3.fromRGB(
		tonumber(hexStr:sub(1, 2), 16) or 0,
		tonumber(hexStr:sub(3, 4), 16) or 0,
		tonumber(hexStr:sub(5, 6), 16) or 0
	)
end

function Util.toHex(color: Color3): string
	return ("%02X%02X%02X"):format(
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- Осветлить / затемнить (положительный amount = светлее)
function Util.shift(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), amount)
	end
	return color:Lerp(Color3.new(0, 0, 0), -amount)
end

function Util.luminance(color: Color3): number
	return 0.2126 * color.R + 0.7152 * color.G + 0.0722 * color.B
end

-- Контрастный текст поверх произвольного фона
function Util.contrastText(bg: Color3): Color3
	return Util.luminance(bg) > 0.55 and Color3.fromRGB(20, 20, 20) or Color3.fromRGB(255, 255, 255)
end

--==============================================================
-- Прочее
--==============================================================
function Util.round(n: number, decimals: number?): number
	local mult = 10 ^ (decimals or 0)
	return math.floor(n * mult + 0.5) / mult
end

function Util.clamp(n: number, min: number, max: number): number
	return math.max(min, math.min(max, n))
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Проверка: точка внутри прямоугольника GuiObject
function Util.isInside(gui: Instance, position: Vector2): boolean
	local pos = gui.AbsolutePosition
	local size = gui.AbsoluteSize
	return position.X >= pos.X
		and position.X <= pos.X + size.X
		and position.Y >= pos.Y
		and position.Y <= pos.Y + size.Y
end

--==============================================================
-- Работа с текстом (UTF-8)
--==============================================================
--[[
	Стандартные string.upper/lower/%w в Lua работают только с ASCII.
	Для кириллицы они молча ничего не делают, из-за чего:
	  • «Настройки» не поднимался в верхний регистр
	  • slug() возвращал пустую строку → все русские элементы
	    получали одинаковый флаг и перетирали друг другу конфиг
	  • поиск не находил по русскому запросу
	Поэтому — свои реализации поверх utf8.
]]

-- Кириллица в Unicode: А-Я = 1040..1071, а-я = 1072..1103, Ё = 1025, ё = 1105
local function upperCodepoint(cp: number): number
	if cp >= 97 and cp <= 122 then -- a-z
		return cp - 32
	elseif cp >= 1072 and cp <= 1103 then -- а-я
		return cp - 32
	elseif cp == 1105 then -- ё
		return 1025
	end
	return cp
end

local function lowerCodepoint(cp: number): number
	if cp >= 65 and cp <= 90 then -- A-Z
		return cp + 32
	elseif cp >= 1040 and cp <= 1071 then -- А-Я
		return cp + 32
	elseif cp == 1025 then -- Ё
		return 1105
	end
	return cp
end

local function mapCodepoints(text: string, mapper): string
	if not utf8 then
		return text
	end
	local ok, result = pcall(function()
		local out = {}
		for _, cp in utf8.codes(text) do
			out[#out + 1] = utf8.char(mapper(cp))
		end
		return table.concat(out)
	end)
	return ok and result or text
end

function Util.upper(text: string): string
	return mapCodepoints(tostring(text), upperCodepoint)
end

function Util.lower(text: string): string
	return mapCodepoints(tostring(text), lowerCodepoint)
end

-- Длина в символах, а не байтах
function Util.len(text: string): number
	if utf8 then
		local ok, count = pcall(utf8.len, text)
		if ok and count then
			return count
		end
	end
	return #tostring(text)
end

-- Обрезка по символам, чтобы не разорвать многобайтовый символ
function Util.sub(text: string, from: number, to: number?): string
	text = tostring(text)
	if not utf8 then
		return text:sub(from, to)
	end
	local ok, result = pcall(function()
		local length = utf8.len(text)
		if not length then
			return text:sub(from, to)
		end
		to = math.min(to or length, length)
		if from > to then
			return ""
		end
		local startByte = utf8.offset(text, from)
		local endByte = to < length and (utf8.offset(text, to + 1) - 1) or #text
		return text:sub(startByte, endByte)
	end)
	return ok and result or text
end

-- Регистронезависимый поиск подстроки (работает с кириллицей)
function Util.contains(haystack: string, needle: string): boolean
	return Util.lower(haystack):find(Util.lower(needle), 1, true) ~= nil
end

--[[
	Безопасный ключ для сохранения.
	Кириллица не проходит через %w, поэтому непонятные символы
	кодируем их кодовой точкой — ключ остаётся уникальным и стабильным.
]]
function Util.slug(text: string): string
	text = tostring(text)
	local out = {}

	if utf8 then
		local ok = pcall(function()
			for _, cp in utf8.codes(text) do
				if (cp >= 48 and cp <= 57) -- 0-9
					or (cp >= 65 and cp <= 90) -- A-Z
					or (cp >= 97 and cp <= 122) then -- a-z
					out[#out + 1] = string.char(cp)
				elseif cp > 127 then
					-- Кириллица и прочий Unicode → устойчивый код
					out[#out + 1] = "u" .. tostring(cp)
				end
			end
		end)
		if ok and #out > 0 then
			return table.concat(out)
		end
	end

	local fallback = text:gsub("[^%w]", "")
	if fallback ~= "" then
		return fallback
	end
	-- Совсем ничего не осталось — хешируем байты
	local hash = 0
	for i = 1, #text do
		hash = (hash * 31 + text:byte(i)) % 2147483647
	end
	return "h" .. tostring(hash)
end

--[[
	Глубокая копия.
	Используем typeof(), а не type(): Color3, UDim2, Vector2 и прочие
	Roblox-типы копировать нельзя — они неизменяемы и должны
	передаваться как есть. С type() они бы превратились в
	обычные таблицы и потеряли методы (:Lerp, :ToHSV и т.д.).
]]
function Util.deepCopy(tbl)
	if typeof(tbl) ~= "table" then
		return tbl
	end
	local out = {}
	for k, v in pairs(tbl) do
		out[k] = typeof(v) == "table" and Util.deepCopy(v) or v
	end
	return out
end

function Util.tableContains(tbl, value): boolean
	for _, v in ipairs(tbl) do
		if v == value then
			return true
		end
	end
	return false
end

function Util.indexOf(tbl, value): number?
	for i, v in ipairs(tbl) do
		if v == value then
			return i
		end
	end
	return nil
end

--==============================================================
-- Управление соединениями (защита от утечек)
--==============================================================
local Janitor = {}
Janitor.__index = Janitor

function Util.janitor()
	return setmetatable({ _items = {} }, Janitor)
end

function Janitor:Add(item)
	table.insert(self._items, item)
	return item
end

function Janitor:Clean()
	for i = #self._items, 1, -1 do
		local item = self._items[i]
		if type(item) == "function" then
			pcall(item)
		elseif type(item) == "table" and item.Disconnect then
			pcall(function()
				item:Disconnect()
			end)
		elseif type(item) == "table" and item.Destroy then
			pcall(function()
				item:Destroy()
			end)
		elseif typeof(item) == "Instance" then
			pcall(function()
				item:Destroy()
			end)
		elseif typeof(item) == "RBXScriptConnection" then
			pcall(function()
				item:Disconnect()
			end)
		end
		self._items[i] = nil
	end
end

Janitor.Destroy = Janitor.Clean

return Util
end

__swagga_modules["Window"] = function()

--[[
	Window — корневое окно библиотеки.

	Структура:
		ScreenGui
		└── Root (Frame, скругление 15, тень)
			├── Topbar          логотип, название, версия, кнопки справа
			│   └── GlowLine    градиентная линия под топбаром
			├── Sidebar         список табов (сворачиваемый)
			│   ├── Collapse    кнопка сворачивания
			│   ├── TabList     ScrollingFrame с кнопками табов
			│   └── Indicator   скользящая «пилюля» активного таба
			├── Content         контейнер страниц табов
			├── MorePanel       выпадающее меню (Settings/Info/Credits)
			└── Resizer         уголок изменения размера

	Ключевые решения:
	  • Сайдбар сворачивается пружиной, ширина драйвится Motion.spring —
	    поэтому анимация не «дёргается», если кликнуть дважды подряд.
	  • Индикатор активного таба — единый элемент, который переезжает
