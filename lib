		Size = size,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = parent,
	}, {
		Util.corner(5),
	})
	Theme.bind(box, "BackgroundColor3", "ElementActive")

	local tag = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, 0),
		Size = UDim2.fromOffset(24, 12),
		Font = Enum.Font.GothamMedium,
		Text = label,
		TextSize = 9,
		TextTransparency = 0.6,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = box,
	})
	Theme.bind(tag, "TextColor3", "TextMuted")

	local input = create("TextBox", {
		Name = "Input",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 30, 0, 0),
		Size = UDim2.new(1, -34, 1, 0),
		Font = Enum.Font.Code,
		Text = "",
		TextSize = 10,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		ZIndex = 6,
		Parent = box,
	})
	Theme.bind(input, "TextColor3", "TextPrimary")

	input.FocusLost:Connect(function()
		self:_parseInput(label, input.Text)
	end)

	return { Box = box, Input = input, Tag = tag }
end

function ColorPicker:_makeSwatch(parent, hexColor, index)
	local color = Util.hex(hexColor)
	local swatch = create("TextButton", {
		Name = "Swatch" .. index,
		Size = UDim2.fromOffset(SWATCH_SIZE, SWATCH_SIZE),
		BackgroundColor3 = color,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = index,
		ZIndex = 6,
		Parent = parent,
	}, {
		Util.corner(5),
	})

	swatch.MouseEnter:Connect(function()
		Motion.tween(swatch, { Size = UDim2.fromOffset(SWATCH_SIZE + 3, SWATCH_SIZE + 3) }, {
			Duration = Motion.Duration.Fast,
			Easing = Motion.Easing.Overshoot,
		})
	end)
	swatch.MouseLeave:Connect(function()
		Motion.tween(swatch, { Size = UDim2.fromOffset(SWATCH_SIZE, SWATCH_SIZE) }, {
			Duration = Motion.Duration.Normal,
		})
	end)
	swatch.Activated:Connect(function()
		self:SetRainbow(false)
		self:Set(color)
	end)

	table.insert(self.PresetSwatches, swatch)
	return swatch
end

--==============================================================
-- Ввод HEX / RGB
--==============================================================
function ColorPicker:_parseInput(kind, text)
	text = tostring(text):gsub("%s", "")
	local color

	if kind == "HEX" then
		local clean = text:gsub("#", "")
		if #clean == 3 then
			-- Короткая запись #ABC → #AABBCC
			clean = clean:sub(1, 1):rep(2) .. clean:sub(2, 2):rep(2) .. clean:sub(3, 3):rep(2)
		end
		if #clean == 6 and clean:match("^%x+$") then
			color = Util.hex(clean)
		end
	else
		-- (-?%d+) — иначе "999,-50,300" не распознавалось целиком
		-- и минус ломал разбор всей строки.
		local r, g, b = text:match("(-?%d+),(-?%d+),(-?%d+)")
		if r then
			color = Color3.fromRGB(
				math.clamp(tonumber(r) or 0, 0, 255),
				math.clamp(tonumber(g) or 0, 0, 255),
				math.clamp(tonumber(b) or 0, 0, 255)
			)
		end
	end

	if color then
		self:SetRainbow(false)
		self:Set(color)
	else
		-- Невалидный ввод — вернуть текущее значение
		self:_updateInputs()
	end
end

--==============================================================
-- Перетаскивание по квадрату / полосам
--==============================================================
function ColorPicker:_setupDragging()
	if self._dragSetup then
		return
	end
	self._dragSetup = true

	local dragTarget = nil

	local function updateSquare()
		local pos = UIS:GetMouseLocation()
		local abs = self.Square.AbsolutePosition
		local size = self.Square.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		self.Sat = math.clamp((pos.X - abs.X) / size.X, 0, 1)
		self.Val = 1 - math.clamp((pos.Y - abs.Y) / size.Y, 0, 1)
		self:SetRainbow(false)
		self:_applyHSV()
	end

	local function updateHue()
		local pos = UIS:GetMouseLocation()
		local abs = self.HueBar.AbsolutePosition
		local size = self.HueBar.AbsoluteSize
		if size.Y <= 0 then
			return
		end
		self.Hue = math.clamp((pos.Y - abs.Y) / size.Y, 0, 1)
		self:SetRainbow(false)
		self:_applyHSV()
	end

	local function updateAlpha()
		local pos = UIS:GetMouseLocation()
		local abs = self.AlphaBar.AbsolutePosition
		local size = self.AlphaBar.AbsoluteSize
		if size.X <= 0 then
			return
		end
		self.Alpha = math.clamp((pos.X - abs.X) / size.X, 0, 1)
		self:_updateAlphaVisual()
		self:_fire()
	end

	self.Janitor:Add(self.Square.MouseButton1Down:Connect(function()
		dragTarget = "square"
		updateSquare()
	end))

	self.Janitor:Add(self.HueBar.MouseButton1Down:Connect(function()
		dragTarget = "hue"
		updateHue()
	end))

	if self.AlphaBar then
		self.Janitor:Add(self.AlphaBar.MouseButton1Down:Connect(function()
			dragTarget = "alpha"
			updateAlpha()
		end))
	end

	self.Janitor:Add(UIS.InputChanged:Connect(function(input)
		if not dragTarget then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if dragTarget == "square" then
			updateSquare()
		elseif dragTarget == "hue" then
			updateHue()
		elseif dragTarget == "alpha" then
			updateAlpha()
		end
	end))

	self.Janitor:Add(UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragTarget = nil
		end
	end))
end

--==============================================================
-- Обновление визуала
--==============================================================
function ColorPicker:_applyHSV()
	self.Value = Color3.fromHSV(self.Hue, self.Sat, self.Val)
	self:_updateAll(false)
	self:_fire()
end

function ColorPicker:_updateAll(immediate)
	local color = self.Value
	local duration = immediate and 0 or Motion.Duration.Fast

	-- Превью
	Motion.tween(self.Preview, { BackgroundColor3 = color }, { Duration = duration })
	if self.PreviewGlow then
		self.PreviewGlow:SetColor(color)
	end

	-- HEX-подпись
	self.HexLabel.Text = "#" .. Util.toHex(color)

	-- Квадрат: фон = чистый оттенок
	if self.Square then
		Motion.tween(self.Square, { BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1) }, {
			Duration = duration,
		})
	end

	-- Курсоры
	if self.SquareCursor then
		local target = UDim2.new(self.Sat, 0, 1 - self.Val, 0)
		if immediate then
			self.SquareCursor.Position = target
		else
			Motion.tween(self.SquareCursor, { Position = target }, {
				Duration = Motion.Duration.Micro,
			})
		end
		-- Курсор контрастен фону
		local ring = self.SquareCursor:FindFirstChildOfClass("UIStroke")
		if ring then
			ring.Color = self.Val > 0.6 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
		end
	end

	if self.HueCursor then
		local target = UDim2.new(0.5, 0, self.Hue, 0)
		if immediate then
			self.HueCursor.Position = target
		else
			Motion.tween(self.HueCursor, { Position = target }, {
				Duration = Motion.Duration.Micro,
			})
		end
	end

	self:_updateAlphaVisual()
	self:_updateInputs()
end

function ColorPicker:_updateAlphaVisual()
	if not self.UseAlpha or not self.AlphaFill then
		return
	end
	self.AlphaFill.BackgroundColor3 = self.Value
	if self.AlphaCursor then
		self.AlphaCursor.Position = UDim2.new(self.Alpha, 0, 0.5, 0)
	end
end

function ColorPicker:_updateInputs()
	if self.HexInput then
		self.HexInput.Input.Text = Util.toHex(self.Value)
	end
	if self.RgbInput then
		self.RgbInput.Input.Text = ("%d,%d,%d"):format(
			math.floor(self.Value.R * 255 + 0.5),
			math.floor(self.Value.G * 255 + 0.5),
			math.floor(self.Value.B * 255 + 0.5)
		)
	end
end

--==============================================================
-- Rainbow
--==============================================================
function ColorPicker:SetRainbow(enabled)
	if enabled == self.RainbowActive then
		return
	end
	self.RainbowActive = enabled

	if self.RainbowButton then
		Motion.tween(self.RainbowButton, {
			BackgroundTransparency = enabled and 0 or 1,
			TextTransparency = enabled and 0 or 0.3,
		}, { Duration = Motion.Duration.Normal })
		if self.RainbowGradient then
			self.RainbowGradient.Enabled = enabled
		end
	end

	if enabled then
		local signal = RunService and (RunService.RenderStepped or RunService.Heartbeat)
		if not signal then
			return
		end
		self._rainbowConn = signal:Connect(function(dt)
			if not self.RainbowActive or self.Destroyed then
				return
			end
			self.Hue = (self.Hue + dt * 0.18) % 1
			self.Value = Color3.fromHSV(self.Hue, self.Sat, self.Val)
			self.Preview.BackgroundColor3 = self.Value
			self.HexLabel.Text = "#" .. Util.toHex(self.Value)
			if self.Square then
				self.Square.BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1)
			end
			if self.HueCursor then
				self.HueCursor.Position = UDim2.new(0.5, 0, self.Hue, 0)
			end
			if self.PreviewGlow then
				self.PreviewGlow:SetColor(self.Value)
			end
			self:_fire()
		end)
		self.Janitor:Add(self._rainbowConn)
	elseif self._rainbowConn then
		self._rainbowConn:Disconnect()
		self._rainbowConn = nil
	end
end

--==============================================================
-- Раскрытие
--==============================================================
function ColorPicker:Toggle(force)
	local open = force
	if open == nil then
		open = not self.Open
	end
	if open == self.Open then
		return
	end
	self.Open = open

	if open then
		self:_setupDragging()

		self:CloseOtherPanels()

		Motion.tween(self.Panel, { Size = UDim2.new(1, 0, 0, self.PanelHeight) }, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Standard,
		})
		self:SetHeight(self.BaseHeight + self.PanelHeight, true)

		Motion.tween(self.PanelDivider, { BackgroundTransparency = 0.4 }, {
			Duration = Motion.Duration.Normal,
		})

		-- Каскад: квадрат → полосы → поля → пресеты
		self.Square.BackgroundTransparency = 1
		Motion.tween(self.Square, { BackgroundTransparency = 0 }, {
			Duration = Motion.Duration.Normal,
			Delay = 0.04,
		})
		self.SatLayer.BackgroundTransparency = 1
		Motion.tween(self.SatLayer, { BackgroundTransparency = 0 }, {
			Duration = Motion.Duration.Normal,
			Delay = 0.04,
		})
		self.ValueLayer.BackgroundTransparency = 1
		Motion.tween(self.ValueLayer, { BackgroundTransparency = 0 }, {
			Duration = Motion.Duration.Normal,
			Delay = 0.04,
		})
		Motion.tween(self.HueBar, { BackgroundTransparency = 0 }, {
			Duration = Motion.Duration.Normal,
			Delay = 0.07,
		})
		if self.AlphaBar then
			Motion.tween(self.AlphaBar, { ImageTransparency = 0.85, BackgroundTransparency = 0 }, {
				Duration = Motion.Duration.Normal,
				Delay = 0.09,
			})
		end

		for _, field in ipairs({ self.HexInput, self.RgbInput }) do
			if field then
				Motion.tween(field.Box, { BackgroundTransparency = 0 }, {
					Duration = Motion.Duration.Normal,
					Delay = 0.11,
				})
				Motion.tween(field.Input, { TextTransparency = 0 }, {
					Duration = Motion.Duration.Normal,
					Delay = 0.13,
				})
				Motion.tween(field.Tag, { TextTransparency = 0.6 }, {
					Duration = Motion.Duration.Normal,
					Delay = 0.13,
				})
			end
		end

		Motion.stagger(self.PresetSwatches, 0.018, function(swatch, index, delayTime)
			swatch.BackgroundTransparency = 1
			Motion.tween(swatch, { BackgroundTransparency = 0 }, {
				Duration = Motion.Duration.Normal,
				Delay = 0.14 + delayTime,
			})
		end)
	else
		Motion.tween(self.Panel, { Size = UDim2.new(1, 0, 0, 0) }, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Standard,
		})
		self:SetHeight(self.BaseHeight, true)
		Motion.tween(self.PanelDivider, { BackgroundTransparency = 1 }, {
			Duration = Motion.Duration.Fast,
		})

		for _, obj in ipairs({ self.Square, self.SatLayer, self.ValueLayer, self.HueBar, self.AlphaBar }) do
			if obj then
				Motion.tween(obj, { BackgroundTransparency = 1 }, { Duration = Motion.Duration.Fast })
			end
		end
		for _, field in ipairs({ self.HexInput, self.RgbInput }) do
			if field then
				Motion.tween(field.Box, { BackgroundTransparency = 1 }, { Duration = Motion.Duration.Fast })
				Motion.tween(field.Input, { TextTransparency = 1 }, { Duration = Motion.Duration.Fast })
				Motion.tween(field.Tag, { TextTransparency = 1 }, { Duration = Motion.Duration.Fast })
			end
		end
		for _, swatch in ipairs(self.PresetSwatches) do
			Motion.tween(swatch, { BackgroundTransparency = 1 }, { Duration = Motion.Duration.Fast })
		end
	end
end

--==============================================================
-- API
--==============================================================
function ColorPicker:_fire()
	if self.Callback then
		task.spawn(self.Callback, self.Value, self.Alpha)
	end
	self.Changed:Fire(self.Value, self.Alpha)
	self:_save()
end

function ColorPicker:Set(color, skipCallback)
	if typeof(color) ~= "Color3" then
		return self
	end
	self.Value = color
	self.Hue, self.Sat, self.Val = color:ToHSV()
	self:_updateAll(false)
	if not skipCallback then
		self:_fire()
	else
		self:_save()
	end
	return self
end

function ColorPicker:SetWithAlpha(color, alpha, skipCallback)
	self.Alpha = math.clamp(alpha or 1, 0, 1)
	return self:Set(color, skipCallback)
end

function ColorPicker:Get()
	return self.Value
end

function ColorPicker:GetAlpha()
	return self.Alpha
end

function ColorPicker:Destroy()
	self:SetRainbow(false)
	Element.Destroy(self)
end

return ColorPicker
end

__swagga_modules["elements/Dropdown"] = function()

--[[
	Dropdown — выпадающий список.

	Как просил пользователь:
	  • раскрывается ВНИЗ и физически раздвигает элементы под собой
	    (меняем высоту самой карточки → UIListLayout двигает соседей)
	  • анимация «достаточно медленная» — 0.42s по умолчанию
	  • опции появляются каскадом (stagger)
	  • multi-select включается на уровне конкретной функции (MultiSelect = true)
	  • поиск появляется автоматически, если опций больше порога
	  • галочки у выбранных пунктов

	Техника push-анимации:
	  Карточка имеет ClipsDescendants = true. Высота твинится от
	  BaseHeight до BaseHeight + высота списка. Список нарисован
	  ниже шапки, поэтому «выползает» из-под неё.
]]

local Element = __swagga_require("Element")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Icons = __swagga_require("Icons")

local create = Util.create

local Dropdown = setmetatable({}, { __index = Element })
Dropdown.__index = Dropdown

local OPTION_HEIGHT = 30
local SEARCH_HEIGHT = 30
local LIST_PADDING = 6
local MAX_VISIBLE = 6 -- дальше список сам скроллится
local SEARCH_THRESHOLD = 8 -- поиск включается от этого числа опций

function Dropdown.new(tab, config)
	config = config or {}
	local self = Element.new(tab, config, "dropdown")
	setmetatable(self, Dropdown)

	self.Options = config.Options or {}
	self.MultiSelect = config.MultiSelect or false
	self.Placeholder = config.Placeholder or "Не выбрано"
	self.MaxSelections = config.MaxSelections
	self.Searchable = config.Searchable
	if self.Searchable == nil then
		self.Searchable = #self.Options >= SEARCH_THRESHOLD
	end

	-- Значение всегда храним таблицей — так проще сериализовать
	-- и единообразно обрабатывать оба режима.
	local default = config.Default or config.CurrentOption
	if default == nil then
		self.Selected = {}
	elseif type(default) == "table" then
		self.Selected = Util.deepCopy(default)
	else
		self.Selected = { default }
	end
	if not self.MultiSelect and #self.Selected > 1 then
		self.Selected = { self.Selected[1] }
	end
	self.Default = Util.deepCopy(self.Selected)
	self.Value = self.Selected

	self.Open = false
	self.OptionButtons = {}
	self.SearchQuery = ""

	self:_buildControl()
	self:_rebuildOptions()
	self:_updateDisplay(true)

	tab:_register(self)
	return self
end

--==============================================================
-- Шапка
--==============================================================
function Dropdown:_buildControl()
	-- Текст текущего выбора
	local display = create("TextLabel", {
		Name = "Display",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -32, 0, 0),
		-- Высота строго по шапке: не растягивается вместе с карточкой
		Size = UDim2.new(0.42, 0, 0, self.BaseHeight),
		Font = Enum.Font.Gotham,
		Text = self.Placeholder,
		TextSize = 12,
		TextTransparency = 0.35,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 5,
		Parent = self.Frame,
	})
	Theme.bind(display, "TextColor3", "TextSecondary")
	self.Display = display

	-- Шеврон
	local chevron = create("ImageLabel", {
		Name = "Chevron",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -Element.PADDING_X, 0, (self.BaseHeight - 14) / 2),
		Size = UDim2.fromOffset(14, 14),
		ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = 0.5,
		ZIndex = 5,
		Parent = self.Frame,
	})
	Icons.apply(chevron, "chevron-down")
	Theme.bind(chevron, "ImageColor3", "TextSecondary")
	self.Chevron = chevron

	-- Зона клика только по шапке: иначе клик по опции закрывал бы список
	self.HitArea.Size = UDim2.new(1, 0, 0, self.BaseHeight)

	--==========================================================
	-- Контейнер списка
	--==========================================================
	local listHolder = create("Frame", {
		Name = "ListHolder",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, self.BaseHeight),
		Size = UDim2.new(1, 0, 0, 0),
		ClipsDescendants = true,
		ZIndex = 4,
		Parent = self.Frame,
	})
	self.ListHolder = listHolder

	-- Разделитель между шапкой и списком
	local divider = create("Frame", {
		Name = "Divider",
		Position = UDim2.new(0, Element.PADDING_X, 0, 0),
		Size = UDim2.new(1, -Element.PADDING_X * 2, 0, 1),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = listHolder,
	}, {
		-- Мягкие торцы вместо обрубленной линии
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0),
				NumberSequenceKeypoint.new(0.8, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	Theme.bind(divider, "BackgroundColor3", "Divider")
	self.Divider = divider

	-- Поле поиска
	if self.Searchable then
		local searchBox = create("Frame", {
			Name = "Search",
			Position = UDim2.new(0, Element.PADDING_X, 0, LIST_PADDING),
			Size = UDim2.new(1, -Element.PADDING_X * 2, 0, SEARCH_HEIGHT - 6),
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = listHolder,
		}, {
			Util.corner(6),
		})
		Theme.bind(searchBox, "BackgroundColor3", "ElementActive")
		self.SearchBox = searchBox

		local searchIcon = create("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 7, 0.5, 0),
			Size = UDim2.fromOffset(12, 12),
			ScaleType = Enum.ScaleType.Fit,
			ImageTransparency = 1,
			ZIndex = 6,
			Parent = searchBox,
		})
		Icons.apply(searchIcon, "search")
		Theme.bind(searchIcon, "ImageColor3", "TextMuted")
		self.SearchIcon = searchIcon

		local input = create("TextBox", {
			Name = "Input",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 24, 0, 0),
			Size = UDim2.new(1, -30, 1, 0),
			Font = Enum.Font.Gotham,
			PlaceholderText = "Поиск...",
			Text = "",
			TextSize = 11,
			TextTransparency = 1,
			PlaceholderColor3 = Theme.get("TextMuted"),
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ZIndex = 6,
			Parent = searchBox,
		})
		Theme.bind(input, "TextColor3", "TextPrimary")
		self.SearchInput = input

		self.Janitor:Add(input:GetPropertyChangedSignal("Text"):Connect(function()
			self.SearchQuery = Util.lower(input.Text)
			self:_applyFilter()
		end))
	end

	-- Скроллируемый список опций
	local optionList = create("ScrollingFrame", {
		Name = "Options",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, LIST_PADDING, 0, LIST_PADDING + (self.Searchable and SEARCH_HEIGHT or 0)),
		Size = UDim2.new(1, -LIST_PADDING * 2, 0, 0),
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageTransparency = 0.5,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ZIndex = 5,
		Parent = listHolder,
	}, {
		Util.listLayout({ Padding = UDim.new(0, 2) }),
	})
	Theme.bind(optionList, "ScrollBarImageColor3", "TextMuted")
	self.OptionList = optionList

	-- Клик по шапке
	self.Janitor:Add(self.HitArea.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		self:Toggle()
	end))
end

--==============================================================
-- Построение опций
--==============================================================
function Dropdown:_rebuildOptions()
	for _, btn in ipairs(self.OptionButtons) do
		btn.Frame:Destroy()
	end
	self.OptionButtons = {}

	for index, option in ipairs(self.Options) do
		self:_createOption(option, index)
	end
end

function Dropdown:_createOption(option, index)
	local optionText = tostring(option)

	local btn = create("TextButton", {
		Name = optionText,
		Size = UDim2.new(1, 0, 0, OPTION_HEIGHT),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = index,
		ZIndex = 6,
		Parent = self.OptionList,
	}, {
		Util.corner(6),
	})
	Theme.bind(btn, "BackgroundColor3", "ElementHover")

	-- Чекбокс / радио
	local box = create("Frame", {
		Name = "Box",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = btn,
	}, {
		-- Мультивыбор — квадрат, одиночный — круг
		Util.corner(self.MultiSelect and 4 or 7),
	})
	Theme.bind(box, "BackgroundColor3", "Accent")

	local boxStroke = Util.stroke(Theme.get("TextMuted"), 1.2, 0.3)
	if boxStroke then
		boxStroke.Parent = box
		Theme.bind(boxStroke, "Color", "TextMuted")
	end

	local check = create("ImageLabel", {
		Name = "Check",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = 1,
		ImageColor3 = Color3.new(1, 1, 1),
		ZIndex = 8,
		Parent = box,
	}, {
		create("UIScale", { Scale = 0.5 }),
	})
	Icons.apply(check, "check")

	local label = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 30, 0.5, 0),
		Size = UDim2.new(1, -38, 1, 0),
		Font = Enum.Font.Gotham,
		Text = optionText,
		TextSize = 12,
		TextTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 7,
		Parent = btn,
	})
	Theme.bind(label, "TextColor3", "TextPrimary")

	local entry = {
		Frame = btn,
		Box = box,
		BoxStroke = boxStroke,
		Check = check,
		CheckScale = check:FindFirstChildOfClass("UIScale"),
		Label = label,
		Option = option,
		Visible = true,
	}

	btn.MouseEnter:Connect(function()
		Motion.fast(btn, { BackgroundTransparency = 0.88 })
		Motion.fast(label, { TextTransparency = 0 })
	end)
	btn.MouseLeave:Connect(function()
		Motion.fast(btn, { BackgroundTransparency = 1 })
		Motion.fast(label, {
			TextTransparency = self:_isSelected(option) and 0.05 or 0.3,
		})
	end)
	btn.Activated:Connect(function()
		self:_toggleOption(option)
	end)

	table.insert(self.OptionButtons, entry)
	self:_renderOption(entry, true)
	return entry
end

function Dropdown:_isSelected(option)
	return Util.tableContains(self.Selected, option)
end

function Dropdown:_renderOption(entry, immediate)
	local selected = self:_isSelected(entry.Option)
	local duration = immediate and 0 or Motion.Duration.Fast

	Motion.tween(entry.Box, {
		BackgroundTransparency = selected and 0 or 1,
	}, { Duration = duration })

	if entry.BoxStroke then
		Motion.tween(entry.BoxStroke, {
			Transparency = selected and 1 or 0.3,
		}, { Duration = duration })
	end

	Motion.tween(entry.Check, {
		ImageTransparency = selected and 0 or 1,
	}, { Duration = duration })

	Motion.tween(entry.CheckScale, {
		Scale = selected and 1 or 0.5,
	}, {
		Duration = immediate and 0 or Motion.Duration.Normal,
		Easing = Motion.Easing.Overshoot,
	})

	Motion.tween(entry.Label, {
		TextTransparency = selected and 0.05 or 0.3,
	}, { Duration = duration })
end

--==============================================================
-- Выбор
--==============================================================
function Dropdown:_toggleOption(option)
	if self.MultiSelect then
		local index = Util.indexOf(self.Selected, option)
		if index then
			table.remove(self.Selected, index)
		else
			if self.MaxSelections and #self.Selected >= self.MaxSelections then
				-- Достигнут лимит: подсветим и не добавляем
				if self.Library and self.Library.Notify then
					self.Library:Notify({
						Title = self.Name,
						Content = ("Максимум %d вариантов"):format(self.MaxSelections),
						Icon = "info",
						Duration = 2,
					})
				end
				return
			end
			table.insert(self.Selected, option)
		end
	else
		if self:_isSelected(option) and not self.AllowDeselect then
			-- Повторный клик по выбранному — просто закрываем
			self:Toggle(false)
			return
		end
		self.Selected = { option }
	end

	self.Value = self.Selected

	-- Перерисовываем все опции (состояние могло измениться у нескольких)
	for _, entry in ipairs(self.OptionButtons) do
		self:_renderOption(entry, false)
	end

	self:_updateDisplay(false)
	self:_fireCallback()
	self:_save()

	-- В одиночном режиме закрываем после выбора
	if not self.MultiSelect then
		task.delay(0.12, function()
			if not self.Destroyed and self.Open then
				self:Toggle(false)
			end
		end)
	end
end

function Dropdown:_fireCallback()
	local payload
	if self.MultiSelect then
		payload = Util.deepCopy(self.Selected)
	else
		payload = self.Selected[1]
	end
	if self.Callback then
		task.spawn(self.Callback, payload)
	end
	self.Changed:Fire(payload)
end

function Dropdown:_updateDisplay(immediate)
	local text
	if #self.Selected == 0 then
		text = self.Placeholder
	elseif self.MultiSelect and #self.Selected > 1 then
		-- Не влезает список — показываем счётчик
		if #self.Selected <= 2 then
			text = table.concat(self.Selected, ", ")
		else
			text = ("%d выбрано"):format(#self.Selected)
		end
	else
		text = tostring(self.Selected[1])
	end

	if immediate then
		self.Display.Text = text
		self.Display.TextTransparency = #self.Selected > 0 and 0.15 or 0.35
		return
	end

	-- Смена текста с лёгким «мерцанием»
	Motion.tween(self.Display, { TextTransparency = 1 }, {
		Duration = Motion.Duration.Micro,
		OnComplete = function()
			self.Display.Text = text
			Motion.tween(self.Display, {
				TextTransparency = #self.Selected > 0 and 0.15 or 0.35,
			}, { Duration = Motion.Duration.Fast })
		end,
	})
end

--==============================================================
-- Фильтрация поиском
--==============================================================
function Dropdown:_applyFilter()
	local query = self.SearchQuery
	local visibleCount = 0

	for _, entry in ipairs(self.OptionButtons) do
		local matches = query == "" or Util.lower(tostring(entry.Option)):find(query, 1, true) ~= nil
		entry.Visible = matches
		entry.Frame.Visible = matches
		if matches then
			visibleCount += 1
		end
	end

	-- Высота списка меняется — пересчитываем раскрытие
	if self.Open then
		self:_resize(visibleCount)
	end
end

function Dropdown:_visibleCount()
	local count = 0
	for _, entry in ipairs(self.OptionButtons) do
		if entry.Visible then
			count += 1
		end
	end
	return count
end

--==============================================================
-- Раскрытие / схлопывание
--==============================================================
function Dropdown:_listHeight(visibleCount)
	visibleCount = visibleCount or self:_visibleCount()
	local shown = math.min(visibleCount, MAX_VISIBLE)
	local optionsHeight = shown * OPTION_HEIGHT + math.max(0, shown - 1) * 2
	local searchHeight = self.Searchable and SEARCH_HEIGHT or 0
	if shown == 0 then
		optionsHeight = OPTION_HEIGHT -- место под «ничего не найдено»
	end
	return optionsHeight + searchHeight + LIST_PADDING * 2
end

function Dropdown:_resize(visibleCount)
	local listHeight = self:_listHeight(visibleCount)
	local shown = math.min(visibleCount or self:_visibleCount(), MAX_VISIBLE)
	local optionsHeight = shown * OPTION_HEIGHT + math.max(0, shown - 1) * 2

	Motion.tween(self.OptionList, {
		Size = UDim2.new(1, -LIST_PADDING * 2, 0, optionsHeight),
	}, { Duration = Motion.Duration.Slow, Easing = Motion.Easing.Standard })

	Motion.tween(self.ListHolder, {
		Size = UDim2.new(1, 0, 0, listHeight),
	}, { Duration = Motion.Duration.Slow, Easing = Motion.Easing.Standard })

	-- Главное: высота карточки → соседи разъезжаются
	self:SetHeight(self.BaseHeight + listHeight, true)
end

function Dropdown:Toggle(force)
	local open = force
	if open == nil then
		open = not self.Open
	end
	if open == self.Open then
		return
	end
	self.Open = open

	-- Шеврон разворачивается
	Motion.tween(self.Chevron, { Rotation = open and 180 or 0 }, {
		Duration = Motion.Duration.Slow,
		Easing = Motion.Easing.Standard,
	})

	if open then
		self:CloseOtherPanels()

		self:_resize()

		Motion.tween(self.Divider, { BackgroundTransparency = 0.4 }, {
			Duration = Motion.Duration.Normal,
		})

		if self.SearchBox then
			Motion.tween(self.SearchBox, { BackgroundTransparency = 0 }, {
				Duration = Motion.Duration.Normal,
				Delay = 0.05,
			})
			Motion.tween(self.SearchInput, { TextTransparency = 0 }, {
				Duration = Motion.Duration.Normal,
				Delay = 0.08,
			})
			Motion.tween(self.SearchIcon, { ImageTransparency = 0.4 }, {
				Duration = Motion.Duration.Normal,
				Delay = 0.08,
			})
		end

		-- Каскадное появление опций
		local visible = {}
		for _, entry in ipairs(self.OptionButtons) do
			if entry.Visible then
				table.insert(visible, entry)
			end
		end

		Motion.stagger(visible, 0.03, function(entry, index, delayTime)
			local baseDelay = (self.Searchable and 0.06 or 0.02) + delayTime
			entry.Label.TextTransparency = 1
			entry.Frame.BackgroundTransparency = 1

			Motion.tween(entry.Label, {
				TextTransparency = self:_isSelected(entry.Option) and 0.05 or 0.3,
			}, { Duration = Motion.Duration.Normal, Delay = baseDelay })

			if self:_isSelected(entry.Option) then
				entry.Check.ImageTransparency = 1
				entry.Box.BackgroundTransparency = 1
				Motion.tween(entry.Box, { BackgroundTransparency = 0 }, {
					Duration = Motion.Duration.Normal,
					Delay = baseDelay,
				})
				Motion.tween(entry.Check, { ImageTransparency = 0 }, {
					Duration = Motion.Duration.Normal,
					Delay = baseDelay + 0.02,
				})
			end
		end)
	else
		-- Схлопывание
		Motion.tween(self.Divider, { BackgroundTransparency = 1 }, {
			Duration = Motion.Duration.Fast,
		})

		if self.SearchBox then
			Motion.tween(self.SearchBox, { BackgroundTransparency = 1 }, {
				Duration = Motion.Duration.Fast,
			})
			Motion.tween(self.SearchInput, { TextTransparency = 1 }, {
				Duration = Motion.Duration.Fast,
			})
			Motion.tween(self.SearchIcon, { ImageTransparency = 1 }, {
				Duration = Motion.Duration.Fast,
			})
		end

		for _, entry in ipairs(self.OptionButtons) do
			Motion.tween(entry.Label, { TextTransparency = 1 }, {
				Duration = Motion.Duration.Fast,
			})
			Motion.tween(entry.Box, { BackgroundTransparency = 1 }, {
				Duration = Motion.Duration.Fast,
			})
			Motion.tween(entry.Check, { ImageTransparency = 1 }, {
				Duration = Motion.Duration.Fast,
			})
		end

		Motion.tween(self.ListHolder, { Size = UDim2.new(1, 0, 0, 0) }, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Standard,
		})
		self:SetHeight(self.BaseHeight, true)

		-- Сбрасываем поиск, чтобы при следующем открытии был полный список
		if self.SearchInput then
			self.SearchInput.Text = ""
			self.SearchQuery = ""
			for _, entry in ipairs(self.OptionButtons) do
				entry.Visible = true
				entry.Frame.Visible = true
			end
		end
	end
end

--==============================================================
-- Публичный API
--==============================================================
function Dropdown:Set(value, skipCallback)
	if value == nil then
		self.Selected = {}
	elseif type(value) == "table" then
		self.Selected = {}
		for _, v in ipairs(value) do
			if Util.tableContains(self.Options, v) then
				table.insert(self.Selected, v)
			end
		end
		if not self.MultiSelect and #self.Selected > 1 then
			self.Selected = { self.Selected[1] }
		end
	else
		if Util.tableContains(self.Options, value) then
			self.Selected = { value }
		else
			return self
		end
	end

	self.Value = self.Selected
	for _, entry in ipairs(self.OptionButtons) do
		self:_renderOption(entry, false)
	end
	self:_updateDisplay(false)

	if not skipCallback then
		self:_fireCallback()
	end
	self:_save()
	return self
end

function Dropdown:Get()
	if self.MultiSelect then
		return Util.deepCopy(self.Selected)
	end
	return self.Selected[1]
end

function Dropdown:Refresh(options, keepSelection)
	self.Options = options or {}

	if keepSelection then
		local kept = {}
		for _, v in ipairs(self.Selected) do
			if Util.tableContains(self.Options, v) then
				table.insert(kept, v)
			end
		end
		local changed = #kept ~= #self.Selected
		self.Selected = kept
		self.Value = kept
		if changed then
			self:_fireCallback()
		end
	else
		self.Selected = {}
		self.Value = {}
	end

	self.Searchable = #self.Options >= SEARCH_THRESHOLD
	self:_rebuildOptions()
	self:_updateDisplay(true)

	if self.Open then
		self:_resize()
	end
	return self
end

function Dropdown:Add(option)
	if Util.tableContains(self.Options, option) then
		return self
	end
	table.insert(self.Options, option)
	self:_createOption(option, #self.Options)
	if self.Open then
		self:_resize()
	end
	return self
end

function Dropdown:Remove(option)
	local index = Util.indexOf(self.Options, option)
	if not index then
		return self
	end
	table.remove(self.Options, index)

	local selIndex = Util.indexOf(self.Selected, option)
	if selIndex then
		table.remove(self.Selected, selIndex)
		self:_updateDisplay(false)
		self:_fireCallback()
	end

	self:_rebuildOptions()
	if self.Open then
		self:_resize()
	end
	return self
end

function Dropdown:Serialize()
	return { value = Util.deepCopy(self.Selected), type = "table" }
end

function Dropdown:Deserialize(data)
	if type(data) ~= "table" or type(data.value) ~= "table" then
		return
	end
	self:Set(data.value, true)
end

function Dropdown:Destroy()
	Element.Destroy(self)
end

return Dropdown
end

__swagga_modules["elements/Input"] = function()

--[[
	Input — текстовое / числовое поле.

	Числовой режим (Numeric = true):
	  • пропускает только цифры, точку и минус
	  • клампит в [Min, Max]
	  • колесо мыши над полем меняет значение на Step
	  • стрелки вверх/вниз тоже работают

	Подчёркивание снизу «наливается» акцентом при фокусе —
	это дешевле по кадрам, чем анимировать обводку целиком.
]]

local Element = __swagga_require("Element")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")

local create = Util.create

local Input = setmetatable({}, { __index = Element })
Input.__index = Input

function Input.new(tab, config)
	config = config or {}
	local self = Element.new(tab, config, "input")
	setmetatable(self, Input)

	self.Numeric = config.Numeric or false
	self.Min = config.Min
	self.Max = config.Max
	self.Step = config.Step or 1
	self.Decimals = config.Decimals or 0
	self.MaxLength = config.MaxLength
	self.Placeholder = config.Placeholder or (self.Numeric and "0" or "Введите текст")
	self.ClearOnFocus = config.ClearOnFocus or false
	self.FireOnType = config.FireOnType or false

	self.Default = config.Default or config.CurrentValue or (self.Numeric and (self.Min or 0) or "")
	self.Value = self.Default

	self:_buildControl()
	self:_render(true)

	tab:_register(self)
	return self
end

function Input:_buildControl()
	local headerY = self.HeaderY or (Element.DEFAULT_HEIGHT / 2)
	local centerY = self.Description and (headerY - 8) or headerY
	local width = self.Numeric and 84 or 140

	local box = create("Frame", {
		Name = "InputBox",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X, 0, centerY),
		Size = UDim2.fromOffset(width, 26),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 5,
		Parent = self.Frame,
	}, {
		Util.corner(6),
	})
	Theme.bind(box, "BackgroundColor3", "ElementActive")
	self.Box = box

	local input = create("TextBox", {
		Name = "Field",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 8, 0, 0),
		Size = UDim2.new(1, -16, 1, 0),
		Font = self.Numeric and Enum.Font.Code or Enum.Font.Gotham,
		Text = "",
		PlaceholderText = self.Placeholder,
		TextSize = 12,
		TextTransparency = 0.1,
		TextXAlignment = self.Numeric and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
		ClearTextOnFocus = self.ClearOnFocus,
		ZIndex = 6,
		Parent = box,
	})
	Theme.bind(input, "TextColor3", "TextPrimary")
	Theme.bind(input, "PlaceholderColor3", "TextMuted")
	self.Field = input

	-- Подчёркивание при фокусе
	local underline = create("Frame", {
		Name = "Underline",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(0, 0, 0, 2),
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = box,
	})
	Theme.bind(underline, "BackgroundColor3", "Accent")
	self.Underline = underline

	--=== Стрелки для числового режима ===
	if self.Numeric then
		local up = self:_makeStepper(box, "up")
		local down = self:_makeStepper(box, "down")
		self.StepUp = up
		self.StepDown = down
	end

	--=== События ===
	self.Janitor:Add(input.Focused:Connect(function()
		Motion.tween(underline, { Size = UDim2.new(1, 0, 0, 2) }, {
			Duration = Motion.Duration.Slow,
			Easing = Motion.Easing.Standard,
		})
		Motion.fast(box, { BackgroundColor3 = Theme.get("ElementHover") })
	end))

	self.Janitor:Add(input.FocusLost:Connect(function(enterPressed)
		Motion.tween(underline, { Size = UDim2.new(0, 0, 0, 2) }, {
			Duration = Motion.Duration.Normal,
		})
		Motion.fast(box, { BackgroundColor3 = Theme.get("ElementActive") })
		self:_commit(input.Text)
	end))

	if self.FireOnType then
		self.Janitor:Add(input:GetPropertyChangedSignal("Text"):Connect(function()
			if self.MaxLength and Util.len(input.Text) > self.MaxLength then
				input.Text = Util.sub(input.Text, 1, self.MaxLength)
			end
			self:_commit(input.Text, true)
		end))
	end

	-- Колесо мыши для чисел
	if self.Numeric then
		self.Janitor:Add(self.HitArea.MouseWheelForward:Connect(function()
			if self.Enabled then
				self:Set((tonumber(self.Value) or 0) + self.Step)
			end
		end))
		self.Janitor:Add(self.HitArea.MouseWheelBackward:Connect(function()
			if self.Enabled then
				self:Set((tonumber(self.Value) or 0) - self.Step)
			end
		end))
	end
end

function Input:_makeStepper(parent, direction)
	local isUp = direction == "up"
	local btn = create("TextButton", {
		Name = isUp and "Up" or "Down",
		AnchorPoint = Vector2.new(1, isUp and 0 or 1),
		Position = UDim2.new(1, -2, isUp and 0 or 1, isUp and 2 or -2),
		Size = UDim2.fromOffset(14, 10),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = isUp and "+" or "−",
		TextSize = 11,
		TextTransparency = 0.6,
		ZIndex = 8,
		Parent = parent,
	})
	Theme.bind(btn, "TextColor3", "TextSecondary")

	btn.MouseEnter:Connect(function()
		Motion.fast(btn, { TextTransparency = 0 })
	end)
	btn.MouseLeave:Connect(function()
		Motion.fast(btn, { TextTransparency = 0.6 })
	end)
	btn.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		local current = tonumber(self.Value) or 0
		self:Set(current + (isUp and self.Step or -self.Step))
		Motion.press(btn, 0.8)
		task.delay(0.08, function()
			if not self.Destroyed then
				Motion.release(btn)
			end
		end)
	end)

	return btn
end

--==============================================================
-- Валидация и применение
--==============================================================
function Input:_commit(text, silent)
	if self.Numeric then
		-- Оставляем только допустимые символы
		local clean = tostring(text):gsub("[^%d%.%-]", "")
		local number = tonumber(clean)

		if number == nil then
			if not silent then
				self:_render(false)
				self:_flashError()
			end
			return
		end

		if self.Min then
			number = math.max(number, self.Min)
		end
		if self.Max then
			number = math.min(number, self.Max)
		end
		number = Util.round(number, self.Decimals)
		self:Set(number, false, silent)
	else
		if self.MaxLength then
			text = Util.sub(tostring(text), 1, self.MaxLength)
		end
		self:Set(text, false, silent)
	end
end

function Input:_flashError()
	local original = Theme.get("ElementActive")
	Motion.tween(self.Box, { BackgroundColor3 = Theme.get("Danger") }, {
		Duration = Motion.Duration.Micro,
		OnComplete = function()
			Motion.tween(self.Box, { BackgroundColor3 = original }, {
				Duration = Motion.Duration.Slower,
			})
		end,
	})
end

function Input:_render(immediate)
	local text
	if self.Numeric then
		if self.Decimals > 0 then
			text = string.format("%." .. self.Decimals .. "f", tonumber(self.Value) or 0)
		else
			text = tostring(math.floor((tonumber(self.Value) or 0) + 0.5))
		end
	else
		text = tostring(self.Value or "")
	end
	self.Field.Text = text
end

function Input:Set(value, skipCallback, skipRender)
	if self.Numeric then
		value = tonumber(value)
		if value == nil then
			return self
		end
		if self.Min then
			value = math.max(value, self.Min)
		end
		if self.Max then
			value = math.min(value, self.Max)
		end
		value = Util.round(value, self.Decimals)
	else
		value = tostring(value or "")
		if self.MaxLength then
			value = Util.sub(value, 1, self.MaxLength)
		end
	end

	local changed = value ~= self.Value
	self.Value = value

	if not skipRender then
		self:_render(false)
	end

	if changed then
		if not skipCallback and self.Callback then
			task.spawn(self.Callback, value)
		end
		self.Changed:Fire(value)
		self:_save()
	end
	return self
end

function Input:Get()
	return self.Value
end

function Input:OnEnabledChanged(enabled)
	self.Field.TextEditable = enabled
	Motion.tween(self.Box, { BackgroundTransparency = enabled and 0 or 0.5 }, {
		Duration = Motion.Duration.Normal,
	})
end

return Input
end

__swagga_modules["elements/Keybind"] = function()

--[[
	Keybind — отдельный элемент выбора клавиши.

	Отличается от бинда через ПКМ тем, что это самостоятельный
	элемент со своей строкой в списке. Оба пути ведут в одну
	систему Binds.

	Запись: клик по капсуле → «Нажмите клавишу» с пульсацией →
	любая клавиша или кнопка мыши. Esc отменяет, Backspace очищает.
]]

local Element = __swagga_require("Element")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Compat = __swagga_require("Compat")

local create = Util.create
local UIS = Compat.Services.Input

local Keybind = setmetatable({}, { __index = Element })
Keybind.__index = Keybind

-- Человекочитаемые подписи
local PRETTY = {
	MouseButton1 = "ЛКМ",
	MouseButton2 = "ПКМ",
	MouseButton3 = "СКМ",
	LeftShift = "L-Shift",
	RightShift = "R-Shift",
	LeftControl = "L-Ctrl",
	RightControl = "R-Ctrl",
	LeftAlt = "L-Alt",
	RightAlt = "R-Alt",
	Return = "Enter",
	Escape = "Esc",
	Space = "Space",
	Backspace = "Backspace",
}

local function prettyName(key)
	if not key then
		return "Нет"
	end
	local name = key.Name or tostring(key)
	return PRETTY[name] or name
end

function Keybind.new(tab, config)
	config = config or {}
	config.SupportsKeybind = false -- у самого элемента нет ПКМ-бинда
	local self = Element.new(tab, config, "keybind")
	setmetatable(self, Keybind)

	self.Default = config.Default or config.CurrentKeybind
	self.Value = self.Default
	self.Mode = config.Mode or "Toggle" -- Toggle | Hold | Always
	self.HoldThreshold = config.HoldThreshold or 0.2
	self.Recording = false
	self.OnPressed = config.Callback
	self.OnChangedBind = config.OnChanged

	self:_buildControl()
	self:_render(true)

	-- Регистрируем в системе биндов
	if self.Value and self.Library and self.Library.Binds then
		self.Library.Binds:Register(self)
	end

	tab:_register(self)
	return self
end

function Keybind:_buildControl()
	local headerY = self.HeaderY or (Element.DEFAULT_HEIGHT / 2)
	local centerY = self.Description and (headerY - 8) or headerY

	-- Капсула с клавишей
	local capsule = create("TextButton", {
		Name = "Capsule",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X, 0, centerY),
		Size = UDim2.fromOffset(76, 24),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 6,
		Parent = self.Frame,
	}, {
		Util.corner(6),
	})
	Theme.bind(capsule, "BackgroundColor3", "ElementActive")
	self.Capsule = capsule

	local capsuleStroke = Util.stroke(Theme.get("Stroke"), 1, 0.4)
	if capsuleStroke then
		capsuleStroke.Parent = capsule
		Theme.bind(capsuleStroke, "Color", "Stroke")
		self.CapsuleStroke = capsuleStroke
	end

	local keyLabel = create("TextLabel", {
		Name = "Key",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamMedium,
		Text = "Нет",
		TextSize = 11,
		TextTransparency = 0.25,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 7,
		Parent = capsule,
	})
	Theme.bind(keyLabel, "TextColor3", "TextPrimary")
	self.KeyLabel = keyLabel

	-- Индикатор режима слева от капсулы
	local modeLabel = create("TextButton", {
		Name = "Mode",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X - 82, 0, centerY),
		Size = UDim2.fromOffset(52, 20),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Font = Enum.Font.Gotham,
		Text = self.Mode,
		TextSize = 10,
		TextTransparency = 0.55,
		ZIndex = 6,
		Parent = self.Frame,
	}, {
		Util.corner(5),
	})
	Theme.bind(modeLabel, "TextColor3", "TextMuted")
	Theme.bind(modeLabel, "BackgroundColor3", "ElementActive")
	self.ModeLabel = modeLabel

	-- Клик по режиму — циклическая смена
	self.Janitor:Add(modeLabel.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		local modes = { "Toggle", "Hold", "Always" }
		local index = Util.indexOf(modes, self.Mode) or 1
		self:SetMode(modes[(index % #modes) + 1])
	end))

	modeLabel.MouseEnter:Connect(function()
		Motion.fast(modeLabel, { BackgroundTransparency = 0.4, TextTransparency = 0.2 })
	end)
	modeLabel.MouseLeave:Connect(function()
		Motion.fast(modeLabel, { BackgroundTransparency = 1, TextTransparency = 0.55 })
	end)

	-- Клик по капсуле — запись
	self.Janitor:Add(capsule.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		self:StartRecording()
	end))

	capsule.MouseEnter:Connect(function()
		if not self.Recording then
			Motion.fast(capsule, { BackgroundTransparency = 0.3 })
			Motion.fast(keyLabel, { TextTransparency = 0 })
		end
	end)
	capsule.MouseLeave:Connect(function()
		if not self.Recording then
			Motion.fast(capsule, { BackgroundTransparency = 0 })
			Motion.fast(keyLabel, { TextTransparency = 0.25 })
		end
	end)
end

--==============================================================
-- Запись клавиши
--==============================================================
function Keybind:StartRecording()
	if self.Recording then
		return
	end
	self.Recording = true

	self.KeyLabel.Text = "Нажмите..."
	self.KeyLabel.TextTransparency = 0

	-- Пульсация рамки — понятно, что ждём ввода
	if self.CapsuleStroke then
		self.CapsuleStroke.Color = Theme.get("Accent")
		self._pulse = Motion.pulse(self.CapsuleStroke, "Transparency", 0.1, 0.75, 0.9)
	end
	Motion.tween(self.Capsule, { BackgroundColor3 = Theme.get("AccentMuted") }, {
		Duration = Motion.Duration.Normal,
	})

	-- Расширяем капсулу под длинный текст
	Motion.tween(self.Capsule, { Size = UDim2.fromOffset(92, 24) }, {
		Duration = Motion.Duration.Normal,
		Easing = Motion.Easing.Overshoot,
	})

	local connection
	connection = UIS.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end

		local key
		if input.UserInputType == Enum.UserInputType.Keyboard then
			key = input.KeyCode
		elseif input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.MouseButton3 then
			key = input.UserInputType
		else
			return
		end

		connection:Disconnect()

		-- Esc — отмена, Backspace — очистка
		if key == Enum.KeyCode.Escape then
			self:_stopRecording()
			return
		end
		if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
			self:_stopRecording()
			self:Set(nil)
			return
		end

		self:_stopRecording()
		self:Set(key)
	end)

	self.Janitor:Add(connection)
	self._recordConnection = connection
end

function Keybind:_stopRecording()
	self.Recording = false

	if self._pulse then
		self._pulse:Stop(0.4)
		self._pulse = nil
	end
	if self._recordConnection then
		self._recordConnection:Disconnect()
		self._recordConnection = nil
	end
	if self.CapsuleStroke then
		self.CapsuleStroke.Color = Theme.get("Stroke")
	end

	Motion.tween(self.Capsule, {
		BackgroundColor3 = Theme.get("ElementActive"),
		Size = UDim2.fromOffset(76, 24),
	}, { Duration = Motion.Duration.Normal })

	self:_render(false)
end

--==============================================================
-- Отрисовка
--==============================================================
function Keybind:_render(immediate)
	self.KeyLabel.Text = prettyName(self.Value)
	self.ModeLabel.Text = self.Mode

	local hasKey = self.Value ~= nil
	local duration = immediate and 0 or Motion.Duration.Normal

	Motion.tween(self.KeyLabel, {
		TextTransparency = hasKey and 0.1 or 0.5,
	}, { Duration = duration })

	if self.CapsuleStroke then
		Motion.tween(self.CapsuleStroke, {
			Transparency = hasKey and 0.2 or 0.6,
		}, { Duration = duration })
	end

	-- Режим виден только когда есть клавиша
	Motion.tween(self.ModeLabel, {
		TextTransparency = hasKey and 0.55 or 1,
	}, { Duration = duration })
end

--==============================================================
-- API
--==============================================================
function Keybind:Set(key, skipCallback)
	local previous = self.Value

	-- Строку конвертируем в enum
	if type(key) == "string" then
		key = Enum.KeyCode[key] or Enum.UserInputType[key]
	end

	self.Value = key
	self.Keybind = key -- для совместимости с Binds
	self.KeybindMode = self.Mode

	if self.Library and self.Library.Binds then
		if key then
			self.Library.Binds:Register(self, previous)
		else
			self.Library.Binds:Remove(self)
		end
	end

	self:_render(false)

	-- Короткая вспышка при назначении
	if key then
		local original = Theme.get("TextPrimary")
		self.KeyLabel.TextColor3 = Theme.get("Accent")
		Motion.tween(self.KeyLabel, { TextColor3 = original }, {
			Duration = Motion.Duration.Slower,
			Delay = 0.2,
		})
	end

	if not skipCallback and self.OnChangedBind then
		task.spawn(self.OnChangedBind, key)
	end
	self.Changed:Fire(key)
	self:_save()
	return self
end

function Keybind:SetMode(mode)
	self.Mode = mode
	self.KeybindMode = mode
	self:_render(false)

	-- Подсветка смены режима
	Motion.tween(self.ModeLabel, { TextColor3 = Theme.get("Accent") }, {
		Duration = Motion.Duration.Fast,
		OnComplete = function()
			Motion.tween(self.ModeLabel, { TextColor3 = Theme.get("TextMuted") }, {
				Duration = Motion.Duration.Slower,
			})
		end,
	})

	if self.Library and self.Library.Binds and self.Value then
		self.Library.Binds:Register(self, self.Value)
	end
	self:_save()
	return self
end

function Keybind:Get()
	return self.Value
end

--[[
	Вызывается системой биндов.
	state = true при нажатии, false при отпускании (в Hold-режиме).
]]
function Keybind:OnKeybindTriggered(state)
	if self.Mode == "Hold" then
		if self.OnPressed then
			task.spawn(self.OnPressed, state)
		end
	elseif state then
		if self.OnPressed then
			task.spawn(self.OnPressed, self.Value)
		end
	end

	if state then
		-- Вспышка капсулы при срабатывании
		Motion.tween(self.Capsule, { BackgroundColor3 = Theme.get("Accent") }, {
			Duration = Motion.Duration.Micro,
			OnComplete = function()
				Motion.tween(self.Capsule, { BackgroundColor3 = Theme.get("ElementActive") }, {
					Duration = Motion.Duration.Slow,
				})
			end,
		})
	end
end

function Keybind:Serialize()
	return {
		value = self.Value and self.Value.Name or nil,
		type = "EnumItem",
		mode = self.Mode,
	}
end

function Keybind:Deserialize(data)
	if type(data) ~= "table" then
		return
	end
	if data.mode then
		self.Mode = data.mode
		self.KeybindMode = data.mode
	end
	if data.value then
		local key = Enum.KeyCode[data.value] or Enum.UserInputType[data.value]
		if key then
			self:Set(key, true)
		end
	end
	self:_render(true)
end

function Keybind:Destroy()
	self:_stopRecording()
	Element.Destroy(self)
end

return Keybind
end

__swagga_modules["elements/Slider"] = function()

--[[
	Slider — числовой слайдер.

	Особенности:
	  • Заливка и ручка двигаются пружиной, а не твином. При быстром
	    перетаскивании курсора картинка «догоняет» палец плавно,
	    без ступенек.
	  • Значение можно ввести с клавиатуры — клик по числу
	    превращает его в поле ввода.
	  • Поддержка шага (Increment), десятичных знаков и суффикса.
	  • Перетаскивание продолжается, даже если курсор ушёл за пределы
	    слайдера — как в нативных интерфейсах.
]]

local Element = __swagga_require("Element")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Compat = __swagga_require("Compat")

local create = Util.create
local UIS = Compat.Services.Input

local Slider = setmetatable({}, { __index = Element })
Slider.__index = Slider

local TRACK_HEIGHT = 4
local KNOB_SIZE = 12
local TRACK_WIDTH_SCALE = 0.42

function Slider.new(tab, config)
	config = config or {}
	local self = Element.new(tab, config, "slider")
	setmetatable(self, Slider)

	-- Диапазон: поддерживаем и {Min, Max}, и Range = {min, max}
	local range = config.Range
	self.Min = config.Min or (range and range[1]) or 0
	self.Max = config.Max or (range and range[2]) or 100
	if self.Max <= self.Min then
		self.Max = self.Min + 1
	end

	self.Increment = config.Increment or config.Step
	self.Decimals = config.Decimals or 0
	self.Suffix = config.Suffix or ""
	self.Prefix = config.Prefix or ""

	self.Default = config.Default or config.CurrentValue or self.Min
	self.Value = math.clamp(self.Default, self.Min, self.Max)
	self.Dragging = false

	self:_buildControl()
	self:_render(true)

	tab:_register(self)
	return self
end

function Slider:_buildControl()
	local headerY = self.HeaderY or (Element.DEFAULT_HEIGHT / 2)
	local centerY = self.Description and (headerY - 8) or headerY

	--=== Числовое значение (кликабельное) ===
	local valueBtn = create("TextButton", {
		Name = "Value",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X, 0, centerY),
		Size = UDim2.fromOffset(52, 18),
		Font = Enum.Font.GothamMedium,
		Text = "0",
		TextSize = 12,
		TextTransparency = 0.15,
		TextXAlignment = Enum.TextXAlignment.Right,
		AutoButtonColor = false,
		ZIndex = 6,
		Parent = self.Frame,
	})
	Theme.bind(valueBtn, "TextColor3", "Accent")
	self.ValueLabel = valueBtn

	--=== Поле ввода поверх значения ===
	local valueInput = create("TextBox", {
		Name = "ValueInput",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X, 0, centerY),
		Size = UDim2.fromOffset(56, 20),
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		ClearTextOnFocus = true,
		Visible = false,
		ZIndex = 7,
		Parent = self.Frame,
	}, {
		Util.corner(5),
	})
	Theme.bind(valueInput, "TextColor3", "TextPrimary")
	Theme.bind(valueInput, "BackgroundColor3", "ElementActive")
	self.ValueInput = valueInput

	--=== Дорожка ===
	local track = create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Element.PADDING_X - 62, 0, centerY),
		Size = UDim2.new(TRACK_WIDTH_SCALE, 0, 0, TRACK_HEIGHT),
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = self.Frame,
	}, {
		Util.corner(999),
	})
	Theme.bind(track, "BackgroundColor3", "ElementActive")
	self.Track = track

	--=== Заливка ===
	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = track,
	}, {
		Util.corner(999),
	})
	Theme.bind(fill, "BackgroundColor3", "Accent")
	self.Fill = fill

	-- Градиент по заливке — «дорогая» деталь
	local fillGradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.get("GlowB")),
			ColorSequenceKeypoint.new(1, Theme.get("Accent")),
		}),
		Parent = fill,
	})
	Theme.bindCustom(fill, function(theme)
		fillGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.GlowB),
			ColorSequenceKeypoint.new(1, theme.Accent),
		})
	end)

	--=== Ручка ===
	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(KNOB_SIZE, KNOB_SIZE),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = track,
	}, {
		Util.corner(KNOB_SIZE / 2),
	})
	self.Knob = knob
	self.KnobShadow = Util.shadow(knob, { Blur = 8, Transparency = 0.5, OffsetY = 1 })
	self.KnobGlow = Util.glow(knob, Theme.get("Accent"), { Blur = 12, Transparency = 1 })

	--=== Пружины ===
	-- Отдельные пружины для заливки и ручки: ручка чуть «живее»
	self.FillSpring = Motion.spring(0, { Frequency = 7, Damping = 1 })
	self.FillDriver = Motion.drive(fill, "Size", self.FillSpring, function(alpha)
		return UDim2.new(math.clamp(alpha, 0, 1), 0, 1, 0)
	end)

	self.KnobSpring = Motion.spring(0, { Frequency = 7, Damping = 1 })
	self.KnobDriver = Motion.drive(knob, "Position", self.KnobSpring, function(alpha)
		return UDim2.new(math.clamp(alpha, 0, 1), 0, 0.5, 0)
	end)

	self:_setupDrag()
	self:_setupInput()
end

--==============================================================
-- Перетаскивание
--==============================================================
function Slider:_setupDrag()
	local function updateFromMouse()
		local mouseX = UIS:GetMouseLocation().X
		local trackPos = self.Track.AbsolutePosition.X
		local trackWidth = self.Track.AbsoluteSize.X
		if trackWidth <= 0 then
			return
		end
		local alpha = math.clamp((mouseX - trackPos) / trackWidth, 0, 1)
		local raw = self.Min + (self.Max - self.Min) * alpha
		self:Set(raw)
	end

	-- Нажатие на дорожку или на всю карточку в области дорожки
	self.Janitor:Add(self.HitArea.MouseButton1Down:Connect(function()
		if not self.Enabled then
			return
		end
		-- Реагируем только если курсор около дорожки по горизонтали
		local mouseX = UIS:GetMouseLocation().X
		local trackPos = self.Track.AbsolutePosition.X
		local trackWidth = self.Track.AbsoluteSize.X
		-- Небольшой допуск, чтобы попадать по узкой дорожке было легко
		if mouseX < trackPos - 12 or mouseX > trackPos + trackWidth + 12 then
			return
		end

		self.Dragging = true
		self:_setActiveVisual(true)
		updateFromMouse()
	end))

	self.Janitor:Add(UIS.InputChanged:Connect(function(input)
		if not self.Dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			updateFromMouse()
		end
	end))

	self.Janitor:Add(UIS.InputEnded:Connect(function(input)
		if not self.Dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			self.Dragging = false
			self:_setActiveVisual(false)
		end
	end))
end

function Slider:_setActiveVisual(active)
	Motion.tween(self.Knob, {
		Size = UDim2.fromOffset(
			active and KNOB_SIZE + 4 or KNOB_SIZE,
			active and KNOB_SIZE + 4 or KNOB_SIZE
		),
	}, {
		Duration = Motion.Duration.Normal,
		Easing = Motion.Easing.Overshoot,
	})

	Motion.tween(self.Track, {
		Size = UDim2.new(TRACK_WIDTH_SCALE, 0, 0, active and TRACK_HEIGHT + 2 or TRACK_HEIGHT),
	}, { Duration = Motion.Duration.Normal })

	if self.KnobGlow then
		local target, prop = self.KnobGlow:GetTweenTarget()
		self.KnobGlow:SetColor(Theme.get("Accent"))
		Motion.tween(target, { [prop] = active and 0.4 or 1 }, {
			Duration = Motion.Duration.Normal,
		})
	end
end

--==============================================================
-- Ввод значения с клавиатуры
--==============================================================
function Slider:_setupInput()
	self.Janitor:Add(self.ValueLabel.Activated:Connect(function()
		if not self.Enabled then
			return
		end
		self.ValueLabel.Visible = false
		self.ValueInput.Visible = true
		self.ValueInput.Text = tostring(self.Value)
		self.ValueInput.BackgroundTransparency = 1
		Motion.tween(self.ValueInput, { BackgroundTransparency = 0 }, {
			Duration = Motion.Duration.Fast,
		})
		self.ValueInput:CaptureFocus()
	end))

	self.Janitor:Add(self.ValueInput.FocusLost:Connect(function(enterPressed)
		local text = self.ValueInput.Text
		local parsed = tonumber(text)

		Motion.tween(self.ValueInput, { BackgroundTransparency = 1 }, {
			Duration = Motion.Duration.Fast,
			OnComplete = function()
				self.ValueInput.Visible = false
				self.ValueLabel.Visible = true
			end,
		})

		if parsed then
			self:Set(parsed)
		else
			-- Некорректный ввод — короткая красная вспышка
			local original = Theme.get("Accent")
			self.ValueLabel.TextColor3 = Theme.get("Danger")
			Motion.tween(self.ValueLabel, { TextColor3 = original }, {
				Duration = Motion.Duration.Slower,
				Delay = 0.15,
			})
		end
	end))
end

--==============================================================
-- Отрисовка
--==============================================================
function Slider:_alpha()
	return (self.Value - self.Min) / (self.Max - self.Min)
end

function Slider:_format(value)
	local text
	if self.Decimals > 0 then
		text = string.format("%." .. self.Decimals .. "f", value)
	else
		text = tostring(math.floor(value + 0.5))
	end
	return self.Prefix .. text .. self.Suffix
end

function Slider:_render(immediate)
	local alpha = self:_alpha()

	if immediate then
		self.FillSpring:Snap(alpha)
		self.KnobSpring:Snap(alpha)
		self.Fill.Size = UDim2.new(alpha, 0, 1, 0)
		self.Knob.Position = UDim2.new(alpha, 0, 0.5, 0)
	else
		self.FillSpring:SetTarget(alpha)
		self.KnobSpring:SetTarget(alpha)
	end

	self.ValueLabel.Text = self:_format(self.Value)
end

function Slider:Set(value, skipCallback)
	if type(value) ~= "number" then
		return self
	end

	-- Шаг
	if self.Increment and self.Increment > 0 then
		value = math.floor((value - self.Min) / self.Increment + 0.5) * self.Increment + self.Min
	end

	value = math.clamp(value, self.Min :: number, self.Max :: number)
	value = Util.round(value, self.Decimals)

	local changed = value ~= self.Value
	self.Value = value
	self:_render(false)

	if changed then
		if not skipCallback and self.Callback then
			task.spawn(self.Callback, value)
		end
		self.Changed:Fire(value)
		self:_save()
	end
	return self
end

function Slider:Get()
	return self.Value
end

function Slider:SetRange(min, max)
	self.Min = min
	self.Max = max > min and max or min + 1
	self:Set(math.clamp(self.Value :: number, self.Min :: number, self.Max :: number))
	return self
end

function Slider:OnEnabledChanged(enabled)
	Motion.tween(self.Track, { BackgroundTransparency = enabled and 0 or 0.5 }, {
		Duration = Motion.Duration.Normal,
	})
	Motion.tween(self.ValueLabel, { TextTransparency = enabled and 0.15 or 0.6 }, {
		Duration = Motion.Duration.Normal,
	})
end

function Slider:Destroy()
	if self.FillDriver then
		self.FillDriver:Stop()
	end
	if self.KnobDriver then
		self.KnobDriver:Stop()
	end
	Element.Destroy(self)
end

return Slider
end

__swagga_modules["elements/Static"] = function()

--[[
	Static — простые неинтерактивные элементы:
	  Section    — заголовок группы
	  Label      — строка текста
	  Paragraph  — заголовок + многострочный текст (авторазмер)
	  Divider    — разделительная линия

