	    контроль над клампом к экрану и инерцией.
]]

local Compat = __swagga_require("Compat")
local Util = __swagga_require("Util")
local Motion = __swagga_require("Motion")
local Theme = __swagga_require("Theme")
local Icons = __swagga_require("Icons")
local Signal = __swagga_require("Signal")
local Tab = __swagga_require("Tab")

local create = Util.create
local UIS = Compat.Services.Input

local Window = {}
Window.__index = Window

-- Геометрия
local TOPBAR_HEIGHT = 52
local SIDEBAR_WIDTH = 176
local SIDEBAR_COLLAPSED = 56
local CORNER = 15

--==============================================================
-- Конструктор
--==============================================================
function Window.new(library, config)
	config = config or {}

	local self = setmetatable({}, Window)
	self.Library = library
	self.Name = config.Name or "Swagga Hub"
	self.Subtitle = config.Subtitle or ""
	self.Author = config.Author or ""
	self.Tabs = {}
	self.ActiveTab = nil
	self.SidebarCollapsed = config.SidebarCollapsed or false
	self.Minimized = false
	self.Destroyed = false
	self.Janitor = Util.janitor()

	self.TabChanged = Signal.new("Window.TabChanged")
	self.Closed = Signal.new("Window.Closed")
	self.VisibilityChanged = Signal.new("Window.VisibilityChanged")

	local size = config.Size or UDim2.fromOffset(780, 620)
	self.MinSize = config.MinSize or Vector2.new(560, 400)

	--==========================================================
	-- ScreenGui
	--==========================================================
	local gui = create("ScreenGui", {
		Name = config.GuiName or ("\0" .. tostring(math.random(1e6, 9e6))),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = config.DisplayOrder or 999,
	})

	-- Защита от детекта (если экзекутор умеет)
	Compat.Protect(gui)
	local parent = Compat.GetGuiParent()
	if parent then
		gui.Parent = parent
	else
		warn("[Swagga] Не найден родитель для ScreenGui")
	end
	self.ScreenGui = gui
	self.Janitor:Add(gui)

	--==========================================================
	-- Корневой фрейм
	--==========================================================
	local root = create("Frame", {
		Name = "Root",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = config.Position or UDim2.fromScale(0.5, 0.5),
		Size = size,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		Parent = gui,
	}, {
		Util.corner(CORNER),
	})
	Theme.bind(root, "BackgroundColor3", "Background")
	self.Root = root

	-- Внешняя тень окна (нативная на новых клиентах)
	self.Shadow = Util.shadow(root, {
		Blur = 40,
		Transparency = 0.35,
		OffsetY = 10,
		Spread = 2,
	})

	-- Тонкая обводка для отделения от фона
	local rootStroke = Util.stroke(Theme.get("Stroke"), 1, 0.35)
	if rootStroke then
		rootStroke.Parent = root
		Theme.bind(rootStroke, "Color", "Stroke")
	end

	-- Появление окна
	local rootScale = create("UIScale", { Scale = 0.92, Parent = root })
	root.BackgroundTransparency = 1
	Motion.tween(rootScale, { Scale = 1 }, {
		Duration = Motion.Duration.Slower,
		Easing = Motion.Easing.Overshoot,
	})
	Motion.tween(root, { BackgroundTransparency = 0 }, {
		Duration = Motion.Duration.Normal,
	})

	self:_buildTopbar(config)
	self:_buildSidebar(config)
	self:_buildContent()
	self:_buildMorePanel(config)
	self:_buildResizer()
	self:_setupDragging()
	self:_setupEscape()

	return self
end

--==============================================================
